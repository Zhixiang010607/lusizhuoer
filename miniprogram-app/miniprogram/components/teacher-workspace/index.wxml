<view class="teacher-home">
  <view class="web-panel teacher-home-profile"><view><text>老师姓名</text><text>{{teacherName}}</text></view><view><text>联系电话</text><text>{{teacherPhone}}</text></view><view wx:if="{{assignedLeaderName}}" class="teacher-leader-line"><text>所属组长</text><text>{{assignedLeaderName}}</text></view></view>
  <view wx:if="{{balances.length}}" class="web-panel">
    <view class="panel-heading"><text class="panel-title">体验项目剩余次数</text></view>
    <view class="quota-overview"><view class="quota-line quota-head"><text>项目</text><text>当前可用</text><text>每月基础</text><text>本月已用</text></view><view wx:for="{{balances}}" wx:key="productId" class="quota-line"><text>{{item.productName}}</text><text>{{item.availableCount}} 次</text><text>{{item.monthlyAllowance}} 次</text><text>{{item.usedCount}} 次</text></view></view>
  </view>
  <view class="web-panel overview-panel">
    <view class="panel-heading"><text class="panel-title">业务汇总</text><text class="web-badge">{{rangeLabel}}</text></view>
    <view class="range-presets"><button wx:for="{{rangeOptions}}" wx:key="value" class="range-button {{rangePreset === item.value ? 'active' : ''}}" data-preset="{{item.value}}" bindtap="chooseRange">{{item.label}}</button><picker class="range-more" range="{{moreOptions}}" range-key="label" value="{{moreIndex}}" bindchange="chooseMoreRange"><view class="range-button {{rangePreset !== 'TODAY' && rangePreset !== 'WEEK' && rangePreset !== 'MONTH' ? 'active' : ''}}"><text>{{moreLabel}}</text><text class="range-chevron">⌄</text></view></picker></view>
    <view wx:if="{{customVisible}}" class="custom-range"><label class="range-field"><text>开始日期</text><picker mode="date" value="{{startDate}}" data-field="startDate" bindchange="changeDate"><view class="date-picker">{{startDate || '请选择'}}</view></picker></label><label class="range-field"><text>结束日期</text><picker mode="date" value="{{endDate}}" data-field="endDate" bindchange="changeDate"><view class="date-picker">{{endDate || '请选择'}}</view></picker></label><button class="range-apply" bindtap="applyRange">应用时间</button></view>
    <project-summary rows="{{summaryRows}}" totals="{{totals}}" totals-ready="{{summaryRows.length > 0}}" loading="{{loading}}" error="{{error}}" bindretry="retry" />
  </view>
  <view class="web-panel business-panel">
    <view class="panel-heading"><text class="panel-title">本人业务明细</text><text class="web-badge">共 {{page.total}} 条</text></view>
    <view class="record-tabs"><button wx:for="{{businessTabs}}" wx:key="type" class="record-tab {{item.active ? 'active' : ''}}" data-type="{{item.type}}" bindtap="selectType"><text>{{item.label}}</text><text class="record-count">{{item.total}} 次</text></button></view>
    <scroll-view wx:if="{{rows.length}}" class="table-scroll record-scroll" data-visible-rows="{{visibleRows}}" scroll-x enhanced show-scrollbar="{{false}}" style="height: {{tableHeight ? tableHeight + 'px' : viewportHeight + 'rpx'}}"><view class="record-table"><view class="table-row table-head"><view class="list-row-number">序号</view><view>单号</view><view>门店</view><view>客户</view><view>项目</view><view>次数</view><view>提交时间</view></view><view wx:for="{{rows}}" wx:key="id" class="table-row"><view class="list-row-number">{{index + 1}}</view><view class="{{viewerMode === 'TEAM' ? '' : 'table-link'}}" data-id="{{item.id}}" bindtap="openOrder">{{item.recordCode}}</view><view>{{item.storeName}}</view><view class="{{viewerMode === 'TEAM' ? '' : 'table-link'}}" data-code="{{item.customerCode}}" bindtap="openCustomer">{{item.customerName}}</view><view>{{item.productName}}</view><view>{{item.unitCount}} 次</view><view>{{item.submittedAt}}</view></view></view></scroll-view>
    <view wx:else class="table-notice">{{loading ? '正在读取业务明细…' : error ? '资料暂未读取，请重试' : '当前分类暂无有效记录'}}</view>
    <view wx:if="{{page.total > 0}}" class="table-pagination customer-pagination"><view class="customer-page-controls"><button disabled="{{loading || page.previousDisabled}}" bindtap="previousPage">上一页</button><text>第 {{page.page}} / {{page.totalPages}} 页</text><button disabled="{{loading || page.nextDisabled}}" bindtap="nextPage">下一页</button></view><view class="customer-page-jump"><text>跳至第</text><input type="number" value="{{pageInput}}" bindinput="inputPage" bindconfirm="jumpPage" confirm-type="done" aria-label="老师业务明细跳转页码" /><text>页</text><button disabled="{{loading}}" bindtap="jumpPage">跳转</button></view></view>
  </view>
  <view wx:if="{{error}}" class="form-message error">{{error}}</view>
</view>
