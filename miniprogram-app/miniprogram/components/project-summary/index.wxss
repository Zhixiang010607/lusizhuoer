:host { display: block; min-width: 0; }
view, text, button { box-sizing: border-box; }
.summary-frame { width: 100%; overflow: hidden; border: 1rpx solid #dfcfb4; border-radius: 20rpx; background: #fffaf3; }
.summary-scroll { width: 100%; }
.summary-table { width: auto; min-width: 100%; display: table; table-layout: auto; border-collapse: collapse; color: #554a3c; font-variant-numeric: tabular-nums; }
.summary-row { display: table-row; }
.summary-row > view { display: table-cell; height: 72rpx; padding: 12rpx 16rpx; border-bottom: 1rpx solid #eadfce; vertical-align: middle; text-align: center; white-space: nowrap; font-size: 24rpx; line-height: 1.45; }
.summary-head > view { height: 64rpx; color: #675b4b; background: #f5ead8; font-weight: 700; }
.summary-row > .summary-name { text-align: left; background: #fff7eb; }
.summary-name text { display: block; width: 220rpx; white-space: normal; overflow-wrap: anywhere; word-break: break-all; color: #302a22; font-weight: 600; }
.summary-unit { margin-left: 3rpx; color: #7c7062; font-size: inherit; }
.summary-total > view { color: #74592d; background: #f4e7d0; font-weight: 700; }
.summary-row:last-child > view { border-bottom: 0; }
.summary-notice { padding: 24rpx; color: #7c7062; font-size: 24rpx; line-height: 1.6; text-align: left; white-space: normal; overflow-wrap: anywhere; word-break: break-word; }
.summary-notice > text { display: block; }
.notice-title { color: #554a3c; font-weight: 600; }
.notice-detail { margin-top: 8rpx; }
.summary-retry { width: auto !important; display: inline-flex; align-items: center; justify-content: center; min-height: 72rpx; margin: 18rpx 0 0; padding: 0 24rpx; border: 1rpx solid #d8bc8c; border-radius: 12rpx; color: #74592d; background: #f4e7d0; font-size: 24rpx; line-height: 1.3; }
.summary-retry::after { border: 0; }
.totals-notice { border-top: 1rpx solid #eadfce; }
@media (min-width: 700px) {
  .summary-frame { border-width: 1px; border-radius: 16px; }
  .summary-row > view { height: 52px; padding: 10px 12px; font-size: 14px; }
  .summary-head > view { height: 46px; }
  .summary-name text { width: 240px; }
  .summary-unit { margin-left: 2px; }
  .summary-notice { padding: 18px; font-size: 14px; }
  .notice-detail { margin-top: 6px; }
  .summary-retry { min-height: 42px; margin-top: 12px; padding: 0 16px; border-radius: 10px; font-size: 14px; }
}
