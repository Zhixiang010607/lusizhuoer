.pager{padding-top:22rpx;display:grid;gap:16rpx;color:#7c7062;font-size:24rpx}.page-controls,.page-jump{display:flex;align-items:center;justify-content:center;gap:16rpx;min-width:0}.page-controls{justify-content:space-between}.page-controls .pager-label{white-space:nowrap;font-size:24rpx}.pager-button{box-sizing:border-box;width:auto!important;margin:0;min-width:0;height:64rpx;padding:0 18rpx;display:flex;align-items:center;justify-content:center;font-size:24rpx;line-height:1;background:#fffaf3;border:1rpx solid #d8c5a3;border-radius:10rpx;color:#74592d;white-space:nowrap}.pager-button::after{border:0}.pager-button.is-disabled{color:#aa9c87;background:#eee7da}.page-jump .pager-input{width:84rpx;height:62rpx;box-sizing:border-box;text-align:center;background:#fff;border:1rpx solid #dfcfb4;border-radius:10rpx}.page-jump .pager-button{background:#74592d;color:white}@media(min-width:700px){.pager{padding-top:16px;gap:10px;font-size:14px}.page-controls{justify-content:center;gap:22px}.page-controls .pager-label{font-size:14px}.page-jump{gap:10px}.pager-button{height:38px;padding:0 14px;font-size:14px;border-width:1px;border-radius:8px}.page-jump .pager-input{width:58px;height:38px;border-width:1px;border-radius:8px}}
