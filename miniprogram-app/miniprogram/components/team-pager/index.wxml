<view wx:if="{{total > 0}}" class="pager"><view class="page-controls"><button class="pager-button {{disabled || page <= 1 ? 'is-disabled' : ''}}" disabled="{{disabled || page <= 1}}" data-delta="-1" bindtap="move">上一页</button><text class="pager-label">第 {{page}} / {{totalPages}} 页 · 共 {{total}} 条</text><button class="pager-button {{disabled || page >= totalPages ? 'is-disabled' : ''}}" disabled="{{disabled || page >= totalPages}}" data-delta="1" bindtap="move">下一页</button></view><view wx:if="{{totalPages > 1}}" class="page-jump"><text class="pager-label">跳至第</text><input class="pager-input" type="number" value="{{input}}" bindinput="input" bindconfirm="jump" disabled="{{disabled}}" aria-label="跳转页码"/><text class="pager-label">页</text><button class="pager-button {{disabled ? 'is-disabled' : ''}}" bindtap="jump" disabled="{{disabled}}">跳转</button></view></view>
