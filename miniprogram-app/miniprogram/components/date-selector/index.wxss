.date-selector {
  width: 100%;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  align-items: stretch;
  gap: 12rpx;
}
.date-part { min-width: 0; }
.date-button {
  width: 100%;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  color: #5f4a2f;
  background: #f5ead8;
  border: 1rpx solid #d8c5a3;
  border-radius: 13rpx;
  font-size: 25rpx;
  font-weight: 700;
  line-height: 1;
  text-align: center;
}
.date-part.is-disabled .date-button { opacity: .55; }
@media (min-width: 700px) {
  .date-selector { gap: 10px; }
  .date-button { height: 46px; border-width: 1px; border-radius: 10px; font-size: 15px; }
}
