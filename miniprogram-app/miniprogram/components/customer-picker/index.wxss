.picker-card { padding: 22rpx; background: #fff8ec; border: 1rpx solid #dfcfb4; border-radius: 20rpx; }
.tabs { display: flex; gap: 8rpx; margin-bottom: 18rpx; padding: 7rpx; background: #eee4d6; border-radius: 16rpx; }
.tabs button { flex: 1; min-height: 68rpx; display: flex; align-items: center; justify-content: center; margin: 0; color: #796d5e; background: transparent; border-radius: 12rpx; font-size: 24rpx; line-height: 1; }
.tabs button::after, .search::after, .confirm::after { border: 0; }
.tabs button.active { color: #74592d; background: #fffaf3; font-weight: 800; }
.field-value { display: flex; align-items: center; width: 100%; min-height: 84rpx; padding: 0 20rpx; color: #302a22; background: #fff; border: 1rpx solid #d8c5a3; border-radius: 14rpx; }
.customer-list-heading { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin: 0 4rpx 10rpx; color: #4b4033; font-size: 23rpx; font-weight: 800; }
.customer-list-heading text:last-child { flex: none; color: #8b744e; font-size: 20rpx; font-weight: 650; }
.customer-list { height: 430rpx; overflow: hidden; background: #fffdf8; border: 1rpx solid #d8c5a3; border-radius: 16rpx; }
.customer-option { width: calc(100% - 20rpx); min-height: 82rpx; display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin: 10rpx; padding: 12rpx 16rpx; color: #302a22; background: #fff; border: 1rpx solid #e5d8c2; border-radius: 13rpx; font-size: 22rpx; line-height: 1.25; text-align: left; }
.customer-option::after { border: 0; }
.customer-option.selected { color: #5c431d; background: #f4e5c8; border-color: #b98d43; box-shadow: inset 0 0 0 1rpx rgba(185, 141, 67, .16); }
.customer-option-main { min-width: 0; display: flex; align-items: center; gap: 14rpx; overflow: hidden; }
.customer-option-name { min-width: 0; overflow: hidden; color: inherit; font-size: 25rpx; font-weight: 800; text-overflow: ellipsis; white-space: nowrap; }
.customer-option-birthday { flex: none; color: #74695b; font-size: 21rpx; white-space: nowrap; }
.customer-option-code { max-width: 42%; flex: none; overflow: hidden; color: #8b744e; font-size: 19rpx; text-overflow: ellipsis; white-space: nowrap; }
.customer-list-footer { min-height: 66rpx; display: flex; align-items: center; justify-content: center; padding: 8rpx 16rpx 16rpx; color: #776b5d; font-size: 21rpx; text-align: center; }
.customer-list-footer.complete { color: #8b744e; }
.manual-fields { display: grid; gap: 12rpx; }
.search { min-height: 78rpx; color: #fffdf8; background: #6f532e; border-radius: 14rpx; font-size: 25rpx; font-weight: 750; }
.duplicate-list { display: grid; gap: 10rpx; margin-top: 16rpx; }
.duplicate-title { color: #675b4b; font-size: 22rpx; font-weight: 800; }
.duplicate-option { width: 100%; min-height: 76rpx; display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin: 0; padding: 12rpx 18rpx; color: #302a22; background: #fff; border: 1rpx solid #d8c5a3; border-radius: 14rpx; font-size: 22rpx; line-height: 1.3; text-align: left; }
.duplicate-option::after { border: 0; }
.duplicate-option text:last-child { flex: none; color: #74592d; font-weight: 800; }
.candidate { display: flex; gap: 18rpx; margin-top: 18rpx; padding: 18rpx; background: #fff; border: 1rpx solid #dfcfb4; border-radius: 16rpx; }
.customer-photo { width: 128rpx; height: 156rpx; flex: none; background: #eee4d6; border-radius: 14rpx; }
.photo-placeholder { display: flex; align-items: center; justify-content: center; color: #8a7d6d; font-size: 20rpx; text-align: center; }
.candidate-info { display: flex; min-width: 0; flex-direction: column; justify-content: center; gap: 8rpx; color: #7c7062; font-size: 22rpx; }
.candidate-name { color: #302a22; font-size: 30rpx; font-weight: 800; }
.confirm { min-height: 82rpx; margin-top: 14rpx; color: #fffdf8; background: #6f532e; border-radius: 14rpx; font-size: 26rpx; font-weight: 800; }
.confirm[disabled] { color: #9b9082; background: #e7ddce; }
.picker-message { display: block; margin-top: 13rpx; color: #675b4b; font-size: 22rpx; line-height: 1.45; }
.picker-message.error { color: #a1322d; }
.retry { margin-top: 12rpx; color: #74592d; background: #f4e7d0; border-radius: 14rpx; font-size: 24rpx; }
