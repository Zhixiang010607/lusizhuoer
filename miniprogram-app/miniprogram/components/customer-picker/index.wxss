.picker-card { padding: 22rpx; background: #f8fbff; border: 1rpx solid #d8e4f0; border-radius: 20rpx; }
.tabs { display: flex; gap: 8rpx; margin-bottom: 18rpx; padding: 7rpx; background: #e9f0f7; border-radius: 16rpx; }
.tabs button { flex: 1; min-height: 68rpx; margin: 0; color: #587087; background: transparent; border-radius: 12rpx; font-size: 24rpx; }
.tabs button::after, .search::after, .confirm::after { border: 0; }
.tabs button.active { color: #174f98; background: #fff; font-weight: 800; }
.field-value { display: flex; align-items: center; width: 100%; min-height: 84rpx; padding: 0 20rpx; color: #132b46; background: #fff; border: 1rpx solid #ccd9e7; border-radius: 14rpx; }
.manual-fields { display: grid; gap: 12rpx; }
.search { min-height: 78rpx; color: #fffdf8; background: #6f532e; border-radius: 14rpx; font-size: 25rpx; font-weight: 750; }
.candidate { display: flex; gap: 18rpx; margin-top: 18rpx; padding: 18rpx; background: #fff; border: 1rpx solid #dbe5ef; border-radius: 16rpx; }
.customer-photo { width: 128rpx; height: 156rpx; flex: none; background: #e7edf4; border-radius: 14rpx; }
.candidate-info { display: flex; min-width: 0; flex-direction: column; justify-content: center; gap: 8rpx; color: #60758c; font-size: 22rpx; }
.candidate-name { color: #10233d; font-size: 30rpx; font-weight: 800; }
.confirm { min-height: 82rpx; margin-top: 14rpx; color: #fffdf8; background: #6f532e; border-radius: 14rpx; font-size: 26rpx; font-weight: 800; }
.confirm[disabled] { color: #70849a; background: #dfe7ef; }
.picker-message { display: block; margin-top: 13rpx; color: #4c6680; font-size: 22rpx; line-height: 1.45; }
.picker-message.error { color: #a1322d; }
.retry { margin-top: 12rpx; color: #174e94; background: #eaf2ff; border-radius: 14rpx; font-size: 24rpx; }
