.picker-card { padding: 22rpx; background: #fff8ec; border: 1rpx solid #dfcfb4; border-radius: 20rpx; }
.tabs { display: flex; gap: 8rpx; margin-bottom: 18rpx; padding: 7rpx; background: #eee4d6; border-radius: 16rpx; }
.tabs button { flex: 1; min-height: 68rpx; display: flex; align-items: center; justify-content: center; margin: 0; color: #796d5e; background: transparent; border-radius: 12rpx; font-size: 24rpx; line-height: 1; }
.tabs button::after, .search::after, .confirm::after, .clear-date::after { border: 0; }
.tabs button.active { color: #74592d; background: #fffaf3; font-weight: 800; }
.field-value { display: flex; align-items: center; width: 100%; min-height: 84rpx; padding: 0 20rpx; color: #302a22; background: #fff; border: 1rpx solid #d8c5a3; border-radius: 14rpx; }
.customer-select-heading { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin: 0 4rpx 10rpx; color: #4b4033; font-size: 23rpx; font-weight: 800; }
.customer-select-heading text:last-child { flex: none; color: #8b744e; font-size: 20rpx; font-weight: 650; }
.customer-select-control { min-height: 84rpx; display: flex; align-items: center; justify-content: space-between; gap: 18rpx; padding: 0 20rpx; color: #302a22; background: #fff; border: 1rpx solid #d8c5a3; border-radius: 14rpx; box-sizing: border-box; }
.customer-select-control > text:first-child { min-width: 0; overflow: hidden; font-size: 23rpx; text-overflow: ellipsis; white-space: nowrap; }
.customer-select-control.disabled { color: #9b9082; background: #f4eee5; }
.customer-select-arrow { flex: none; color: #8b744e; font-size: 30rpx; line-height: 1; }
.customer-select-help { display: block; margin: 10rpx 4rpx 0; color: #817565; font-size: 20rpx; line-height: 1.4; }
.manual-fields { display: grid; gap: 12rpx; }
.manual-date-row { display: flex; align-items: stretch; gap: 10rpx; }
.manual-date-picker { min-width: 0; flex: 1; }
.clear-date { width: 112rpx; min-height: 84rpx; display: flex; align-items: center; justify-content: center; margin: 0; padding: 0; color: #74592d; background: #f4e7d0; border-radius: 14rpx; font-size: 22rpx; font-weight: 750; line-height: 1; }
.manual-help { color: #817565; font-size: 20rpx; line-height: 1.4; }
.search { min-height: 78rpx; display: flex; align-items: center; justify-content: center; padding: 0 28rpx; color: #fffdf8; background: #6f532e; border-radius: 14rpx; font-size: 25rpx; font-weight: 750; line-height: 1; text-align: center; box-sizing: border-box; }
.duplicate-list { display: grid; gap: 10rpx; margin-top: 16rpx; }
.duplicate-title { color: #675b4b; font-size: 22rpx; font-weight: 800; }
.duplicate-option { width: 100%; min-height: 76rpx; display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: 18rpx; margin: 0; padding: 12rpx 18rpx; color: #302a22; background: #fff; border: 1rpx solid #d8c5a3; border-radius: 14rpx; box-sizing: border-box; font-size: 22rpx; line-height: 1.3; text-align: left; }
.duplicate-option::after { border: 0; }
.duplicate-option text { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.duplicate-option text:first-child { font-weight: 850; }
.duplicate-option text:last-child { color: #74695c; }
.candidate { display: flex; gap: 18rpx; margin-top: 18rpx; padding: 18rpx; background: #fff; border: 1rpx solid #dfcfb4; border-radius: 16rpx; }
.customer-photo { width: 128rpx; height: 156rpx; flex: none; background: #eee4d6; border-radius: 14rpx; }
.photo-placeholder { display: flex; align-items: center; justify-content: center; color: #8a7d6d; font-size: 20rpx; text-align: center; }
.candidate-info { display: flex; min-width: 0; flex-direction: column; justify-content: center; gap: 8rpx; color: #7c7062; font-size: 22rpx; }
.candidate-name { color: #302a22; font-size: 30rpx; font-weight: 800; }
.confirm { height: 82rpx; min-height: 82rpx; display: flex; align-items: center; justify-content: center; margin-top: 14rpx; padding: 0 24rpx; color: #fffdf8; background: #6f532e; border-radius: 14rpx; font-size: 26rpx; font-weight: 800; line-height: 1; text-align: center; }
.confirm[disabled] { color: #9b9082; background: #e7ddce; }
.picker-message { display: block; margin-top: 13rpx; color: #675b4b; font-size: 22rpx; line-height: 1.45; }
.picker-message.error { color: #a1322d; }
.retry { margin-top: 12rpx; color: #74592d; background: #f4e7d0; border-radius: 14rpx; font-size: 24rpx; }

@media (min-width: 700px) {
  .picker-card { padding: 16px; border-width: 1px; border-radius: 16px; }
  .tabs { gap: 6px; margin-bottom: 14px; padding: 5px; border-radius: 12px; }
  .tabs button { min-height: 44px; border-radius: 9px; font-size: 15px; }
  .field-value, .customer-select-control { min-height: 48px; padding: 0 14px; border-width: 1px; border-radius: 11px; font-size: 16px; }
  .customer-select-heading { gap: 12px; margin: 0 3px 8px; font-size: 14px; }
  .customer-select-heading text:last-child { font-size: 13px; }
  .customer-select-control { gap: 12px; }
  .customer-select-control > text:first-child { font-size: 15px; }
  .customer-select-arrow { font-size: 22px; }
  .customer-select-help { margin: 8px 3px 0; font-size: 13px; }
  .manual-fields { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px 12px; }
  .manual-date-row { gap: 8px; }
  .clear-date { width: 76px; min-height: 48px; border-radius: 11px; font-size: 14px; }
  .manual-help { align-self: center; font-size: 13px; }
  .search { min-height: 48px; padding: 0 18px; border-radius: 11px; font-size: 16px; }
  .duplicate-list { gap: 8px; margin-top: 14px; }
  .duplicate-title { font-size: 14px; }
  .duplicate-option { min-height: 48px; gap: 12px; padding: 9px 13px; border-width: 1px; border-radius: 11px; font-size: 14px; }
  .candidate { gap: 14px; margin-top: 14px; padding: 14px; border-width: 1px; border-radius: 13px; }
  .customer-photo { width: 92px; height: 108px; border-radius: 11px; }
  .photo-placeholder { font-size: 13px; }
  .candidate-info { gap: 6px; font-size: 14px; }
  .candidate-name { font-size: 20px; }
  .confirm { width: min(360px, 100%); height: 48px; min-height: 48px; margin: 12px auto 0; padding: 0 18px; border-radius: 11px; font-size: 16px; }
  .picker-message { margin-top: 10px; font-size: 14px; }
  .retry { width: min(320px, 100%); margin: 10px auto 0; border-radius: 11px; font-size: 14px; }
}
