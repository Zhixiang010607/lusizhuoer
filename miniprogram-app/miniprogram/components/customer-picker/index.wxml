<view class="picker-card">
  <view class="tabs">
    <button class="{{mode === 'select' ? 'active' : ''}}" data-mode="select" bindtap="changeMode">现有客户</button>
    <button class="{{mode === 'manual' ? 'active' : ''}}" data-mode="manual" bindtap="changeMode">姓名＋生日</button>
  </view>
  <view wx:if="{{mode === 'select'}}">
    <view class="customer-list-heading">
      <text>该门店活跃客户</text>
      <text>{{customers.length}} 位已加载</text>
    </view>
    <scroll-view class="customer-list" scroll-y enable-flex lower-threshold="100" bindscrolltolower="loadMoreCustomers">
      <button wx:for="{{customers}}" wx:key="customerCode" class="customer-option {{selectedCustomerCode === item.customerCode ? 'selected' : ''}}" data-code="{{item.customerCode}}" bindtap="selectListedCustomer">
        <view class="customer-option-main">
          <text class="customer-option-name">{{item.customerName}}</text>
          <text class="customer-option-birthday">{{item.birthDate}}</text>
        </view>
        <text class="customer-option-code">{{item.customerCode}}</text>
      </button>
      <view wx:if="{{listLoading}}" class="customer-list-footer">正在读取客户…</view>
      <view wx:elif="{{listLoadingMore}}" class="customer-list-footer">正在加载更多…</view>
      <view wx:elif="{{hasMore}}" class="customer-list-footer">继续向下滑动加载更多</view>
      <view wx:elif="{{customers.length}}" class="customer-list-footer complete">已显示全部活跃客户</view>
      <view wx:else class="customer-list-footer">暂无活跃客户</view>
    </scroll-view>
    <text wx:if="{{listMessage}}" class="picker-message {{listError ? 'error' : ''}}">{{listMessage}}</text>
  </view>
  <view wx:else class="manual-fields">
    <input class="field-value" placeholder="客户姓名" value="{{manualName}}" bindinput="inputName" />
    <picker mode="date" value="{{manualBirthday}}" end="{{today}}" bindchange="inputBirthday"><view class="field-value">{{manualBirthday || '选择生日'}}</view></picker>
    <button class="search" bindtap="manualSearch" loading="{{loading}}" disabled="{{loading}}">精确查询</button>
  </view>
  <view wx:if="{{duplicateMatches.length}}" class="duplicate-list">
    <text class="duplicate-title">请选择客户编号</text>
    <button wx:for="{{duplicateMatches}}" wx:key="customerCode" class="duplicate-option" data-code="{{item.customerCode}}" bindtap="chooseDuplicate">
      <text>{{item.customerName}} · {{item.birthDate}}</text>
      <text>{{item.customerCode}}</text>
    </button>
  </view>
  <view wx:if="{{candidate}}" class="candidate">
    <image wx:if="{{photoUrl}}" class="customer-photo" src="{{photoUrl}}" mode="aspectFill" data-customer-code="{{candidate.customerCode}}" data-photo-url="{{photoUrl}}" bindload="photoLoaded" binderror="photoFailed"></image>
    <view wx:else class="customer-photo photo-placeholder">照片待读取</view>
    <view class="candidate-info">
      <text class="candidate-name">{{candidate.customerName}}</text>
      <text>{{candidate.birthDate}}</text>
      <text>{{candidate.customerCode}}</text>
    </view>
  </view>
  <button wx:if="{{candidate}}" class="confirm" bindtap="confirm" disabled="{{!photoReady}}">{{photoReady ? '确认这位客户' : (photoLoading ? '正在读取客户照片…' : '客户照片尚未就绪')}}</button>
  <button wx:if="{{candidate && error}}" class="retry" bindtap="retryPhoto" loading="{{photoLoading}}" disabled="{{loading || photoLoading}}">单独重读这张照片</button>
  <text wx:if="{{message}}" class="picker-message {{error ? 'error' : ''}}">{{message}}</text>
</view>
