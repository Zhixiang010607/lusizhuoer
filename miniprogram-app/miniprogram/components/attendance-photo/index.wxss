:host { display: block; min-width: 0; width: 100%; height: 100%; box-sizing: border-box; }
.attendance-photo { width: 100%; min-width: 0; box-sizing: border-box; margin: 12rpx 0; }
.photo { display: block; width: 100%; height: 320rpx; background: #f4ead7; border-radius: 12rpx; }
.note { display: block; color: #786b5b; font-size: 24rpx; }
.photo-button { box-sizing: border-box; width: 100% !important; min-width: 0; min-height: 72rpx; margin: 12rpx 0 0; padding: 12rpx; display: flex; align-items: center; justify-content: center; color: #795c2e; background: #fffaf3; font-size: 24rpx; line-height: 1.3; }
@media (min-width: 600px) { .attendance-photo { margin: 8px 0; } .photo { height: 200px; border-radius: 8px; } .note { font-size: 14px; } .photo-button { min-height: 42px; margin-top: 8px; padding: 8px; font-size: 14px; } }
@media (min-width: 700px) {
  .attendance-photo.fill { display: flex; flex-direction: column; height: 100%; min-height: 0; margin: 0; }
  .fill .photo { flex: 1 1 0; height: 0; min-height: 220px; background: #f6f1e8; }
  .fill .photo-button { flex: none; height: 44px; min-height: 44px; margin-top: 12px; padding: 0 12px; border: 1px solid #d8c5a3; border-radius: 10px; background: #fff; }
}
