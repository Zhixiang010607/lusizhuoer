.month-selector { width: 100%; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14rpx; box-sizing: border-box; }
.month-part { min-width: 0; }
.month-button { position: relative; width: 100%; height: 80rpx; padding: 0 44rpx; display: flex; align-items: center; justify-content: center; box-sizing: border-box; color: #5f4a2f; background: #fff; border: 1rpx solid #d8c5a3; border-radius: 13rpx; font-size: 28rpx; font-weight: 750; line-height: 1; white-space: nowrap; }
.chevron { position: absolute; right: 20rpx; color: #80602c; font-size: 26rpx; }
.disabled { opacity: .55; }
@media (min-width: 700px) { .month-selector { gap: 12px; } .month-button { height: 48px; padding: 0 36px; border-width: 1px; border-radius: 10px; font-size: 17px; } .chevron { right: 16px; font-size: 18px; } }
