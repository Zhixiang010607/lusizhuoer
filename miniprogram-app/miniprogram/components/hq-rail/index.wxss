.rail { position: sticky; top: 0; z-index: 120; display: grid; grid-template-columns: repeat(5, 1fr); height: 82rpx; margin: -16rpx -14rpx 18rpx; padding: 0 18rpx; color: #fffdf8; background: #2f2921; border-bottom: 1rpx solid rgba(255,255,255,.24); }
.rail-link { min-width: 0; display: flex; align-items: center; justify-content: center; font-size: 25rpx; font-weight: 800; line-height: 1; }
.rail-link.active { color: #2f2921; background: #f6eee1; border-radius: 999rpx; margin: 12rpx 7rpx; }
.rail-backdrop { position: fixed; inset: 0; z-index: 110; background: transparent; }
.rail-popover { position: fixed; z-index: 130; top: calc(82rpx + env(safe-area-inset-top)); left: 16rpx; right: 16rpx; overflow: hidden; color: #302a22; background: #fffaf3; border: 1rpx solid #d9c6a5; border-radius: 0 0 22rpx 22rpx; box-shadow: 0 18rpx 42rpx rgba(48,42,34,.18); }
.rail-popover view { display: flex; align-items: center; min-height: 78rpx; padding: 0 28rpx; border-top: 1rpx solid #eadfce; font-size: 24rpx; font-weight: 750; }
.rail-popover view:first-child { border-top: 0; }
