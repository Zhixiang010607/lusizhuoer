<view wx:if="{{error}}" class="message">{{error}}</view><view class="team-layout"><view class="card"><view class="heading"><text>管理名单</text><text class="badge">{{members.total}} 位老师</text></view><view wx:for="{{members.records}}" wx:key="teacherId" class="person"><text class="number">{{index + 1}}</text><view class="person-copy"><text class="person-name">{{item.teacherName}}</text><text class="person-phone">{{item.phone}}</text></view><button class="team-action {{loading || mutating ? 'is-disabled' : ''}}" data-id="{{item.teacherId}}" data-add="false" bindtap="mutate" disabled="{{loading || mutating}}">移除</button></view><text wx:if="{{!members.total}}" class="empty">{{loading ? '正在读取…' : '尚未分配老师'}}</text><team-pager page="{{members.page}}" total-pages="{{members.totalPages}}" total="{{members.total}}" disabled="{{loading || mutating}}" bindchange="memberPage"/></view><view class="card"><view class="heading"><text>添加老师</text></view><view class="search"><input class="team-input" value="{{keyword}}" bindinput="keyword" bindconfirm="search" placeholder="输入老师姓名" maxlength="80" disabled="{{loading || mutating}}"/><button class="team-action {{loading || mutating ? 'is-disabled' : ''}}" bindtap="search" disabled="{{loading || mutating}}">搜索</button></view><text class="hint">每位普通老师仅能加入一个小组。</text><block wx:if="{{searched}}"><view wx:for="{{candidates.records}}" wx:key="teacherId" class="person"><text class="number">{{index + 1}}</text><view class="person-copy"><text class="person-name">{{item.teacherName}}</text><text class="person-phone">{{item.phone}}</text><text class="person-state" wx:if="{{!item.canAdd}}">{{item.assignmentLabel}}</text></view><button class="team-action {{loading || mutating || !item.canAdd ? 'is-disabled' : ''}}" data-id="{{item.teacherId}}" data-add="true" bindtap="mutate" disabled="{{loading || mutating || !item.canAdd}}">{{item.canAdd ? '添加' : '已分配'}}</button></view><text wx:if="{{!candidates.total}}" class="empty">{{loading ? '正在搜索…' : '没有匹配的普通老师'}}</text><team-pager page="{{candidates.page}}" total-pages="{{candidates.totalPages}}" total="{{candidates.total}}" disabled="{{loading || mutating}}" bindchange="candidatePage"/></block></view></view>
