<view wx:if="{{error}}" class="message">{{error}}</view><view class="team-layout"><view class="card"><view class="heading"><text>管理名单</text><text class="badge">{{members.total}} 位老师</text></view><view wx:for="{{members.records}}" wx:key="teacherId" class="person"><text class="number">{{index + 1}}</text><view class="person-copy"><text class="person-name">{{item.teacherName}}</text><text class="person-phone">{{item.phone}}</text></view><button class="team-action {{loading || mutating ? 'is-disabled' : ''}}" data-id="{{item.teacherId}}" data-add="false" bindtap="mutate" disabled="{{loading || mutating}}">移除</button></view><text wx:if="{{!members.total}}" class="empty">{{loading ? '正在读取…' : '尚未分配老师'}}</text><view wx:if="{{members.total > 0}}" class="team-pager"><view class="page-controls"><button class="pager-button {{loading || mutating || members.page <= 1 ? 'is-disabled' : ''}}" disabled="{{loading || mutating || members.page <= 1}}" data-kind="members" data-delta="-1" bindtap="movePage">上一页</button><text class="pager-label">第 {{members.page}} / {{members.totalPages}} 页 · 共 {{members.total}} 条</text><button class="pager-button {{loading || mutating || members.page >= members.totalPages ? 'is-disabled' : ''}}" disabled="{{loading || mutating || members.page >= members.totalPages}}" data-kind="members" data-delta="1" bindtap="movePage">下一页</button></view><view wx:if="{{members.totalPages > 1}}" class="page-jump"><text class="pager-label">跳至第</text><input class="pager-input" type="number" value="{{membersInput}}" data-kind="members" bindinput="changePageInput" disabled="{{loading || mutating}}" aria-label="跳转页码"/><text class="pager-label">页</text><button class="pager-button {{loading || mutating ? 'is-disabled' : ''}}" data-kind="members" bindtap="jumpPage" disabled="{{loading || mutating}}">跳转</button></view></view></view><view class="card add-card"><view class="heading"><text>添加老师</text></view><view class="search"><input class="team-input" value="{{keyword}}" bindinput="keyword" bindconfirm="search" placeholder="输入老师姓名" maxlength="80" disabled="{{loading || mutating}}"/><button class="team-action {{loading || mutating ? 'is-disabled' : ''}}" bindtap="search" disabled="{{loading || mutating}}">搜索</button></view><text class="hint">每位普通老师仅能加入一个小组。</text><block wx:if="{{searched}}"><view wx:for="{{candidates.records}}" wx:key="teacherId" class="person"><text class="number">{{index + 1}}</text><view class="person-copy"><text class="person-name">{{item.teacherName}}</text><text class="person-phone">{{item.phone}}</text><text class="person-state" wx:if="{{!item.canAdd}}">{{item.assignmentLabel}}</text></view><button class="team-action {{loading || mutating || !item.canAdd ? 'is-disabled' : ''}}" data-id="{{item.teacherId}}" data-add="true" bindtap="mutate" disabled="{{loading || mutating || !item.canAdd}}">{{item.canAdd ? '添加' : '已分配'}}</button></view><text wx:if="{{!candidates.total}}" class="empty">{{loading ? '正在搜索…' : '没有匹配的普通老师'}}</text><view wx:if="{{candidates.total > 0}}" class="team-pager"><view class="page-controls"><button class="pager-button {{loading || mutating || candidates.page <= 1 ? 'is-disabled' : ''}}" disabled="{{loading || mutating || candidates.page <= 1}}" data-kind="candidates" data-delta="-1" bindtap="movePage">上一页</button><text class="pager-label">第 {{candidates.page}} / {{candidates.totalPages}} 页 · 共 {{candidates.total}} 条</text><button class="pager-button {{loading || mutating || candidates.page >= candidates.totalPages ? 'is-disabled' : ''}}" disabled="{{loading || mutating || candidates.page >= candidates.totalPages}}" data-kind="candidates" data-delta="1" bindtap="movePage">下一页</button></view><view wx:if="{{candidates.totalPages > 1}}" class="page-jump"><text class="pager-label">跳至第</text><input class="pager-input" type="number" value="{{candidatesInput}}" data-kind="candidates" bindinput="changePageInput" disabled="{{loading || mutating}}" aria-label="跳转页码"/><text class="pager-label">页</text><button class="pager-button {{loading || mutating ? 'is-disabled' : ''}}" data-kind="candidates" bindtap="jumpPage" disabled="{{loading || mutating}}">跳转</button></view></view></block></view></view>
