:host{display:block;min-width:0}.team-layout{display:grid;gap:24rpx;min-width:0}.card{box-sizing:border-box;min-width:0;padding:26rpx;background:#fffaf3;border:1rpx solid #dfcfb4;border-radius:24rpx}.heading{display:flex;align-items:center;justify-content:space-between;gap:12rpx;margin-bottom:20rpx;font-size:30rpx;font-weight:700}.badge{font-size:24rpx;padding:7rpx 12rpx;background:#f4e7d0;color:#74592d;border-radius:9rpx;white-space:nowrap}.person{display:grid;grid-template-columns:32rpx minmax(0,1fr) auto;align-items:center;gap:14rpx;padding:20rpx 0;border-bottom:1rpx solid #eadfce}.person-copy{min-width:0}.person-name,.person-phone,.person-state{display:block;font-size:27rpx;line-height:1.5;overflow-wrap:anywhere}.person-phone,.person-state{color:#847666;font-size:24rpx}.number{font-size:24rpx;color:#a08e75;text-align:center}.team-action{box-sizing:border-box;min-width:0;width:auto!important;height:64rpx;margin:0;padding:0 20rpx;display:flex;align-items:center;justify-content:center;color:#74592d;background:#fff;border:1rpx solid #d8c5a3;border-radius:11rpx;font-size:24rpx;line-height:1;white-space:nowrap}.team-action::after{border:0}.team-action.is-disabled{background:#eee7da;color:#a59780}.search{display:grid;grid-template-columns:minmax(0,1fr) 116rpx;align-items:center;gap:14rpx}.search .team-input{box-sizing:border-box;min-width:0;width:100%;height:76rpx;padding:0 18rpx;border:1rpx solid #dfcfb4;border-radius:12rpx;background:#fff;font-size:25rpx}.search .team-action{height:76rpx;background:#74592d;color:#fff}.hint,.empty{display:block;margin-top:16rpx;color:#8b7e6d;font-size:24rpx;line-height:1.7}.message{padding:18rpx;margin-bottom:18rpx;border-radius:12rpx;color:#a64d40;background:#fff0ee;font-size:24rpx}@media(min-width:700px){.team-layout{grid-template-columns:repeat(2,minmax(0,1fr));gap:18px;align-items:start}.card{padding:20px;border-width:1px;border-radius:18px}.heading{margin-bottom:15px;font-size:19px;gap:10px}.badge{font-size:14px;padding:5px 9px;b