:host{display:block;min-width:0}.team-layout{display:grid;gap:24rpx;min-width:0}.card{box-sizing:border-box;min-width:0;padding:26rpx;background:#fffaf3;border:1rpx solid #dfcfb4;border-radius:24rpx}.heading{display:flex;align-items:center;justify-content:space-between;gap:12rpx;margin-bottom:20rpx;font-size:30rpx;font-weight:700}.badge{font-size:24rpx;padding:7rpx 12rpx;background:#f4e7d0;color:#74592d;border-radius:9rpx;white-space:nowrap}.person{display:grid;grid-template-columns:32rpx minmax(0,1fr) auto;align-items:center;gap:14rpx;padding:20rpx 0;border-bottom:1rpx solid #eadfce}.person-copy{min-width:0}.person-name,.person-phone,.person-state{display:block;font-size:27rpx;line-height:1.5;overflow-wrap:anywhere}.person-phone,.person-state{color:#847666;font-size:24rpx}.number{font-size:24rpx;color:#a08e75;text-align:center}.team-action{box-sizing:border-box;min-width:0;width:auto!important;height:64rpx;margin:0;padding:0 20rpx;display:flex;align-items:center;justify-content:center;color:#74592d;background:#fff;border:1rpx solid #d8c5a3;border-radius:11rpx;font-size:24rpx;line-height:1;white-space:nowrap}.team-action::after{border:0}.team-action.is-disabled{background:#eee7da;color:#a59780}.search{display:grid;grid-template-columns:minmax(0,1fr) 116rpx;align-items:center;gap:14rpx}.search .team-input{box-sizing:border-box;min-width:0;width:100%;height:76rpx;padding:0 18rpx;border:1rpx solid #dfcfb4;border-radius:12rpx;background:#fff;font-size:25rpx}.search .team-action{height:76rpx;background:#74592d;color:#fff}.hint,.empty{display:block;margin-top:16rpx;color:#8b7e6d;font-size:24rpx;line-height:1.7}.message{padding:18rpx;margin-bottom:18rpx;border-radius:12rpx;color:#a64d40;background:#fff0ee;font-size:24rpx}@media(min-width:700px){.team-layout{grid-template-columns:repeat(2,minmax(0,1fr));gap:18px;align-items:start}.card{padding:20px;border-width:1px;border-radius:18px}.heading{margin-bottom:15px;font-size:19px;gap:10px}.badge{font-size:14px;padding:5px 9px;border-radius:6px}.person{grid-template-columns:23px minmax(0,1fr) auto;gap:10px;padding:15px 0;border-width:1px}.person-name,.person-phone,.person-state{font-size:15px}.person-phone,.person-state,.number{font-size:14px}.team-action{height:38px;padding:0 12px;border-width:1px;border-radius:8px;font-size:14px}.search{grid-template-columns:minmax(0,1fr) 70px;gap:10px}.search .team-input,.search .team-action{height:44px}.search .team-input{padding:0 12px;font-size:14px;border-width:1px;border-radius:9px}.hint,.empty{margin-top:12px;font-size:14px}.message{padding:12px;font-size:14px}}


.team-pager { padding-top: 22rpx; display: grid; justify-items: center; gap: 16rpx; color: #7c7062; font-size: 24rpx; }
.page-controls, .page-jump { display: grid; align-items: center; justify-content: center; width: auto; min-width: 0; gap: 12rpx; }
.page-controls { grid-template-columns: auto auto auto; }
.page-jump { grid-template-columns: auto 84rpx auto auto; }
.pager-label { white-space: nowrap; font-size: 24rpx; }
.pager-button { box-sizing: border-box; width: auto !important; margin: 0 !important; min-width: 0; height: 64rpx; padding: 0 16rpx; display: flex; align-items: center; justify-content: center; font-size: 24rpx; line-height: 1; background: #fffaf3; border: 1rpx solid #d8c5a3; border-radius: 10rpx; color: #74592d; white-space: nowrap; }
.pager-button::after { border: 0; }
.pager-button.is-disabled { color: #aa9c87; background: #eee7da; }
.page-jump .pager-input { width: 84rpx; height: 64rpx; margin: 0; box-sizing: border-box; text-align: center; background: #fff; border: 1rpx solid #dfcfb4; border-radius: 10rpx; }
.page-jump .pager-button { background: #74592d; color: white; }
@media (min-width: 700px) {
  .team-pager { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; padding-top: 16px; gap: 12px 20px; font-size: 14px; }
  .page-controls, .page-jump { flex: 0 0 auto; gap: 10px; }
  .page-jump { grid-template-columns: auto 52px auto auto; }
  .pager-label { font-size: 14px; }
  .pager-button { height: 38px; padding: 0 12px; font-size: 14px; border-width: 1px; border-radius: 8px; }
  .page-jump .pager-input { width: 52px; height: 38px; border-width: 1px; border-radius: 8px; }
}

@media(max-width:999px){.team-layout{grid-template-columns:minmax(0,1fr)}.add-card{order:-1}}
.person-phone{white-space:nowrap}
