<view class="workspace-page role-{{session.role}}">
  <scroll-view id="home-ready" class="workspace-rail" scroll-x enhanced show-scrollbar="false">
    <view class="rail-inner">
      <view class="rail-current" aria-label="{{roleTitle}}"><text class="rail-icon">{{session.role === 'hq' ? '总' : (session.role === 'store' ? '店' : '师')}}</text></view>
      <view wx:if="{{session.role !== 'hq'}}" class="rail-link {{businessMenuOpen ? 'active' : ''}}" bindtap="toggleBusinessMenu" aria-label="业务办理">办</view>
      <view wx:if="{{session.role !== 'teacher'}}" class="rail-link {{queryMenuOpen ? 'active' : ''}}" bindtap="toggleQueryMenu" aria-label="业务查询">查</view>
      <view wx:if="{{session.role === 'hq'}}" class="rail-link {{managementMenuOpen ? 'active' : ''}}" bindtap="toggleManagementMenu" aria-label="管理">管</view>
      <view wx:if="{{session.role === 'hq'}}" class="rail-link {{reviewMenuOpen ? 'active' : ''}}" bindtap="toggleReviewMenu" aria-label="审核">审</view>
      <view class="rail-link rail-logout" bindtap="logout" aria-label="退出登录">退</view>
    </view>
  </scroll-view>
  <view wx:if="{{businessMenuOpen || queryMenuOpen || managementMenuOpen || reviewMenuOpen}}" class="menu-backdrop" bindtap="closeMenus"></view>
  <view wx:if="{{businessMenuOpen && session.role !== 'hq'}}" class="business-popover" catchtap="noop">
    <view class="popover-grid">
      <view bindtap="openCustomerCreate">客户建立</view><view bindtap="openRecharge" data-mode="NEW">办卡充值</view><view bindtap="openProductPurchase">产品购买</view><view bindtap="openRecharge" data-mode="REFUND">退费申请</view><view bindtap="openVerification" data-mode="NORMAL">核销办理</view><view wx:if="{{session.role === 'teacher'}}" bindtap="openVerification" data-mode="EXPERIENCE">体验核销</view>
    </view>
  </view>
  <view wx:if="{{queryMenuOpen && session.role !== 'teacher'}}" class="business-popover query-popover" catchtap="noop">
    <view class="popover-grid">
      <view data-type="customer" bindtap="openQuery">客户查询</view>
      <view data-type="recharge" bindtap="openQuery">充值查询</view>
      <view data-type="verification" bindtap="openQuery">核销查询</view>
    </view>
  </view>
  <view wx:if="{{managementMenuOpen && session.role === 'hq'}}" class="business-popover management-popover" catchtap="noop">
    <view class="popover-grid">
      <view data-type="project" bindtap="openManagement">项目管理</view>
      <view data-type="product" bindtap="openManagement">产品管理</view>
      <view data-type="store" bindtap="openManagement">门店管理</view>
      <view data-type="teacher" bindtap="openManagement">老师管理</view>
    </view>
  </view>
  <view wx:if="{{reviewMenuOpen && session.role === 'hq'}}" class="business-popover review-popover" catchtap="noop">
    <view class="popover-grid">
      <view data-type="recharge" bindtap="openReview">充值审核</view>
      <view data-type="product-purchase" bindtap="openReview">产品购买审核</view>
    </view>
  </view>

  <view class="workspace-topbar">
    <view wx:if="{{session.role === 'hq'}}"><text class="topbar-role hq-page-title">{{roleTitle}}</text></view>
    <view wx:else><text class="topbar-eyebrow">{{session.role === 'store' ? 'STORE DASHBOARD' : 'MY WORKSPACE'}}</text><text class="topbar-title">露思卓儿</text><text class="topbar-role">{{roleTitle}}</text><text class="topbar-subtitle">{{roleSubtitle}}</text></view>
  </view>

  <view class="workspace-main">
    <view wx:if="{{message}}" class="form-message {{error ? 'error' : ''}}">{{message}}</view>

    <block wx:if="{{session.role === 'teacher'}}">
      <view class="web-panel detail-section teacher-profile-panel">
        <view class="panel-heading"><view><text class="panel-title">我的基础信息</text></view></view>
        <view class="detail-info-grid teacher-profile-row">
          <view wx:for="{{profileFacts}}" wx:key="label" class="detail-info-item"><text>{{item.label}}</text><text>{{item.value}}</text></view>
        </view>
      </view>

      <view class="web-panel teacher-quota-panel">
        <view class="panel-heading"><view><text class="panel-title">体验项目剩余次数</text><text class="panel-note">按已配置项目自动排列；项目数量变化时页面会自动调整</text></view><text class="web-badge">{{experienceBalances.length}} 个项目</text></view>
        <view wx:if="{{experienceBalances.length}}" class="teacher-quota-grid">
          <view wx:for="{{experienceBalances}}" wx:key="productId" class="teacher-quota-card">
            <text class="quota-identity">{{item.productName}} · {{item.productCode || '—'}}</text>
            <view class="quota-metric quota-available"><text>可用</text><text>{{item.availableCount}} 次</text></view>
            <view class="quota-metric"><text>每月基础</text><text>{{item.monthlyAllowance}} 次</text></view>
            <view class="quota-metric"><text>本月已用</text><text>{{item.usedCount}} 次</text></view>
          </view>
        </view>
        <view wx:else class="table-empty">暂未配置体验项目</view>
      </view>
    </block>

    <block wx:if="{{session.role === 'store'}}">
      <view class="web-panel profile-hero">
        <view class="profile-avatar">店</view><view class="profile-copy"><text class="profile-type">门店</text><view class="profile-title-row"><text>{{storeHero.name || session.storeName}}</text><text class="store-status-badge">{{storeHero.status}}</text></view><text>业务编号 {{storeHero.code || session.storeCode || '—'}}</text></view>
      </view>
      <view class="web-panel detail-section store-contact-panel">
        <view class="panel-heading"><view><text class="panel-title">联系与地址</text></view></view>
        <view class="detail-info-grid store-profile-facts">
          <view wx:for="{{profileFacts}}" wx:key="label" class="detail-info-item"><text>{{item.label}}</text><text>{{item.value}}</text></view>
        </view>
      </view>
      <view class="detail-anchor-nav"><view class="anchor-inner"><text role="button" data-target="#business-summary" bindtap="jumpToSection">业务汇总</text><text role="button" data-target="#business-records" bindtap="jumpToSection">业务明细</text><text role="button" data-target="#active-customers" bindtap="jumpToSection">活跃用户</text><text role="button" data-target="#archived-customers" bindtap="jumpToSection">封存用户</text></view></view>
    </block>

    <block wx:if="{{session.role !== 'hq'}}">
      <view id="business-summary" class="web-panel overview-panel">
        <view class="panel-heading"><view><text class="panel-title">时间范围与业务汇总</text><text class="panel-note">汇总仅统计{{session.role === 'teacher' ? '当前老师' : '本门店'}}在所选周期内已经生效的业务次数</text></view><text class="web-badge">{{rangeLabel}}</text></view>
        <view class="range-presets">
          <button wx:for="{{rangeOptions}}" wx:key="value" class="range-button {{item.active ? 'active' : ''}}" data-preset="{{item.value}}" bindtap="chooseRange">{{item.label}}</button>
        </view>
        <view wx:if="{{customRangeVisible}}" class="custom-range">
          <label><text>开始日期</text><picker mode="date" value="{{rangeStart}}" bindchange="changeRangeStart"><view class="date-picker">{{rangeStart || '请选择'}}</view></picker></label>
          <label><text>结束日期</text><picker mode="date" value="{{rangeEnd}}" bindchange="changeRangeEnd"><view class="date-picker">{{rangeEnd || '请选择'}}</view></picker></label>
          <button bindtap="applyCustomRange">应用时间</button>
        </view>
        <scroll-view class="table-scroll summary-scroll" style="height: {{summaryRows.length ? 76 + summaryRows.length * 94 : 186}}rpx;" scroll-x enhanced show-scrollbar="false" scroll-left="{{summaryScrollLeft}}" bindscroll="rememberSummaryScroll">
          <view class="summary-table">
            <view class="table-row table-head"><view class="summary-product">项目</view><view>核销</view><view>充值</view><view>体验</view><view>退费</view></view>
            <view wx:for="{{summaryRows}}" wx:key="productId" class="table-row {{item.total ? 'summary-total' : ''}}">
              <view class="summary-product"><text>{{item.productName}}</text><text wx:if="{{item.productCode}}">{{item.productCode}}</text></view>
              <view><text class="metric-number">{{item.verification}}</text><text class="metric-unit">次</text></view>
              <view><text class="metric-number">{{item.recharge}}</text><text class="metric-unit">次</text></view>
              <view><text class="metric-number">{{item.experience}}</text><text class="metric-unit">次</text></view>
              <view><text class="metric-number">{{item.refund}}</text><text class="metric-unit">次</text></view>
            </view>
            <view wx:if="{{!summaryRows.length}}" class="table-empty">{{loading ? '正在计算业务汇总…' : '所选时间内暂无有效业务'}}</view>
          </view>
        </scroll-view>
      </view>

      <view id="business-records" class="web-panel business-panel">
        <view class="panel-heading"><view><text class="panel-title">{{session.role === 'teacher' ? '本人业务明细' : '本门店业务明细'}}</text><text class="panel-note">与上方业务汇总使用同一时间范围；客户可进入关联客户主页</text></view><text class="web-badge">共 {{businessPage.total}} 条</text></view>
        <view class="record-tabs">
          <button wx:for="{{businessTabs}}" wx:key="type" class="record-tab {{item.active ? 'active' : ''}}" data-type="{{item.type}}" bindtap="selectBusinessType"><text>{{item.label}}</text><text>{{item.total}} 次</text></button>
        </view>
        <text wx:if="{{businessScrollable}}" class="record-scroll-hint">超过 5 条，可在表格内上下滑动</text>
        <scroll-view class="table-scroll record-scroll" scroll-x scroll-y="{{businessScrollable}}" enhanced show-scrollbar="{{businessScrollable}}" style="height: {{businessViewportHeight}}rpx" scroll-left="{{businessScrollLeft}}" bindscroll="rememberBusinessScroll">
          <view class="record-table">
            <view class="table-row table-head"><view>单号</view><view>门店</view><view>客户</view><view>项目</view><view>次数</view><view>提交时间</view></view>
            <view wx:for="{{businessRecords}}" wx:key="id" class="table-row"><view class="table-link" data-id="{{item.id}}" data-code="{{item.recordCode}}" data-category="{{item.category}}" bindtap="openOrder">{{item.recordCode}}</view><view>{{item.storeName}}</view><view class="table-link" data-code="{{item.customerCode}}" bindtap="openCustomer">{{item.customerName}}</view><view>{{item.productName}}</view><view>{{item.unitCount}} 次</view><view>{{item.submittedAt}}</view></view>
            <view wx:if="{{!businessRecords.length}}" class="table-empty">{{businessLoading || loading ? '正在读取业务明细…' : '当前分类暂无有效记录'}}</view>
          </view>
        </scroll-view>
        <view class="table-pagination business-pagination"><button disabled="{{businessPage.previousDisabled || businessLoading}}" bindtap="previousBusinessPage">上一页</button><text>第 {{businessPage.page}} / {{businessPage.totalPages}} 页</text><button disabled="{{businessPage.nextDisabled || businessLoading}}" bindtap="nextBusinessPage">下一页</button><view class="business-page-jump"><text>跳至第</text><input type="number" value="{{businessPageInput}}" bindinput="inputBusinessPage" /><text>页</text><button disabled="{{businessLoading}}" bindtap="jumpBusinessPage">跳转</button></view></view>
      </view>

      <view id="active-customers" class="web-panel customer-panel">
        <view class="panel-heading"><view><text class="panel-title">活跃用户</text><text class="panel-note">点击姓名可进入客户主页</text></view><text class="web-badge">{{activeCustomers.total}} 位用户</text></view>
        <scroll-view class="table-scroll customer-scroll" scroll-x scroll-y enhanced show-scrollbar="false" style="height: {{activeCustomers.viewportHeight}}rpx" scroll-left="{{activeCustomerScrollLeft}}" data-status="ACTIVE" bindscroll="rememberCustomerScroll">
          <view class="customer-table">
            <view class="table-row table-head"><view>姓名</view><view>门店</view><view>生日</view><view>充值次数</view><view>核销次数</view></view>
            <view wx:for="{{activeCustomers.rows}}" wx:key="customerCode" class="table-row"><view class="table-link" data-code="{{item.customerCode}}" bindtap="openCustomer">{{item.customerName}}</view><view>{{item.storeName}}</view><view>{{item.birthDate}}</view><view>{{item.rechargeCount}} 次</view><view class="metric-number">{{item.verificationCount}} 次</view></view>
            <view wx:if="{{!activeCustomers.rows.length}}" class="table-empty">暂无活跃客户</view>
          </view>
        </scroll-view>
        <view class="table-pagination"><button disabled="{{activeCustomers.previousDisabled}}" data-status="ACTIVE" data-direction="-1" bindtap="customerPage">上一页</button><text>第 {{activeCustomers.page}} / {{activeCustomers.totalPages}} 页</text><button disabled="{{activeCustomers.nextDisabled}}" data-status="ACTIVE" data-direction="1" bindtap="customerPage">下一页</button></view>
      </view>

      <view id="archived-customers" class="web-panel customer-panel archived-section">
        <view class="panel-heading"><view><text class="panel-title">封存用户</text><text class="panel-note">封存客户仍保留历史关联；点击姓名可进入客户主页</text></view><text class="web-badge archived-badge">{{archivedCustomers.total}} 位用户</text></view>
        <scroll-view class="table-scroll customer-scroll" scroll-x scroll-y enhanced show-scrollbar="false" style="height: {{archivedCustomers.viewportHeight}}rpx" scroll-left="{{archivedCustomerScrollLeft}}" data-status="ARCHIVED" bindscroll="rememberCustomerScroll">
          <view class="customer-table">
            <view class="table-row table-head"><view>姓名</view><view>门店</view><view>生日</view><view>充值次数</view><view>核销次数</view></view>
            <view wx:for="{{archivedCustomers.rows}}" wx:key="customerCode" class="table-row"><view class="table-link" data-code="{{item.customerCode}}" bindtap="openCustomer">{{item.customerName}}</view><view>{{item.storeName}}</view><view>{{item.birthDate}}</view><view>{{item.rechargeCount}} 次</view><view class="metric-number">{{item.verificationCount}} 次</view></view>
            <view wx:if="{{!archivedCustomers.rows.length}}" class="table-empty">暂无封存客户</view>
          </view>
        </scroll-view>
        <view class="table-pagination"><button disabled="{{archivedCustomers.previousDisabled}}" data-status="ARCHIVED" data-direction="-1" bindtap="customerPage">上一页</button><text>第 {{archivedCustomers.page}} / {{archivedCustomers.totalPages}} 页</text><button disabled="{{archivedCustomers.nextDisabled}}" data-status="ARCHIVED" data-direction="1" bindtap="customerPage">下一页</button></view>
      </view>
    </block>

    <block wx:if="{{session.role === 'hq'}}">
      <view class="web-panel hq-filters">
        <view class="hq-filter-grid">
          <label><text>时间周期</text><picker range="{{hqPeriodLabels}}" value="{{hqPeriodIndex}}" bindchange="chooseHqPeriod"><view class="filter-picker">{{hqPeriodLabels[hqPeriodIndex]}}</view></picker></label>
          <view wx:if="{{hqPeriod === 'CUSTOM'}}" class="hq-custom-dates"><label><text>开始日期</text><picker mode="date" value="{{hqStart}}" bindchange="changeHqStart"><view class="filter-picker">{{hqStart}}</view></picker></label><label><text>结束日期</text><picker mode="date" value="{{hqEnd}}" bindchange="changeHqEnd"><view class="filter-picker">{{hqEnd}}</view></picker></label></view>
        </view>
        <text class="hq-control-label">排名对象</text>
        <view class="hq-dimension-tabs"><button wx:for="{{hqDimensions}}" wx:key="value" class="{{item.value === hqDimension ? 'active' : ''}}" data-index="{{index}}" bindtap="chooseHqDimension">{{item.label}}</button></view>
        <label class="hq-product-filter"><text class="hq-control-label">项目范围</text><picker range="{{hqProductLabels}}" value="{{hqProductIndex}}" bindchange="chooseHqProduct"><view class="filter-picker">{{hqProductLabels[hqProductIndex]}}</view></picker></label>
        <text class="hq-control-label">排序指标</text>
        <view class="hq-dimension-tabs hq-metric-tabs"><button wx:for="{{hqRankingMetrics}}" wx:key="value" class="{{item.value === hqRankingMetric ? 'active' : ''}}" data-index="{{index}}" bindtap="chooseHqRankingMetric">{{item.label}}</button></view>
        <view class="hq-filter-actions"><button bindtap="resetHqRange">重置筛选</button></view>
      </view>

      <view class="web-panel hq-project-summary-panel">
        <view class="panel-heading"><view><text class="panel-title">项目汇总</text><text class="hq-ranking-rule">当前时间范围内的全部项目，按项目名称排列</text></view><text class="web-badge">共 {{hqProjectSummaryPage.total}} 个项目</text></view>
        <scroll-view class="table-scroll summary-scroll" style="height: {{76 + (hqProjectSummaryRows.length + 1) * 94 + (!hqProjectSummaryRows.length ? 110 : 0)}}rpx;" scroll-x enhanced show-scrollbar="false">
          <view class="summary-table">
            <view class="table-row table-head"><view class="summary-product">项目</view><view>核销</view><view>充值</view><view>体验</view><view>退费</view></view>
            <view wx:for="{{hqProjectSummaryRows}}" wx:key="productId" class="table-row">
              <view class="summary-product"><text>{{item.productName}}</text></view>
              <view><text class="metric-number">{{item.verification}}</text><text class="metric-unit">次</text></view>
              <view><text class="metric-number">{{item.recharge}}</text><text class="metric-unit">次</text></view>
              <view><text class="metric-number">{{item.experience}}</text><text class="metric-unit">次</text></view>
              <view><text class="metric-number">{{item.refund}}</text><text class="metric-unit">次</text></view>
            </view>
            <view class="table-row summary-total"><view class="summary-product"><text>合计</text></view><view>{{hqProjectSummaryTotals.verification}} 次</view><view>{{hqProjectSummaryTotals.recharge}} 次</view><view>{{hqProjectSummaryTotals.experience}} 次</view><view>{{hqProjectSummaryTotals.refund}} 次</view></view>
            <view wx:if="{{!hqProjectSummaryRows.length}}" class="table-empty">{{hqProjectSummaryLoading ? '正在读取全部项目汇总…' : (hqProjectSummaryError || '当前没有项目')}}</view>
          </view>
        </scroll-view>
        <view wx:if="{{hqProjectSummaryPage.totalPages > 1}}" class="table-pagination hq-project-summary-pagination"><button disabled="{{hqProjectSummaryPage.previousDisabled || hqProjectSummaryLoading}}" bindtap="previousHqProductSummaryPage">上一页</button><text>第 {{hqProjectSummaryPage.page}} / {{hqProjectSummaryPage.totalPages}} 页</text><button disabled="{{hqProjectSummaryPage.nextDisabled || hqProjectSummaryLoading}}" bindtap="nextHqProductSummaryPage">下一页</button></view>
      </view>

      <view class="web-panel ranking-panel">
        <view class="panel-heading ranking-heading"><view><text class="panel-title">完整排名</text><text class="hq-ranking-rule">{{hqProductLabels[hqProductIndex]}} · 按{{hqDimensionLabels[hqDimensionIndex]}}的{{hqRankingMetricLabels[hqRankingMetricIndex]}}次数降序</text></view><view class="ranking-actions"><button bindtap="exportHqRanking" disabled="{{loading || hqRankingLoading || hqExporting || hqRankingError}}">{{hqExporting ? '正在导出…' : '导出完整报表 PDF'}}</button></view></view>
        <view class="hq-ranking-list"><view wx:for="{{hqRanking}}" wx:key="entityId" class="hq-ranking-card"><view class="hq-ranking-head"><text>第 {{item.rank}} 名</text><text>{{item.name}}</text><text>{{item.share}}</text></view><view class="hq-ranking-metrics"><view><text>充值</text><text>{{item.recharge}}</text></view><view><text>核销</text><text>{{item.verification}}</text></view><view><text>体验</text><text>{{item.experience}}</text></view><view><text>退费</text><text>{{item.refund}}</text></view></view></view><view wx:if="{{!hqRanking.length}}" class="table-empty">{{loading || hqRankingLoading ? '正在读取排名…' : (hqRankingError || '当前日期范围暂无有效数据')}}</view></view>
        <view class="table-pagination hq-ranking-pagination"><button disabled="{{hqRankingPage.previousDisabled || hqRankingLoading}}" bindtap="previousHqPage">上一页</button><text>第 {{hqRankingPage.page}} / {{hqRankingPage.totalPages}} 页 · 共 {{hqRankingPage.total}} 条</text><button disabled="{{hqRankingPage.nextDisabled || hqRankingLoading}}" bindtap="nextHqPage">下一页</button><view class="ranking-page-jump"><text>跳至第</text><input type="number" value="{{hqRankingInput}}" bindinput="inputHqPage" /><text>页</text><button disabled="{{hqRankingLoading}}" bindtap="jumpHqPage">跳转</button></view><button wx:if="{{hqRankingError}}" class="ranking-retry" bindtap="retryHqRanking">重试排名</button></view>
      </view>
    </block>
    <view class="safe-bottom"></view>
  </view>
</view>
