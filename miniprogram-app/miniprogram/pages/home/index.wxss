.profile-card { display: flex; align-items: center; gap: 20rpx; margin-bottom: 20rpx; padding: 28rpx; color: #fff; background: linear-gradient(125deg, #102947, #1d5a91); border-radius: 26rpx; box-shadow: 0 16rpx 38rpx rgba(16,41,71,.18); }
.identity-icon { display: flex; width: 86rpx; height: 86rpx; flex: none; align-items: center; justify-content: center; background: rgba(255,255,255,.14); border: 1rpx solid rgba(255,255,255,.25); border-radius: 22rpx; font-size: 35rpx; font-weight: 900; }
.identity-main { min-width: 0; flex: 1; }
.identity-brand, .identity-name, .identity-meta { display: block; }
.identity-brand { overflow: hidden; font-size: 34rpx; font-weight: 850; text-overflow: ellipsis; white-space: nowrap; }
.identity-name { margin-top: 5rpx; overflow: hidden; color: #bcd3e8; font-size: 23rpx; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }
.identity-meta { margin-top: 5rpx; color: #d2dfec; font-size: 22rpx; }
.logout { width: auto; min-height: 64rpx; margin: 0; padding: 0 18rpx; color: #fff; background: rgba(255,255,255,.1); border: 1rpx solid rgba(255,255,255,.24); border-radius: 14rpx; font-size: 22rpx; }
.logout::after { border: 0; }
.action.experience { grid-column: 1 / -1; background: #effbf6; border-color: #b9e4d3; }
.quota { display: flex; align-items: center; justify-content: space-between; gap: 18rpx; padding: 20rpx 0; border-top: 1rpx solid #e3ebf3; }
.quota:first-child { border-top: 0; }
.quota-name, .quota-code { display: block; }
.quota-name { font-weight: 800; }
.quota-code { margin-top: 5rpx; color: #6d8095; font-size: 21rpx; }
.quota-count { display: flex; align-items: baseline; gap: 7rpx; color: #086e5c; }
.quota-count text { font-size: 38rpx; font-weight: 850; }
.quota-count .quota-unit { font-size: 21rpx; font-weight: 400; }
