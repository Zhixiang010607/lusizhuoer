<view class="page">
  <view class="page-heading"><view><text class="title">工作月历</text><text class="subtitle">本人考勤与日报月度记录</text></view><button class="back" bindtap="back"><text class="button-label">返回工作台</text></button></view>
  <view wx:if="{{!authorized}}" class="notice">正在确认老师账号…</view>
  <block wx:else>
    <view class="mode-tabs"><button class="mode-tab {{mode === 'attendance' ? 'active' : ''}}" data-mode="attendance" bindtap="switchMode"><text class="button-label">考勤月历</text></button><button class="mode-tab {{mode === 'report' ? 'active' : ''}}" data-mode="report" bindtap="switchMode"><text class="button-label">日报月历</text></button></view>
    <view class="panel calendar-panel">
      <picker class="month-picker" mode="date" fields="month" value="{{month}}" end="{{monthPickerEnd}}" bindchange="chooseMonth" disabled="{{loading}}"><view><text>{{monthTitle}}</text><text>点此直接选择年月</text></view></picker>
      <view class="month-actions"><button data-delta="-12" bindtap="changeMonth" disabled="{{loading}}"><text class="button-label">上一年</text></button><button data-delta="-1" bindtap="changeMonth" disabled="{{loading}}"><text class="button-label">上月</text></button><button data-delta="1" bindtap="changeMonth" disabled="{{loading || !canNextMonth}}"><text class="button-label">下月</text></button><button data-delta="12" bindtap="changeMonth" disabled="{{loading || !canNextYear}}"><text class="button-label">下一年</text></button></view>
      <view wx:if="{{mode === 'attendance'}}" class="legend"><view><text class="dot done"></text><text>已打卡</text></view><view><text class="dot missing"></text><text>未打卡</text></view><view><text class="dot not-employed"></text><text>未入职</text></view><text>左点上班，右点下班</text></view>
      <view wx:else class="legend"><view><text class="dot done"></text><text>已写日报</text></view><view><text class="dot missing"></text><text>未写日报</text></view><view><text class="dot not-employed"></text><text>未入职</text></view></view>
      <view class="weekdays"><text wx:for="{{weekdays}}" wx:key="*this">{{item}}</text></view>
      <view wx:if="{{loading}}" class="calendar-loading">正在读取月度记录…</view>
      <view wx:else class="calendar-grid"><view wx:for="{{days}}" wx:key="key" class="day {{item.blank ? 'blank' : ''}} {{selectedDate === item.date ? 'selected' : ''}} {{item.future ? 'future' : ''}} {{item.notEmployed ? 'not-employed' : ''}}" data-date="{{item.date}}" bindtap="selectDate"><text wx:if="{{!item.blank}}" class="day-number">{{item.day}}</text><text wx:if="{{!item.blank && item.notEmployed}}" class="not-employed-label">未入职</text><view wx:elif="{{!item.blank && mode === 'attendance'}}" class="dots"><text class="dot {{item.clockInState}}"></text><text class="dot {{item.clockOutState}}"></text></view><view wx:elif="{{!item.blank}}" class="dots"><text class="dot {{item.reportState}}"></text></view></view></view>
    </view>
    <view wx:if="{{message && !loading}}" class="message {{error ? 'error' : ''}}">{{message}}</view>
    <view wx:if="{{selected && mode === 'attendance'}}" class="panel detail-panel">
      <view class="detail-heading"><view><text class="section-title">{{selected.date}} 考勤详情</text><text class="section-note">{{teacher.teacherName}} · {{teacher.phone}}</text></view><text class="badge">{{selected.notEmployed ? '未入职' : selected.workDurationText}}</text></view>
      <view wx:if="{{selected.notEmployed}}" class="empty">该日期尚未入职</view>
      <view wx:else class="attendance-grid"><view class="attendance-card"><text class="kind">上班打卡</text><block wx:if="{{selected.clockIn}}"><text class="time">{{selected.clockIn.timeText}}</text><text>{{selected.clockIn.placeName || '未解析附近地点'}}</text><text>{{selected.clockIn.formattedAddress || '暂无文字地址'}}</text><text>精度约 {{selected.clockIn.accuracy}} 米</text><button data-kind="clockIn" bindtap="openMap"><text class="button-label">在地图中打开</text></button></block><block wx:else><text class="empty">未打卡</text><button wx:if="{{selected.date === serverToday}}" class="punch-button" bindtap="openAttendance"><text class="button-label">办理上班打卡</text></button></block></view><view class="attendance-card"><text class="kind">下班打卡</text><block wx:if="{{selected.clockOut}}"><text class="time">{{selected.clockOut.timeText}}</text><text>{{selected.clockOut.placeName || '未解析附近地点'}}</text><text>{{selected.clockOut.formattedAddress || '暂无文字地址'}}</text><text>精度约 {{selected.clockOut.accuracy}} 米</text><button data-kind="clockOut" bindtap="openMap"><text class="button-label">在地图中打开</text></button></block><block wx:else><text class="empty">{{selected.date === serverToday && !selected.clockIn ? '需先完成上班打卡' : '未打卡'}}</text><button wx:if="{{selected.date === serverToday && selected.clockIn}}" class="punch-button" bindtap="openAttendance"><text class="button-label">办理下班打卡</text></button></block></view></view>
    </view>
    <view wx:if="{{selected && mode === 'report'}}" class="panel detail-panel">
      <view class="detail-heading"><view><text class="section-title">{{selected.date}} 日报</text><text class="section-note">{{teacher.teacherName}} · {{teacher.phone}}</text></view><text class="badge">{{selected.notEmployed ? '未入职' : selected.report ? '已填写' : '未填写'}}</text></view>
      <view wx:if="{{selected.report}}" class="report-list"><view><text>今日完成事项</text><text>{{selected.report.completedWork}}</text></view><view><text>客户与项目进展</text><text>{{selected.report.customerProjectProgress}}</text></view><view><text>问题与所需支持</text><text>{{selected.report.problemsAndSupport}}</text></view><view><text>明日计划</text><text>{{selected.report.tomorrowPlan}}</text></view></view>
      <view wx:else class="empty">{{selected.notEmployed ? '该日期尚未入职' : '当天没有日报'}}</view>
      <button wx:if="{{selected.date === serverToday}}" class="action-button" bindtap="openDailyReport"><text class="button-label">{{selected.report ? '修改今日日报' : '填写今日日报'}}</text></button>
    </view>
  </block>
</view>
