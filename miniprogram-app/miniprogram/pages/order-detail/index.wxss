.order-hero { display: flex; flex-direction: column; align-items: stretch; gap: 18rpx; padding: 32rpx; background: linear-gradient(135deg, #4b4033, #8b642e); color: #fffdf8; }
.hero-copy { width: 100%; min-width: 0; overflow: hidden; flex: 1; }
.order-hero .eyebrow { color: #f5dfb6; }
.order-title-scroll { width: 100%; max-width: 100%; margin-top: 8rpx; overflow: hidden; white-space: nowrap; }
.order-title { display: inline-block; padding-right: 2rpx; font-size: 30rpx; font-weight: 900; line-height: 1.28; white-space: nowrap; }
.order-address { display: block; margin-top: 12rpx; overflow: hidden; color: #eadcc6; font-size: 22rpx; line-height: 1.5; text-overflow: ellipsis; white-space: nowrap; }
.status-badge { align-self: flex-start; flex: 0 0 auto; padding: 9rpx 14rpx; background: rgba(255,255,255,.16); border: 1rpx solid rgba(255,255,255,.3); border-radius: 999rpx; font-size: 22rpx; font-weight: 800; }
.fact-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12rpx; margin-bottom: 16rpx; }
.fact-card { min-width: 0; margin: 0; padding: 20rpx; }
.fact-card text { display: block; overflow: hidden; color: #7c7062; font-size: 21rpx; text-overflow: ellipsis; white-space: nowrap; }
.fact-card .fact-value { margin-top: 7rpx; color: #302a22; font-size: 28rpx; font-weight: 800; }
.fact-card .fact-note { margin-top: 5rpx; color: #8a7d6d; font-size: 20rpx; }
.fact-card[data-label="客户"] .fact-value { color: #8b642e; }
.detail-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12rpx; }
.detail-grid view { min-width: 0; padding: 18rpx; background: #fff7eb; border-radius: 14rpx; }
.detail-grid text { display: block; overflow: hidden; color: #7c7062; font-size: 21rpx; text-overflow: ellipsis; white-space: nowrap; }
.detail-grid .detail-value { margin-top: 7rpx; color: #302a22; font-size: 24rpx; font-weight: 800; }
.gift-detail-card { background: #fffaf3; }
.gift-detail-list { display: grid; gap: 10rpx; }
.gift-detail-row { display: flex; align-items: center; justify-content: space-between; gap: 18rpx; padding: 18rpx; background: #fff7eb; border: 1rpx solid #dfcfb4; border-radius: 14rpx; }
.gift-detail-row > view { min-width: 0; }
.gift-detail-row text { display: block; overflow: hidden; color: #302a22; font-size: 24rpx; font-weight: 800; text-overflow: ellipsis; white-space: nowrap; }
.gift-detail-row view text:last-child { margin-top: 5rpx; color: #7c7062; font-size: 20rpx; font-weight: 500; }
.gift-detail-row > text { flex: none; color: #7b5a2d; font-size: 26rpx; }
.note-row { padding: 18rpx 0; border-top: 1rpx solid #eadfce; }
.note-row:first-of-type { border-top: 0; }
.note-row text { display: block; }
.note-row text:first-child { color: #7c7062; font-size: 21rpx; font-weight: 800; }
.note-row text:last-child { margin-top: 7rpx; line-height: 1.65; white-space: pre-wrap; }
.photo-heading > view { min-width: 0; }
.photo-note { display: block; margin-top: 6rpx; color: #7c7062; font-size: 20rpx; font-weight: 400; }
.photo-list-error { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; margin-bottom: 16rpx; padding: 14rpx; color: #8d3e35; background: #fff0ed; border: 1rpx solid #e6bdb7; border-radius: 13rpx; font-size: 20rpx; line-height: 1.45; }
.photo-list-error text { min-width: 0; flex: 1; }
.edit-window { margin-bottom: 16rpx; padding: 13rpx 15rpx; color: #5e523f; background: #f5ead8; border-radius: 12rpx; font-size: 20rpx; line-height: 1.45; }
.photo-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14rpx; }
.photo-card { min-width: 0; padding: 12rpx; overflow: hidden; background: #fff7eb; border: 1rpx solid #eadcc6; border-radius: 16rpx; }
.photo-card:nth-child(5) { grid-column: 1 / -1; }
.photo-frame { width: 100%; height: 250rpx; overflow: hidden; background: #eee4d6; border-radius: 12rpx; }
.photo { width: 100%; height: 100%; background: #eee4d6; border-radius: 0; }
.slot-placeholder { width: 100%; height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 12rpx; padding: 18rpx; color: #837563; text-align: center; }
.slot-placeholder text { font-size: 20rpx; line-height: 1.4; }
.slot-placeholder.slot-error { color: #8d3e35; background: #fff1ed; }
.slot-retry-target { border: 1rpx dashed #d7b98a; }
.slot-retry-target:active { background: #f8e5dc; }
.photo-meta { min-width: 0; padding: 10rpx 2rpx; }
.photo-meta text { display: block; overflow: hidden; font-size: 23rpx; font-weight: 800; text-overflow: ellipsis; white-space: nowrap; }
.photo-meta text:last-child { margin-top: 4rpx; color: #7c7062; font-size: 19rpx; font-weight: 400; }
.photo-actions { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8rpx; }
.photo-actions button, .upload-button, .compact-button { width: auto; max-width: 100%; min-width: 0; min-height: 60rpx; box-sizing: border-box; display: flex; align-items: center; justify-content: center; margin: 0; padding: 0 8rpx; overflow: hidden; color: #74592d; background: #f4e7d0; border: 0; border-radius: 10rpx; font-size: 20rpx; line-height: 1.2; text-align: center; text-overflow: ellipsis; white-space: nowrap; }
.photo-actions button[disabled], .upload-button[disabled], .compact-button[disabled] { color: #9b9082; background: #e7ddce; }
.upload-button { width: 100%; justify-self: stretch; margin-top: 8rpx; color: #fffdf8; background: #6f532e; font-weight: 800; }
.compact-button { flex: none; min-height: 54rpx; padding: 0 12rpx; font-size: 18rpx; line-height: 54rpx; }
.export-card { background: linear-gradient(145deg, #fffaf3, #f7ead5); }
.export-actions { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12rpx; }
.export-actions button { width: 100%; min-height: 78rpx; margin: 0; font-size: 23rpx; }
.export-progress { display: block; margin-top: 12rpx; color: #756958; font-size: 20rpx; text-align: center; }
.export-canvas { position: fixed; left: -10000px; top: 0; width: 1240px; height: 1754px; pointer-events: none; }
