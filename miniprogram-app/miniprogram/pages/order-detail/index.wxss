.order-hero { display: flex; align-items: flex-start; justify-content: space-between; gap: 18rpx; padding: 32rpx; background: linear-gradient(135deg, #102947, #1f5d86); color: #fff; }
.order-hero .eyebrow { color: #bfe8ff; }
.order-title { display: block; margin-top: 8rpx; font-size: 38rpx; font-weight: 900; }
.order-address { display: block; margin-top: 12rpx; color: #d6e5f2; font-size: 22rpx; line-height: 1.5; }
.status-badge { flex: 0 0 auto; padding: 9rpx 14rpx; background: rgba(255,255,255,.16); border: 1rpx solid rgba(255,255,255,.3); border-radius: 999rpx; font-size: 22rpx; font-weight: 800; }
.fact-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12rpx; margin-bottom: 16rpx; }
.fact-card { min-width: 0; margin: 0; padding: 20rpx; }
.fact-card text { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.fact-card text { color: #60758b; font-size: 21rpx; }
.fact-card .fact-value { margin-top: 7rpx; color: #172033; font-size: 28rpx; font-weight: 800; }
.fact-card .fact-note { margin-top: 5rpx; color: #7f8fa1; font-size: 20rpx; }
.fact-card[data-label="客户"] .fact-value { color: #1f5eff; }
.detail-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12rpx; }
.detail-grid view { min-width: 0; padding: 18rpx; background: #f5f8fb; border-radius: 14rpx; }
.detail-grid text { display: block; }
.detail-grid text { color: #60758b; font-size: 21rpx; }
.detail-grid .detail-value { margin-top: 7rpx; color: #172033; font-size: 24rpx; font-weight: 800; word-break: break-all; }
.note-row { padding: 18rpx 0; border-top: 1rpx solid #e6ebf1; }
.note-row:first-of-type { border-top: 0; }
.note-row text { display: block; }
.note-row text:first-child { color: #60758b; font-size: 21rpx; font-weight: 800; }
.note-row text:last-child { margin-top: 7rpx; line-height: 1.65; white-space: pre-wrap; }
.photo-note { display: block; margin-top: 6rpx; color: #60758b; font-size: 20rpx; font-weight: 400; }
.photo-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14rpx; }
.photo-card { min-width: 0; padding: 12rpx; background: #f5f8fb; border-radius: 16rpx; }
.photo { width: 100%; height: 250rpx; background: #e5ebf2; border-radius: 12rpx; }
.photo-card > view:nth-child(2) { padding: 10rpx 2rpx; }
.photo-card > view:nth-child(2) text { display: block; }
.photo-card > view:nth-child(2) text { font-size: 23rpx; font-weight: 800; }
.photo-card > view:nth-child(2) .photo-size { margin-top: 4rpx; color: #60758b; font-size: 19rpx; font-weight: 400; }
.photo-actions { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8rpx; }
.photo-actions button { width: auto; min-height: 60rpx; margin: 0; padding: 0 8rpx; color: #164a72; background: #e6f2fa; border: 0; border-radius: 10rpx; font-size: 20rpx; line-height: 60rpx; }
