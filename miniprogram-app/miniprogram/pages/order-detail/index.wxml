<view class="page">
  <view wx:if="{{loading}}" class="card empty">正在从数据库读取工单…</view>
  <block wx:elif="{{order}}">
    <view class="card order-hero">
      <view class="hero-copy"><text class="eyebrow">{{order.typeLabel}}</text><scroll-view class="order-title-scroll" scroll-x="true" show-scrollbar="{{false}}"><text class="order-title">{{noun}}单 {{order.recordCode}}</text></scroll-view><text class="order-address">门店详细地址：{{order.storeAddress}}</text></view>
      <text class="status-badge status-{{order.recordStatus}}">{{order.statusLabel}}</text>
    </view>

    <view class="fact-grid">
      <view wx:for="{{facts}}" wx:key="label" class="card fact-card" data-label="{{item.label}}" bindtap="openFact"><text>{{item.label}}</text><text class="fact-value">{{item.value || '—'}}</text><text class="fact-note">{{item.note}}</text></view>
    </view>

    <view class="card detail-card">
      <view class="card-title"><text>{{noun}}信息</text><text class="badge">数据库原单</text></view>
      <view class="detail-grid {{baseType === 'VERIFICATION' && order.originalType !== 'SUPPLEMENT' ? 'detail-grid-three' : 'detail-grid-reviewed'}}">
        <view><text>工单类型</text><text class="detail-value">{{order.typeLabel}}</text></view>
        <view><text>次数</text><text class="detail-value">{{order.unitCount}} 次</text></view>
        <view class="detail-time"><text>提交时间</text><text class="detail-value">{{order.submittedAt}}</text></view>
        <view wx:if="{{baseType === 'RECHARGE' || order.originalType === 'SUPPLEMENT'}}" class="detail-time"><text>审核时间</text><text class="detail-value">{{order.reviewedAt}}</text></view>
      </view>
    </view>

    <view wx:if="{{(baseType === 'RECHARGE' && order.productGifts.length) || notes.length}}" class="order-secondary-grid">
      <view wx:if="{{baseType === 'RECHARGE' && order.productGifts.length}}" class="card gift-detail-card">
        <view class="card-title"><text>产品赠予</text><text class="badge">{{order.productGifts.length}} 种</text></view>
        <view class="gift-detail-list">
          <view wx:for="{{order.productGifts}}" wx:key="retailProductId" class="gift-detail-row">
            <view><text>{{item.productName}}</text><text>{{item.productCode}}</text></view>
            <text>{{item.unitCount}} 件</text>
          </view>
        </view>
      </view>

      <view wx:if="{{notes.length}}" class="card notes-card">
        <view class="card-title"><text>工单说明</text><text class="badge">{{notes.length}} 项</text></view>
        <view wx:for="{{notes}}" wx:key="label" class="note-row"><text>{{item.label}}</text><text>{{item.value}}</text></view>
      </view>
    </view>

    <view wx:if="{{baseType === 'VERIFICATION'}}" class="card photo-section">
      <view class="card-title photo-heading">
        <view><text>核销照片</text><text class="photo-note">展示核销身份照与三张补充照片</text></view>
        <text class="badge">{{visiblePhotoCount}} / 4</text>
      </view>
      <view wx:if="{{photoManifestError}}" class="photo-list-error">
        <text>照片清单读取失败：{{photoManifestError}}</text>
        <button class="secondary compact-button" bindtap="retryPhotoList" loading="{{photoLoading}}" disabled="{{photoLoading || uploading || exporting}}">重试清单</button>
      </view>
      <view wx:if="{{canEdit}}" class="edit-window">可补充或替换照片位 3–5；服务端授权截止 {{editableUntilLabel}}</view>
      <view class="photo-grid">
        <view wx:for="{{photos}}" wx:key="slot" hidden="{{!item.visible}}" class="photo-card state-{{item.state}}">
          <view class="photo-frame">
            <image wx:if="{{item.declared && item.thumbnailState === 'ready'}}" class="photo" src="{{item.thumbnailUrl}}" mode="aspectFill" data-slot="{{item.slot}}" bindtap="previewPhoto" binderror="photoThumbnailError"></image>
            <view wx:elif="{{item.declared}}" class="slot-placeholder slot-error slot-retry-target" data-slot="{{item.slot}}" bindtap="retryThumbnail">
              <text wx:if="{{item.retrying}}">正在重新读取这张照片…</text>
              <text wx:elif="{{item.retryError}}">{{item.retryError}}</text>
              <text wx:else>点击重新加载这张照片</text>
              <button class="secondary compact-button" data-slot="{{item.slot}}" catchtap="retryThumbnail" loading="{{item.retrying}}" disabled="{{item.retrying}}">{{item.retrying ? '读取中' : '重新加载此图'}}</button>
            </view>
            <view wx:elif="{{item.state === 'loading'}}" class="slot-placeholder"><text>正在读取此照片位…</text></view>
            <view wx:elif="{{item.state === 'list-error'}}" class="slot-placeholder slot-error"><text>清单读取失败</text></view>
            <view wx:else class="slot-placeholder"><text>此照片位尚未上传</text></view>
          </view>
          <view class="photo-meta"><text>{{item.label}}</text><text>{{item.declared ? '已留存' : (item.state === 'empty' ? '空照片位' : '状态待确认')}}</text></view>
          <view wx:if="{{item.declared}}" class="photo-actions">
            <button data-slot="{{item.slot}}" bindtap="previewPhoto" loading="{{item.originalBusy && item.originalAction === 'preview'}}" disabled="{{item.originalBusy || uploading}}">查看原图</button>
            <button data-slot="{{item.slot}}" bindtap="savePhoto" loading="{{item.originalBusy && item.originalAction === 'save'}}" disabled="{{item.originalBusy || uploading}}">保存相册</button>
            <button data-slot="{{item.slot}}" bindtap="sharePhoto" loading="{{item.originalBusy && item.originalAction === 'share'}}" disabled="{{item.originalBusy || uploading}}">转发照片</button>
          </view>
          <button wx:if="{{canEdit && item.slot >= 2}}" class="upload-button" data-slot="{{item.slot}}" bindtap="uploadExtraPhoto" loading="{{uploading && uploadingSlot === item.slot}}" disabled="{{uploading || exporting || photoLoading || item.originalBusy}}">{{item.declared ? '选择或拍摄替换' : '选择或拍摄补充'}}</button>
        </view>
      </view>
    </view>

    <view class="card export-card">
      <view class="card-title"><text>导出业务凭证</text><text class="badge">{{noun}}</text></view>
      <view class="export-actions"><button class="primary" bindtap="exportPdf" loading="{{exporting}}" disabled="{{exporting || uploading}}">导出 PDF</button><button class="secondary" bindtap="exportImage" loading="{{exporting}}" disabled="{{exporting || uploading}}">导出图片</button></view>
      <text wx:if="{{exportProgress}}" class="export-progress">{{exportProgress}}</text>
    </view>

    <view wx:if="{{baseType === 'VERIFICATION'}}" class="card rating-card">
      <view class="card-title"><text>客户评价</text><text class="badge">{{rating.submitted ? '已评价' : '暂无评价'}}</text></view>
      <view wx:if="{{ratingLoading}}" class="rating-empty">正在读取客户评价…</view>
      <view wx:elif="{{ratingError}}" class="rating-empty rating-load-error">
        <text>{{ratingError}}</text>
        <button class="secondary compact-button" bindtap="retryRating">重新读取</button>
      </view>
      <view wx:elif="{{!rating.submitted}}" class="rating-empty">暂无评价</view>
      <view wx:else class="rating-content">
        <view class="rating-score-row"><text>门店环境</text><text class="rating-stars">{{rating.storeEnvironmentStars}}</text><text class="rating-score-value">{{rating.storeEnvironmentScore}} 星</text></view>
        <view wx:if="{{rating.requiresTeacherScore}}" class="rating-score-row"><text>老师服务</text><text class="rating-stars">{{rating.teacherServiceStars}}</text><text class="rating-score-value">{{rating.teacherServiceScore}} 星</text></view>
        <view class="rating-score-row"><text>整体体验</text><text class="rating-stars">{{rating.overallExperienceStars}}</text><text class="rating-score-value">{{rating.overallExperienceScore}} 星</text></view>
        <view wx:if="{{rating.customerComment}}" class="rating-comment"><text>客户留言</text><text>{{rating.customerComment}}</text></view>
        <text class="rating-time">评价时间：{{rating.submittedAtLabel}}</text>
      </view>
    </view>
  </block>
  <view wx:if="{{message}}" class="message {{error ? 'error' : 'success'}}">{{message}}</view>
  <view wx:if="{{photoViewerOpen}}" class="photo-viewer" catchtouchmove="stopViewerEvent" bindtap="closePhotoViewer">
    <view class="photo-viewer-panel" catchtap="stopViewerEvent">
      <view class="photo-viewer-head">
        <text>{{photoViewerLabel}}</text>
        <button class="photo-viewer-close" catchtap="closePhotoViewer">关闭</button>
      </view>
      <image class="photo-viewer-image" src="{{photoViewerPath}}" mode="aspectFit"></image>
      <view class="photo-viewer-actions">
        <button class="secondary" catchtap="saveViewerPhoto">保存相册</button>
        <button class="primary" catchtap="shareViewerPhoto">转发照片</button>
      </view>
    </view>
  </view>
  <canvas id="receiptCanvas" type="2d" class="export-canvas"></canvas>
  <canvas id="photoNormalizeCanvas" type="2d" class="export-canvas"></canvas>
  <view class="safe-bottom"></view>
</view>
