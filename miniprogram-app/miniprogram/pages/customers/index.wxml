<view class="page">
  <view class="page-heading"><text class="eyebrow">客户资料</text><text class="title">{{session.role === 'teacher' ? '我的业务客户' : '客户查询'}}</text><text class="subtitle">{{session.role === 'teacher' ? '本人创建或本人有效业务关联的客户' : '按当前账号允许的门店范围查询'}}</text></view>

  <view wx:if="{{session.role !== 'teacher'}}" class="card search-card">
    <label class="field"><text class="field-label">客户姓名（可选）</text><input class="input" placeholder="支持姓名包含查询" value="{{name}}" bindinput="inputName" /></label>
    <label class="field"><text class="field-label">生日（可选）</text><picker mode="date" value="{{birthDate}}" end="{{today}}" bindchange="inputBirthday"><view class="picker">{{birthDate || '选择生日'}}</view></picker></label>
    <view class="button-row"><button class="primary" bindtap="search">查询</button><button class="ghost" bindtap="resetSearch">清空</button></view>
  </view>

  <view class="card">
    <view class="segmented">
      <button class="{{status === 'ACTIVE' ? 'active' : ''}}" data-status="ACTIVE" bindtap="changeStatus">活跃客户</button>
      <button class="{{status === 'ARCHIVED' ? 'active' : ''}}" data-status="ARCHIVED" bindtap="changeStatus">封存客户</button>
    </view>
    <view wx:if="{{loading}}" class="empty">正在读取客户…</view>
    <scroll-view wx:elif="{{customers.length}}" class="customer-table-scroll" scroll-x="true" enhanced="true" show-scrollbar="false">
      <view class="customer-table">
        <view class="customer-row customer-head">
          <text>姓名</text><text>门店</text><text>生日</text><text>充值</text><text>核销</text><text>详情</text>
        </view>
        <view wx:for="{{customers}}" wx:key="customerCode" class="customer-row" data-code="{{item.customerCode}}" bindtap="openCustomer">
          <text class="customer-name">{{item.customerName}}</text>
          <text>{{item.storeName || '—'}}</text>
          <text>{{item.birthDate || '未填写'}}</text>
          <text>{{item.rechargeCount || item.totalRechargeCount || 0}} 次</text>
          <text>{{item.verificationCount || item.totalVerificationCount || 0}} 次</text>
          <text class="customer-link">查看</text>
        </view>
      </view>
    </scroll-view>
    <view wx:else class="empty">当前范围暂无{{status === 'ACTIVE' ? '活跃' : '封存'}}客户</view>
    <view class="pager">
      <button class="ghost" bindtap="previousPage" disabled="{{page <= 1 || loading}}">上一页</button>
      <text>第 {{page}} 页</text>
      <button class="ghost" bindtap="nextPage" disabled="{{!hasMore || loading}}">下一页</button>
    </view>
  </view>
  <view wx:if="{{message}}" class="message error">{{message}}</view>
</view>
