.search-card .query-modes { margin-bottom: 20rpx; }
.query-modes button { display: flex; align-items: center; justify-content: center; text-align: center; line-height: 1.2; white-space: nowrap; }
.two-fields { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12rpx; }
.summary-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8rpx; margin-bottom: 14rpx; }
.summary-grid view { min-width: 0; padding: 16rpx 6rpx; text-align: center; background: #fff; border: 1rpx solid #dfcfb4; border-radius: 16rpx; }
.summary-grid text { display: block; }
.summary-grid text { min-height: 48rpx; color: #7c7062; font-size: 19rpx; line-height: 1.25; }
.summary-grid .summary-value { min-height: 0; margin-top: 4rpx; color: #302a22; font-size: 29rpx; font-weight: 800; }
.result-card { min-width: 0; overflow: hidden; }
.customer-table-scroll { width: 100%; max-width: 100%; margin-top: 14rpx; overflow: hidden; border: 1rpx solid #dfcfb4; border-radius: 14rpx; }
.customer-table { width: 1120rpx; min-width: 1120rpx; background: #fff; }
.customer-row { min-height: 72rpx; display: grid; grid-template-columns: 132rpx 92rpx 92rpx 160rpx 170rpx 200rpx 170rpx 104rpx; align-items: center; border-top: 1rpx solid #dfcfb4; }
.customer-row:first-child { border-top: 0; }
.customer-row text { width: 100%; min-width: 0; min-height: 72rpx; display: flex; align-items: center; justify-content: center; justify-self: stretch; padding: 10rpx 8rpx; overflow: hidden; font-size: 21rpx; text-align: center; text-overflow: ellipsis; white-space: nowrap; }
.customer-head { min-height: 66rpx; color: #675b4b; background: #f5ead8; font-size: 22rpx; font-weight: 800; }
.customer-name, .customer-link { color: #8b642e; font-weight: 800; }
.pager { width: 100%; display: grid; grid-template-columns: 116rpx minmax(0, 1fr) 116rpx; align-items: center; gap: 10rpx; padding-top: 20rpx; border-top: 1rpx solid #eadfce; }
.pager button { width: 116rpx; min-height: 56rpx; display: flex; align-items: center; justify-content: center; margin: 0; padding: 0 10rpx; font-size: 18rpx; line-height: 1; }
.pager text { min-width: 0; color: #7c7062; font-size: 18rpx; text-align: center; white-space: nowrap; }
.page-jump { width: 100%; min-width: 0; display: flex; align-items: center; justify-content: center; gap: 8rpx; margin-top: 12rpx; overflow: hidden; }
.page-jump input { width: 100rpx; min-height: 56rpx; padding: 0 10rpx; font-size: 18rpx; text-align: center; background: #fff; border: 1rpx solid #d8c5a3; border-radius: 12rpx; }
.page-jump button { width: 116rpx; min-height: 56rpx; display: flex; align-items: center; justify-content: center; margin: 0; padding: 0 10rpx; font-size: 18rpx; line-height: 1; }
