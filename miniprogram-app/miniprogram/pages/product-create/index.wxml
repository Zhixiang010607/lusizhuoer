<view class="page">
  <view class="page-heading"><text class="title">产品创建</text><text class="permission">总部权限</text></view>

  <view class="panel">
    <view class="section-title">产品资料</view>
    <label class="field"><text>产品名称</text><input maxlength="60" data-field="name" value="{{form.name}}" bindinput="input" placeholder="请输入产品名称" /></label>
    <label class="field"><text>产品类别</text><input maxlength="32" data-field="type" value="{{form.type}}" bindinput="input" placeholder="例如：护理项目" /></label>
    <label class="field"><text>产品介绍（选填）</text><textarea maxlength="1000" data-field="description" value="{{form.description}}" bindinput="input" placeholder="可填写产品介绍" /></label>
  </view>

  <view wx:if="{{message}}" class="message {{error ? 'error' : 'success'}}">{{message}}</view>
  <view class="actions"><button class="ghost" bindtap="back" disabled="{{submitting}}">返回产品管理</button><button class="primary" bindtap="submit" loading="{{submitting}}" disabled="{{submitting}}">创建产品</button></view>
  <view class="safe-bottom"></view>
</view>
