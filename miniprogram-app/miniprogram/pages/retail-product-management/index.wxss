page { min-height: 100%; color: #302a22; background: #f3ede2; }
.page { width: calc(100% - 28rpx); min-height: 100vh; margin: 0 auto; padding: 16rpx 0 40rpx; }
.page-heading { margin: 8rpx 6rpx 20rpx; }
.title { font-family: Georgia, "Times New Roman", serif; font-size: 40rpx; font-weight: 800; }
.panel { padding: 24rpx; background: #fffaf3; border: 1rpx solid #dfcfb4; border-radius: 24rpx; box-shadow: 0 12rpx 34rpx rgba(93,72,39,.08); }
.management-toolbar { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: 18rpx; margin-bottom: 16rpx; padding: 24rpx; background: #fffaf3; border: 1rpx solid #dfcfb4; border-radius: 24rpx; box-shadow: 0 12rpx 34rpx rgba(93,72,39,.08); }
.toolbar-copy { min-width: 0; display: flex; flex-direction: column; gap: 7rpx; }
.toolbar-copy text:first-child { font-size: 29rpx; font-weight: 850; }
.toolbar-copy text:last-child { color: #7c7062; font-size: 20rpx; line-height: 1.45; }
.add-button { width: auto; min-width: 154rpx; min-height: 74rpx; margin: 0; padding: 0 20rpx; border-radius: 15rpx; font-size: 22rpx; line-height: 1; }
.message { margin-bottom: 16rpx; padding: 17rpx 20rpx; border-radius: 16rpx; font-size: 21rpx; line-height: 1.5; }
.message.error { color: #8b3f35; background: #fff1ed; border: 1rpx solid #e4bdb4; }
.message.success { color: #4f664f; background: #f0f6ec; border: 1rpx solid #c9dbc0; }
.list-card { padding: 22rpx 16rpx 16rpx; }
.list-heading { display: flex; align-items: flex-start; justify-content: space-between; gap: 16rpx; margin: 0 8rpx 20rpx; }
.list-heading > view { min-width: 0; display: flex; flex-direction: column; gap: 6rpx; }
.list-heading > view text:first-child { font-size: 29rpx; font-weight: 850; }
.count { flex: none; padding: 7rpx 13rpx; color: #785d2e; background: #f3e6c9; border-radius: 999rpx; font-size: 19rpx; font-weight: 850; white-space: nowrap; }
.product-grid { display: grid; grid-template-columns: minmax(0, 1.4fr) 1fr .7fr .85fr; align-items: center; min-width: 0; }
.product-grid > text { min-width: 0; padding: 0 6rpx; overflow: hidden; text-align: center; text-overflow: ellipsis; white-space: nowrap; }
.product-head { min-height: 66rpx; color: #675c4e; background: #f4e8d1; border-radius: 15rpx 15rpx 0 0; font-size: 19rpx; font-weight: 850; }
.product-row { min-height: 84rpx; background: #fffaf3; border: 1rpx solid #eadcc6; border-top: 0; font-size: 20rpx; }
.product-row:last-child { border-radius: 0 0 15rpx 15rpx; }
.product-name { font-weight: 850; }
.status { justify-self: center; width: auto; padding: 5rpx 10rpx !important; border-radius: 999rpx; font-size: 18rpx; font-weight: 850; }
.status.active { color: #4f6f5d; background: #e7f1ea; }
.status.archived { color: #985047; background: #f8e8e4; }
.status-button { justify-self: center; display: flex; align-items: center; justify-content: center; box-sizing: border-box; width: 104rpx; min-width: 0; height: 56rpx; min-height: 56rpx; margin: 0; padding: 0; color: #74582a; background: #fffaf3; border: 1rpx solid #d5b77d; border-radius: 12rpx; font-size: 18rpx; line-height: 1; }
.status-button.archive { color: #9b493f; background: #fff2ef; border-color: #dca99f; }
.empty { padding: 42rpx 12rpx; color: #887c6d; font-size: 21rpx; text-align: center; }
.safe-bottom { height: calc(24rpx + env(safe-area-inset-bottom)); }

@media (min-width: 700px) {
  .page { width: calc(100% - 48px); max-width: 1040px; padding: 20px 0 36px; }
  .page-heading { margin: 0 4px 14px; }
  .title { font-size: 26px; }
  .management-toolbar { gap: 16px; margin-bottom: 14px; padding: 18px; border-width: 1px; border-radius: 18px; }
  .toolbar-copy { gap: 4px; }
  .toolbar-copy text:first-child { font-size: 22px; }
  .toolbar-copy text:last-child { font-size: 14px; }
  .add-button { min-width: 132px; min-height: 44px; padding: 0 18px; border-radius: 11px; font-size: 14px; }
  .message { margin-bottom: 14px; padding: 13px 16px; border-radius: 12px; font-size: 14px; }
  .list-card { padding: 18px; border-width: 1px; border-radius: 18px; }
  .list-heading { align-items: center; margin: 0 0 14px; }
  .list-heading > view { gap: 4px; }
  .list-heading > view text:first-child { font-size: 22px; }
  .count { padding: 5px 10px; font-size: 13px; }
  .product-head { display: none; }
  .product-list { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 12px; }
  .product-row, .product-row:last-child {
    min-height: 112px;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-rows: auto auto;
    gap: 12px 10px;
    padding: 18px;
    background: #fffaf3;
    border: 1px solid #dfcfb4;
    border-radius: 16px;
    box-shadow: 0 8px 24px rgba(93,72,39,.07);
    font-size: 14px;
  }
  .product-grid > text { padding: 0; text-align: left; }
  .product-name { grid-column: 1; grid-row: 1; align-self: center; font-size: 20px; }
  .product-code { grid-column: 1; grid-row: 2; align-self: center; color: #7c7062; font-size: 14px; }
  .status { grid-column: 2; grid-row: 1; align-self: center; padding: 4px 9px !important; font-size: 12px; }
  .status-button { grid-column: 2; grid-row: 2; width: 82px; height: 38px; min-height: 38px; border-width: 1px; border-radius: 10px; font-size: 13px; }
  .empty { padding: 36px 12px; font-size: 14px; }
}
