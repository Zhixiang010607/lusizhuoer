@import "../store-create/index.wxss";
.field.invalid input { border-color: #a15a4c; }
.field > text.validation-error { color: #8b3f35; font-size: 22rpx; font-weight: 400; line-height: 1.5; overflow-wrap: anywhere; }
.password-control { position: relative; min-width: 0; }
.field .password-input { padding-right: 116rpx; }
.password-visibility { position: absolute; top: 0; right: 0; width: 108rpx !important; min-height: 82rpx; height: 100%; margin: 0; padding: 0 12rpx; display: flex; align-items: center; justify-content: center; color: #74592d; background: transparent; border: 0; border-radius: 15rpx; font-size: 23rpx; line-height: 1.3; }
.password-visibility::after { border: 0; }
.rule-panel { display: grid; grid-template-columns: minmax(0, 1fr); gap: 10rpx; }
.rule-panel > view { display: flex; flex-direction: column; gap: 5rpx; padding: 17rpx; background: #fff; border: 1rpx solid #eadcc6; border-radius: 14rpx; }
.rule-panel > view text:first-child { font-size: 22rpx; font-weight: 850; }
.rule-panel > view text:last-child { color: #7c7062; font-size: 18rpx; line-height: 1.45; }

@media (min-width: 700px) {
  .page { width: calc(100% - 48px); max-width: 1120px; padding: 20px 0 36px; }
  .page-heading { gap: 16px; margin: 4px 4px 16px; }
  .page-heading text:first-child { font-size: 26px; }
  .page-heading text:last-child, .section-heading > text { padding: 5px 10px; font-size: 13px; }
  .panel { margin-bottom: 14px; padding: 20px; border-width: 1px; border-radius: 18px; }
  .section-heading { gap: 12px; margin-bottom: 14px; }
  .section-heading > view { gap: 4px; }
  .section-heading > view text:first-child { font-size: 20px; }
  .section-heading > view text:last-child:not(:first-child) { font-size: 13px; }
  .teacher-fields { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
  .field { gap: 7px; margin-top: 0; }
  .field > text:not(.field-help) { font-size: 14px; }
  .field input { min-height: 50px; padding: 0 14px; border-width: 1px; border-radius: 12px; font-size: 16px; }
  .field .password-input { padding-right: 70px; }
  .field > text.validation-error { font-size: 13px; }
  .password-visibility { width: 64px !important; min-height: 50px; padding: 0 8px; border-radius: 12px; font-size: 14px; }
  .rule-panel { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }
  .rule-panel > view { gap: 4px; padding: 14px; border-width: 1px; border-radius: 12px; }
  .rule-panel > view text:first-child { font-size: 15px; }
  .rule-panel > view text:last-child { font-size: 13px; }
  .actions { max-width: 560px; gap: 12px; margin: 0 auto; }
  .actions button { min-height: 48px; border-radius: 12px; font-size: 15px; }
}
