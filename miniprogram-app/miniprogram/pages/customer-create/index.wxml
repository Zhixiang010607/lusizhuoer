<view class="page">
  <view class="page-heading"><text class="eyebrow">现场建档</text><text class="title">建立客户</text><text class="subtitle">当前门店：{{store.name}}。照片、资料、人脸档案必须由服务端整体成功。</text></view>
  <view class="card">
    <label class="field"><text class="field-label">客户姓名</text><input class="input" maxlength="100" value="{{name}}" bindinput="inputName" placeholder="请输入真实姓名" /></label>
    <label class="field"><text class="field-label">生日</text><picker mode="date" value="{{birthDate}}" end="{{today}}" bindchange="inputBirthday"><view class="picker">{{birthDate || '请选择生日'}}</view></picker></label>
    <label class="field"><text class="field-label">客户备注（可选）</text><textarea class="textarea" maxlength="1000" value="{{notes}}" bindinput="inputNotes" placeholder="最多 1000 字"></textarea></label>
  </view>
  <view class="card">
    <camera-capture id="customerCamera" title="客户建档照片" bindchange="captureChanged"></camera-capture>
    <label class="consent"><checkbox checked="{{consent}}" bindtap="toggleConsent" color="#2166d5" /><text>我已取得客户明确授权：采集并绑定其人脸信息，仅用于本人核销身份验证与业务安全。</text></label>
  </view>
  <button class="primary submit" bindtap="submit" loading="{{busy}}" disabled="{{busy || !captureReady || !consent}}">验证照片并建立客户</button>
  <view wx:if="{{message}}" class="message {{error ? 'error' : 'success'}}">{{message}}</view>
</view>
