.login-page {
  min-height: 100vh;
  display: flex;
  align-items: center;
  padding: calc(72rpx + env(safe-area-inset-top)) 48rpx calc(72rpx + env(safe-area-inset-bottom));
  background: #f6f6f3;
}
.login-shell {
  width: 100%;
  max-width: 620rpx;
  margin: 0 auto;
}
.login-card {
  width: 100%;
  padding: 0;
  background: transparent;
}
.login-brand {
  margin-bottom: 112rpx;
  text-align: center;
}
.login-brand text {
  display: block;
  color: #172033;
  font-size: 56rpx;
  font-weight: 500;
  letter-spacing: 22rpx;
  line-height: 1;
  text-indent: 22rpx;
}
.login-card .field { margin-bottom: 42rpx; }
.login-card .field-label {
  margin-bottom: 12rpx;
  color: #6d727b;
  font-size: 21rpx;
  font-weight: 500;
  letter-spacing: 2rpx;
}
.login-card .input {
  min-height: 72rpx;
  padding: 0;
  color: #172033;
  background: transparent;
  border: 0;
  border-bottom: 1rpx solid #c8cbd0;
  border-radius: 0;
  box-shadow: none;
  font-size: 28rpx;
}
.login-card .input:focus { border-color: #172033; }
.login-placeholder { color: #aaadb2; }
.password-field { position: relative; }
.password-field .input { padding-right: 100rpx; }
.password-toggle {
  position: absolute;
  top: 0;
  right: 0;
  width: 88rpx;
  min-height: 72rpx;
  margin: 0;
  padding: 0;
  color: #686d76;
  background: transparent;
  border-radius: 0;
  font-size: 20rpx;
  font-weight: 500;
  line-height: 72rpx;
}
.password-toggle::after { border: 0; }
.login-button {
  width: 100%;
  min-height: 94rpx;
  margin: 26rpx 0 0;
  color: #fff;
  background: #172033;
  border-radius: 4rpx;
  box-shadow: none;
  font-size: 25rpx;
  font-weight: 500;
  letter-spacing: 8rpx;
  text-indent: 8rpx;
}
.login-button[disabled] {
  color: #92959a;
  background: #dcdedc;
}
.wechat-login {
  width: 100%;
  min-height: 92rpx;
  margin: 22rpx 0 0;
  color: #303640;
  background: transparent;
  border: 1rpx solid #bfc2c6;
  border-radius: 4rpx;
  box-shadow: none;
  font-size: 24rpx;
  font-weight: 500;
  line-height: 1.2;
}
.wechat-login::after { border: 0; }
.wechat-login[disabled] {
  color: #9a9da1;
  border-color: #d6d7d5;
  background: transparent;
}
.login-card .message {
  margin-top: 26rpx;
  color: #39414c;
  background: #eceeec;
}
.login-card .message.error {
  color: #963b35;
  background: #f4e9e7;
}
@media (max-width: 360px) {
  .login-page { padding-right: 36rpx; padding-left: 36rpx; }
  .login-brand { margin-bottom: 88rpx; }
  .login-brand text { font-size: 50rpx; letter-spacing: 18rpx; text-indent: 18rpx; }
}
