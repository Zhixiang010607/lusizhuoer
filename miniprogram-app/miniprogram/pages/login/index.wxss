.login-page {
  position: relative;
  min-height: 100vh;
  display: flex;
  align-items: center;
  overflow: hidden;
  padding: calc(44px + env(safe-area-inset-top)) 40rpx calc(28rpx + env(safe-area-inset-bottom));
  background: #f3ede2;
}
.login-background, .login-shade { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; }
.login-background { z-index: 0; }
.login-shade { z-index: 1; background: rgba(255, 250, 243, .24); }
.login-shell { position: relative; z-index: 2; width: 100%; max-width: 670rpx; margin: 0 auto; }
.login-card {
  width: 100%;
  padding: 36rpx 40rpx 32rpx;
  background: rgba(255, 250, 243, .96);
  border: 1rpx solid #dfcfb4;
  border-radius: 32rpx;
  box-shadow: 0 16rpx 48rpx rgba(120, 91, 43, .09);
}
.login-identity { display: flex; align-items: center; gap: 20rpx; margin: 0 8rpx 24rpx; }
.login-mark { position: relative; flex: none; width: 88rpx; height: 88rpx; overflow: hidden; border-radius: 50%; pointer-events: none; }
/* Counter-moving windows uncover the emblem without scaling or moving its pixels. */
.login-mark-reveal, .login-mark-surface { position: absolute; inset: 0; width: 100%; height: 100%; }
.login-mark-reveal { overflow: hidden; animation: login-emblem-window 1050ms cubic-bezier(.22, 1, .36, 1) both; }
.login-mark-surface { animation: login-emblem-surface 1050ms cubic-bezier(.22, 1, .36, 1) both; }
/* Frame the refined background emblem; keep the exact wordmark in WXML. */
.login-mark-art { position: absolute; width: 144rpx; height: 312rpx; left: -30rpx; top: -18rpx; }
.login-brand { min-width: 0; margin-bottom: 0; overflow: hidden; text-align: left; }
.login-brand text { display: block; color: #87662f; font-family: "Songti SC", "STSong", serif; font-size: 50rpx; font-weight: 600; letter-spacing: 12rpx; line-height: 1.25; animation: login-wordmark-reveal 960ms 180ms cubic-bezier(.22, 1, .36, 1) both; }
.login-heading { margin-bottom: 24rpx; }
.login-title { display: block; color: #302a22; font-size: 38rpx; font-weight: 600; line-height: 1.35; }
.login-subtitle { display: block; margin-top: 10rpx; color: #7c7062; font-size: 25rpx; line-height: 1.5; }
.login-card .field { margin-bottom: 20rpx; }
.login-card .field-label { margin-bottom: 12rpx; color: #675b4b; font-size: 26rpx; font-weight: 500; }
.login-card .input { width: 100%; height: 96rpx; min-height: 96rpx; padding: 0 26rpx; color: #302a22; background: #fffaf3; border: 1rpx solid #dfcfb4; border-radius: 18rpx; box-shadow: none; font-size: 30rpx; }
.login-card .input:focus { border-color: #a98243; }
.login-placeholder { color: #8d8171; }
.password-field { position: relative; }
.password-field .input { padding-right: 106rpx; }
.password-toggle { position: absolute; top: 0; right: 4rpx; display: flex; align-items: center; justify-content: center; width: 96rpx; min-width: 0; height: 96rpx; min-height: 96rpx; margin: 0; padding: 0; background: transparent; border-radius: 18rpx; line-height: 1; }
.eye-icon { position: relative; width: 38rpx; height: 24rpx; margin: 0; border: 2rpx solid #87662f; border-radius: 50% / 60%; }
.eye-icon view { position: absolute; top: 50%; left: 50%; width: 9rpx; height: 9rpx; transform: translate(-50%, -50%); background: #87662f; border-radius: 50%; }
.eye-icon:not(.visible)::after { content: ""; position: absolute; top: 9rpx; left: -5rpx; width: 48rpx; height: 2rpx; transform: rotate(-36deg); background: #87662f; box-shadow: 0 0 0 3rpx #fffaf3; }
.password-reset-row { display: flex; justify-content: flex-end; margin-top: 8rpx; }
.password-reset-link { display: flex; align-items: center; justify-content: center; min-height: 64rpx; padding: 0 0 0 24rpx; color: #87662f; font-size: 24rpx; font-weight: 500; line-height: 1.2; }
.login-button { width: 100% !important; max-width: 100%; min-width: 0; height: 96rpx; min-height: 96rpx; display: flex; align-items: center; justify-content: center; margin: 10rpx 0 0; padding: 0; color: #fffdf8; background: #a98243; border-radius: 18rpx; box-shadow: none; font-size: 30rpx; font-weight: 600; letter-spacing: 4rpx; text-indent: 4rpx; line-height: 1; }
.login-button[disabled] { color: #efe8da; background: #b9a17a; }
.wechat-login { width: 100% !important; max-width: 100%; min-width: 0; height: 96rpx; min-height: 96rpx; display: flex; align-items: center; justify-content: center; margin: 20rpx 0 0; padding: 0; color: #74592d; background: #fffaf3; border: 1rpx solid #dfcfb4; border-radius: 18rpx; box-shadow: none; font-size: 28rpx; font-weight: 500; line-height: 1; text-align: center; }
.wechat-login text { display: block; width: 100%; line-height: 1.4; text-align: center; }
.wechat-login::after { border: 0; }
.wechat-login[disabled] { color: #9b9082; background: #f3ede2; }
.login-card .message { margin-top: 24rpx; padding: 20rpx 24rpx; color: #5f513f; background: #f4e7d0; border: 1rpx solid #dfcfb4; border-radius: 16rpx; font-size: 25rpx; line-height: 1.5; }
.login-card .message.error { color: #913b31; background: #fff0ee; border-color: #ecd2cf; }
.login-collection { margin-top: 32rpx; }
.collection-heading { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; margin-bottom: 16rpx; padding: 0 4rpx; }
.collection-heading text:first-child { color: #5f513f; font-size: 27rpx; font-weight: 600; }
.collection-heading text:last-child { color: #8d8171; font-size: 21rpx; }
.project-entries { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 14rpx; }
.project-entries .project-entry { display: block; width: 100% !important; max-width: 100%; min-width: 0; margin: 0; padding: 0 0 16rpx; overflow: hidden; background: #fffaf3; border: 1rpx solid #dfcfb4; border-radius: 18rpx; line-height: 1.4; text-align: left; }
.entry-art { position: relative; height: 116rpx; overflow: hidden; background: radial-gradient(ellipse at 50% 25%, #fffdf9, #efe4d0); }
.entry-name { display: block; margin: 12rpx 14rpx 0; color: #70532b; font-size: 24rpx; font-weight: 500; }
.entry-note { display: block; margin: 6rpx 14rpx 0; color: #8c785c; font-size: 19rpx; }
.entry-skin view { position: absolute; top: 24rpx; left: 27%; width: 48%; height: 42rpx; transform: rotate(-25deg) skew(24deg,7deg); border: 1rpx solid #bd9b60; border-radius: 8rpx; background: linear-gradient(135deg,#fffaf3b3,#dbbf8c80); box-shadow: 2rpx 3rpx 0 #bd9b6033; }
.entry-skin view:nth-child(2) { top: 42rpx; }
.entry-skin view:nth-child(3) { top: 60rpx; }
.entry-ocean view { position: absolute; top: 12rpx; bottom: 10rpx; left: 26%; right: 26%; border: 2rpx solid #c6a46b; border-top-color: #fff9e9; border-radius: 48% 52% 42% 58%; box-shadow: inset 2rpx 0 0 #fffaf3; transform: rotate(14deg); }
.entry-ocean view:nth-child(2) { top: 23rpx; bottom: 22rpx; left: 32%; right: 32%; }
.entry-ocean view:nth-child(3) { top: 38rpx; bottom: 32rpx; left: 40%; right: 40%; background: #e6d3af77; }
.entry-warmth view { position: absolute; width: 60%; height: 40rpx; top: 30rpx; left: 19%; border-top: 3rpx solid #b48b4d; border-bottom: 2rpx solid #dcc49a; border-radius: 50%; transform: rotate(-22deg); background: linear-gradient(#eedfbd55,#fffaf355); }
.entry-warmth view:nth-child(2) { top: 42rpx; }
.entry-warmth view:nth-child(3) { top: 54rpx; }
@media (max-width: 360px) {
  .login-page { padding-right: 28rpx; padding-left: 28rpx; }
  .login-card { padding: 32rpx 32rpx 28rpx; }
  .login-identity { gap: 18rpx; margin-bottom: 20rpx; }
}
/* Physical dimensions keep the form readable without stretching it on iPad. */
@media (min-width: 700px) {
  .login-page { padding: calc(44px + env(safe-area-inset-top)) 40px calc(36px + env(safe-area-inset-bottom)); }
  .login-shell { max-width: 500px; }
  .login-card { padding: 46px 44px 38px; border-width: 1px; border-radius: 24px; box-shadow: 0 12px 40px rgba(120, 91, 43, .09); }
  .login-identity { gap: 16px; margin-bottom: 28px; }
  .login-mark { width: 72px; height: 72px; }
  .login-mark-art { width: 118px; height: 255px; left: -24px; top: -15px; }
  .login-brand { margin-bottom: 0; }
  .login-brand text { font-size: 36px; letter-spacing: 8px; }
  .login-heading { margin-bottom: 28px; }
  .login-title { font-size: 25px; }
  .login-subtitle { margin-top: 7px; font-size: 15px; }
  .login-card .field { margin-bottom: 20px; }
  .login-card .field-label { margin-bottom: 8px; font-size: 15px; }
  .login-card .input { height: 54px; min-height: 54px; padding: 0 18px; border-width: 1px; border-radius: 10px; font-size: 17px; }
  .password-field .input { padding-right: 66px; }
  .password-toggle { right: 2px; width: 58px; height: 54px; min-height: 54px; border-radius: 10px; }
  .eye-icon { width: 25px; height: 16px; border-width: 1.5px; }
  .eye-icon view { width: 6px; height: 6px; }
  .eye-icon:not(.visible)::after { top: 6px; left: -3px; width: 31px; height: 1.5px; box-shadow: 0 0 0 2px #fffaf3; }
  .password-reset-row { margin-top: 6px; }
  .password-reset-link { min-height: 38px; padding-left: 16px; font-size: 14px; }
  .login-button { height: 54px; min-height: 54px; margin-top: 8px; border-radius: 10px; font-size: 17px; letter-spacing: 2px; text-indent: 2px; }
  .wechat-login { width: 100% !important; height: 54px; min-height: 54px; margin-top: 14px; border-width: 1px; border-radius: 10px; font-size: 16px; }
  .login-card .message { margin-top: 18px; padding: 12px 14px; border-width: 1px; border-radius: 10px; font-size: 14px; }
  .login-collection { margin-top: 22px; }
  .collection-heading { gap: 8px; margin-bottom: 12px; padding: 0 3px; }
  .collection-heading text:first-child { font-size: 17px; }
  .collection-heading text:last-child { font-size: 12px; }
  .project-entries { gap: 12px; }
  .project-entries .project-entry { padding-bottom: 12px; border-width: 1px; border-radius: 12px; }
  .entry-art { height: 84px; }
  .entry-name { margin: 10px 12px 0; font-size: 16px; }
  .entry-note { margin: 5px 12px 0; font-size: 12px; }
  .entry-skin view { top: 16px; height: 30px; border-width: 1px; border-radius: 6px; }
  .entry-skin view:nth-child(2) { top: 29px; }
  .entry-skin view:nth-child(3) { top: 42px; }
  .entry-ocean view { top: 8px; bottom: 7px; border-width: 1px; }
  .entry-ocean view:nth-child(2) { top: 16px; bottom: 15px; }
  .entry-ocean view:nth-child(3) { top: 27px; bottom: 23px; }
  .entry-warmth view { height: 28px; top: 20px; border-top-width: 2px; border-bottom-width: 1px; }
  .entry-warmth view:nth-child(2) { top: 30px; }
  .entry-warmth view:nth-child(3) { top: 40px; }
}

/* One 1.14-second brand reveal. The background, form and native inputs stay still. */
@keyframes login-emblem-window {
  from { transform: translateY(102%); }
  to { transform: none; }
}
@keyframes login-emblem-surface {
  from { transform: translateY(-102%); }
  to { transform: none; }
}
@keyframes login-wordmark-reveal {
  from { transform: translateY(110%); }
  to { transform: none; }
}
@media (prefers-reduced-motion: reduce) {
  .login-mark-reveal, .login-mark-surface, .login-brand text { animation: none; transform: none; }
}
