<view class="login-page">
  <view class="login-shell">
    <view class="login-card">
      <image id="login-brand-image" class="login-hero" src="/images/login/brand-team.jpg" mode="widthFix" />
      <view class="login-heading"><text>登录</text></view>
      <button id="login-wechat-phone" class="wechat-login" open-type="getPhoneNumber" bindgetphonenumber="submitWechatPhone" loading="{{busy}}" disabled="{{busy}}">微信手机号快捷登录</button>
      <view class="login-divider"><view></view><text>或使用账号密码</text><view></view></view>
      <label class="field">
        <text class="field-label">手机号</text>
        <input id="login-phone" class="input" type="number" maxlength="11" placeholder="请输入 11 位手机号" placeholder-class="login-placeholder" value="{{phone}}" bindinput="inputPhone" />
      </label>
      <view class="field">
        <text class="field-label">登录密码</text>
        <view class="password-field">
          <input id="login-password" class="input" password="{{!passwordVisible}}" maxlength="32" placeholder="请输入登录密码" placeholder-class="login-placeholder" value="{{password}}" bindinput="inputPassword" />
          <button class="password-toggle" bindtap="togglePassword">{{passwordVisible ? '隐藏' : '显示'}}</button>
        </view>
      </view>
      <button id="login-submit" class="primary login-button" bindtap="submit" loading="{{busy}}" disabled="{{busy}}">登录系统</button>
      <view id="login-message" wx:if="{{message}}" class="message {{error ? 'error' : ''}}">{{message}}</view>
    </view>
  </view>
</view>
