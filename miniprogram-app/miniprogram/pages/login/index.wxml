<view class="login-page">
  <view class="brand">
    <view class="brand-mark">露</view>
    <view><text class="brand-name">露思卓儿</text><text class="brand-note">移动业务工作台</text></view>
  </view>
  <view class="login-card">
    <text class="welcome">登录工作台</text>
    <text class="description">使用现有总部、门店或老师手机号和密码登录。微信身份不会自动获得业务权限。</text>
    <label class="field">
      <text class="field-label">手机号</text>
      <input class="input" type="number" maxlength="11" placeholder="请输入 11 位手机号" value="{{phone}}" bindinput="inputPhone" />
    </label>
    <label class="field">
      <text class="field-label">登录密码</text>
      <input class="input" password="{{!passwordVisible}}" maxlength="32" placeholder="请输入现有账号密码" value="{{password}}" bindinput="inputPassword" />
    </label>
    <button class="password-toggle" bindtap="togglePassword">{{passwordVisible ? '隐藏密码' : '显示密码'}}</button>
    <button class="primary login-button" bindtap="submit" loading="{{busy}}" disabled="{{busy}}">登录系统</button>
    <view wx:if="{{message}}" class="message {{error ? 'error' : ''}}">{{message}}</view>
  </view>
  <text class="security-note">账号角色、门店范围和老师身份均由云端校验；小程序不保存密码。</text>
</view>
