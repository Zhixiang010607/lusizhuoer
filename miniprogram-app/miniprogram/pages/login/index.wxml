<view class="login-page">
  <image class="login-background" src="/images/login/lusizhuoer-login-bg-v4.jpg" mode="aspectFill"></image>
  <view class="login-shade"></view>
  <view class="login-light" aria-hidden="true"></view>
  <view class="login-shell">
    <view class="login-card">
      <view class="login-identity">
        <view class="login-mark" aria-hidden="true"><image class="login-mark-art" src="/images/login/lusizhuoer-login-bg-v4.jpg" mode="scaleToFill"></image><view class="login-mark-glint"></view></view>
        <view class="login-brand"><text>露思卓儿</text></view>
      </view>
      <view class="login-heading"><text class="login-title">欢迎回来</text><text class="login-subtitle">登录账号，开始今天的工作</text></view>
      <label class="field">
        <text class="field-label">手机号</text>
        <input id="login-phone" class="input" type="number" maxlength="11" placeholder="请输入手机号" placeholder-class="login-placeholder" value="{{phone}}" bindinput="inputPhone" />
      </label>
      <view class="field password-login-field">
        <text class="field-label">登录密码</text>
        <view class="password-field">
          <input id="login-password" class="input" password="{{!passwordVisible}}" maxlength="32" placeholder="请输入登录密码" placeholder-class="login-placeholder" value="{{password}}" bindinput="inputPassword" />
          <view class="password-toggle" role="button" aria-label="{{passwordVisible ? '隐藏密码' : '显示密码'}}" bindtap="togglePassword"><view class="eye-icon {{passwordVisible ? 'visible' : ''}}"><view></view></view></view>
        </view>
        <view class="password-reset-row"><text class="password-reset-link" role="button" bindtap="openPasswordReset">修改密码</text></view>
      </view>
      <button id="login-submit" class="primary login-button" bindtap="submit" loading="{{busy || startupChecking}}" disabled="{{busy || startupChecking}}">登录</button>
      <button id="login-wechat-phone" class="wechat-login" open-type="getPhoneNumber" bindgetphonenumber="submitWechatPhone" loading="{{busy || startupChecking}}" disabled="{{busy || startupChecking}}"><text>微信手机号登录</text></button>
      <view id="login-message" wx:if="{{message}}" class="message {{error ? 'error' : ''}}">{{message}}</view>
    </view>
  </view>
</view>
