<view class="login-page">
  <view class="brand">
    <view class="brand-mark">露</view>
    <text class="brand-name">露思卓儿</text>
  </view>
  <view class="login-card">
    <text class="welcome">登录</text>
    <button id="login-wechat-phone" class="wechat-login" open-type="getPhoneNumber" bindgetphonenumber="submitWechatPhone" loading="{{busy}}" disabled="{{busy}}">微信手机号快捷登录</button>
    <view class="login-divider"><view></view><text>或使用账号密码</text><view></view></view>
    <label class="field">
      <text class="field-label">手机号</text>
      <input id="login-phone" class="input" type="number" maxlength="11" placeholder="请输入 11 位手机号" value="{{phone}}" bindinput="inputPhone" />
    </label>
    <label class="field">
      <text class="field-label">登录密码</text>
      <input id="login-password" class="input" password="{{!passwordVisible}}" maxlength="32" placeholder="请输入现有账号密码" value="{{password}}" bindinput="inputPassword" />
    </label>
    <button class="password-toggle" bindtap="togglePassword">{{passwordVisible ? '隐藏密码' : '显示密码'}}</button>
    <button id="login-submit" class="primary login-button" bindtap="submit" loading="{{busy}}" disabled="{{busy}}">登录系统</button>
    <view id="login-message" wx:if="{{message}}" class="message {{error ? 'error' : ''}}">{{message}}</view>
  </view>
</view>
