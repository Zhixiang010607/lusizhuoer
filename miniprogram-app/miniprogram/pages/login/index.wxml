<view class="login-page">
  <image class="login-background" src="/images/login/lusizhuoer-login-bg-v3.jpg" mode="aspectFill"></image>
  <view class="login-shade"></view>
  <view class="login-shell">
    <view class="login-card">
      <view class="login-brand"><text>露思卓儿</text></view>
      <label class="field">
        <text class="field-label">手机号</text>
        <input id="login-phone" class="input" type="number" maxlength="11" placeholder="请输入手机号" placeholder-class="login-placeholder" value="{{phone}}" bindinput="inputPhone" />
      </label>
      <view class="field">
        <text class="field-label">登录密码</text>
        <view class="password-field">
          <input id="login-password" class="input" password="{{!passwordVisible}}" maxlength="32" placeholder="请输入登录密码" placeholder-class="login-placeholder" value="{{password}}" bindinput="inputPassword" />
          <button class="password-toggle" bindtap="togglePassword">{{passwordVisible ? '隐藏' : '显示'}}</button>
        </view>
      </view>
      <button id="login-submit" class="primary login-button" bindtap="submit" loading="{{busy}}" disabled="{{busy}}">登录</button>
      <button id="login-wechat-phone" class="wechat-login" open-type="getPhoneNumber" bindgetphonenumber="submitWechatPhone" loading="{{busy}}" disabled="{{busy}}">微信手机号登录</button>
      <view id="login-message" wx:if="{{message}}" class="message {{error ? 'error' : ''}}">{{message}}</view>
    </view>
  </view>
</view>
