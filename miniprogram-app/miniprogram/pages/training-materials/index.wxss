page { min-height: 100%; background: #f3ede2; color: #302a22; }
.training-page { width: calc(100% - 28rpx); min-height: 100vh; margin: 0 auto; padding: 16rpx 0 40rpx; }
.page-heading { min-height: 76rpx; display: flex; align-items: center; justify-content: space-between; gap: 18rpx; margin: 8rpx 6rpx 20rpx; padding: 10rpx 14rpx 10rpx 22rpx; box-sizing: border-box; }
.page-heading > view { min-width: 0; flex: 1; display: flex; align-items: center; }
.title { font-family: Georgia, "Times New Roman", serif; font-size: 40rpx; font-weight: 800; }
.back { flex: none; width: 176rpx !important; height: 68rpx; min-height: 68rpx; display: flex; align-items: center; justify-content: center; margin: 0; padding: 0 16rpx; box-sizing: border-box; color: #74592d; background: #fffaf3; border: 1rpx solid #d8c5a3; border-radius: 14rpx; font-size: 24rpx; font-weight: 750; line-height: 1; text-align: center; white-space: nowrap; }
.card { margin-bottom: 16rpx; padding: 24rpx; box-sizing: border-box; background: #fffaf3; border: 1rpx solid #dfcfb4; border-radius: 24rpx; }
.card-title { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; margin-bottom: 18rpx; }
.card-title > text:first-child { font-size: 30rpx; font-weight: 850; }
.badge { flex: none; padding: 6rpx 13rpx; color: #74592d; background: #f4e7d0; border-radius: 999rpx; font-size: 24rpx; font-weight: 750; }
.upload-grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: 14rpx; }
.field { display: block; margin: 0; }
.field-label { display: block; margin-bottom: 8rpx; color: #675b4b; font-size: 24rpx; font-weight: 750; }
.action-field .field-label { visibility: hidden; }
.input, .choose-button { width: 100%; height: 82rpx; min-height: 82rpx; box-sizing: border-box; }
.input { padding: 0 20rpx; background: #fff; border: 1rpx solid #d8c5a3; border-radius: 14rpx; font-size: 25rpx; line-height: 82rpx; }
.choose-button { display: flex; align-items: center; justify-content: center; margin: 0; color: #74592d; background: #fff; border: 1rpx solid #d8c5a3; border-radius: 14rpx; font-size: 24rpx; font-weight: 750; line-height: 1; }
.upload-grid .choose-button, .upload-grid .publish-button { width: 100% !important; min-width: 0; max-width: 100%; display: flex; align-items: center; justify-content: center; box-sizing: border-box; line-height: 1; white-space: nowrap; }
.selected-file { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; margin-top: 14rpx; padding: 14rpx 18rpx; background: #f8efdf; border-radius: 12rpx; color: #675b4b; font-size: 24rpx; }
.selected-file-name { min-width: 0; overflow: hidden; font-size: 24rpx; font-weight: 650; text-overflow: ellipsis; white-space: nowrap; }
.selected-file-size { flex: none; }
.publish-button { align-self: end; width: 100%; height: 82rpx; min-height: 82rpx; margin: 0; box-sizing: border-box; color: #fff; background: #7c5a2b; border-radius: 14rpx; font-size: 25rpx; font-weight: 800; line-height: 82rpx; text-align: center; }
.upload-grid .publish-button.is-disabled { color: #675b4b !important; background: #e7ddce !important; opacity: 1; }
.message { margin-bottom: 16rpx; padding: 16rpx 18rpx; border-radius: 14rpx; font-size: 24rpx; line-height: 1.5; }
.message.success { color: #4f664f; background: #f0f6ec; border: 1rpx solid #c9dbc0; }
.message.error { color: #8b3f35; background: #fff1ed; border: 1rpx solid #e4bdb4; }
.search-row { width: 100%; min-width: 0; display: grid; grid-template-columns: minmax(0, 1fr) 128rpx; gap: 10rpx; margin-bottom: 16rpx; box-sizing: border-box; }
.search-row button { width: 100% !important; height: 82rpx; min-height: 82rpx; margin: 0; padding: 0 8rpx; box-sizing: border-box; color: #fff; background: #7c5a2b; border-radius: 14rpx; font-size: 24rpx; font-weight: 750; line-height: 82rpx; text-align: center; }
.search-card .search-row { margin-bottom: 0; }
.pending-row { width: 100%; min-width: 0; display: grid; grid-template-columns: minmax(0, 1fr); align-items: center; gap: 14rpx; padding: 14rpx 0; border-top: 1rpx solid #eadfce; box-sizing: border-box; }
.pending-row.has-retry { grid-template-columns: minmax(0, 1fr) 132rpx; }
.pending-summary { width: 100%; min-width: 0; display: grid; grid-template-columns: minmax(0, 1fr) 132rpx; gap: 14rpx; align-items: center; box-sizing: border-box; }
.pending-info { min-width: 0; }
.pending-row .cancel-upload-button { color: #934b40; border-color: #e4bdb4; background: #fff3ef; }
.failed-actions { width: 100%; min-width: 0; display: grid; gap: 10rpx; }
.pending-row .retry-button.remove-task-button { color: #934b40; border-color: #e4bdb4; background: #fff3ef; }
.upload-stages { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8rpx; margin-top: 12rpx; }
.upload-stage { min-width: 0; padding: 10rpx 4rpx; border: 1rpx solid #dfcfb4; border-radius: 10rpx; color: #7c7062; background: #fff; font-size: 24rpx; line-height: 1; text-align: center; }
.upload-stage.current { color: #fff; background: #7c5a2b; border-color: #7c5a2b; }
.pending-row:first-of-type { border-top: 0; }
.pending-row > view { min-width: 0; flex: 1; }
.pending-title { display: block; overflow: hidden; font-size: 26rpx; font-weight: 800; text-overflow: ellipsis; white-space: nowrap; }
.pending-error { display: block; min-width: 0; margin-top: 6rpx; color: #8b3f35; font-size: 24rpx; line-height: 1.4; overflow-wrap: anywhere; word-break: break-word; }
.pending-row .retry-button { width: 100% !important; min-width: 0; max-width: 100%; height: 82rpx; min-height: 82rpx; display: flex; align-items: center; justify-content: center; margin: 0; padding: 0 12rpx; box-sizing: border-box; color: #74592d; background: #fff; border: 1rpx solid #d8c5a3; border-radius: 10rpx; font-size: 24rpx; line-height: 1; white-space: nowrap; }
.material-list { overflow: hidden; border: 1rpx solid #eadfce; border-radius: 18rpx; }
.material-row { display: flex; align-items: center; gap: 14rpx; min-height: 118rpx; padding: 18rpx 20rpx; background: #fff; border-top: 1rpx solid #eadfce; }
.material-row:first-child { border-top: 0; }
.material-row.archived { background: #f7f1e8; opacity: .72; }
.material-main { min-width: 0; flex: 1; }
.material-title-row { display: flex; align-items: center; gap: 10rpx; min-width: 0; }
.material-title { min-width: 0; overflow: hidden; font-size: 30rpx; font-weight: 850; text-overflow: ellipsis; white-space: nowrap; }
.material-meta { display: block; margin-top: 7rpx; overflow: hidden; color: #7c7062; font-size: 24rpx; text-overflow: ellipsis; white-space: nowrap; }
.material-actions { flex: none; display: flex; align-items: center; gap: 8rpx; }
.material-actions button { width: auto; min-height: 64rpx; margin: 0; padding: 0 16rpx; border-radius: 12rpx; font-size: 24rpx; font-weight: 750; line-height: 1; }
.material-actions .read-button, .material-actions .status-button { min-width: 0; max-width: 100%; display: flex; align-items: center; justify-content: center; box-sizing: border-box; white-space: nowrap; }
.material-actions .read-button { width: 118rpx !important; }
.material-actions .status-button { width: 80rpx !important; }
.read-button { color: #fff; background: #7c5a2b; }
.status-button { color: #934b40; background: #fff3ef; border: 1rpx solid #e4bdb4; }
.empty { padding: 46rpx 20rpx; color: #887c6d; font-size: 24rpx; text-align: center; }
.safe-bottom { height: calc(24rpx + env(safe-area-inset-bottom)); }

@media (max-width: 699px) {
  .page-heading { gap: 14rpx; padding: 10rpx 12rpx 10rpx 20rpx; }
  .title { font-size: 36rpx; }
  .back { width: 164rpx !important; padding: 0 10rpx; }
  .upload-grid { display: flex; flex-direction: column; align-items: stretch; }
  .upload-grid .field { width: 100%; min-width: 0; }
  .action-field .field-label { display: none; }
  .upload-grid .choose-button,
  .upload-grid .publish-button { width: 100% !important; min-width: 0; margin-right: 0; margin-left: 0; }
  .search-row { display: flex; width: 100%; min-width: 0; }
  .search-row .input { min-width: 0; width: 0; flex: 1 1 auto; }
  .search-row button { width: 128rpx !important; min-width: 128rpx; flex: 0 0 128rpx; padding: 0 8rpx; }
}

@media (min-width: 700px) {
  .training-page { width: calc(100% - 48px); max-width: 1060px; padding: 20px 0 36px; }
  .page-heading { min-height: 56px; margin: 0 4px 16px; padding: 8px 10px 8px 20px; gap: 16px; }
  .title { font-size: 28px; }
  .back { width: 150px !important; height: 44px; min-height: 44px; padding: 0 18px; border-width: 1px; border-radius: 11px; font-size: 14px; line-height: 1; }
  .card { margin-bottom: 16px; padding: 20px; border-width: 1px; border-radius: 18px; }
  .card-title { margin-bottom: 16px; }
  .card-title > text:first-child { font-size: 22px; }
  .badge { padding: 5px 10px; font-size: 14px; }
  .upload-grid { grid-template-columns: minmax(0, 1fr) 180px 180px; align-items: end; gap: 14px; }
  .field-label { margin-bottom: 7px; font-size: 14px; }
  .input, .choose-button { height: 48px; min-height: 48px; border-width: 1px; border-radius: 11px; font-size: 15px; }
  .input { padding: 0 15px; line-height: 48px; }
  .selected-file { margin-top: 12px; padding: 11px 14px; border-radius: 10px; font-size: 14px; }
  .selected-file-name { font-size: 15px; }
  .publish-button { width: 100%; height: 48px; min-height: 48px; margin: 0; border-radius: 11px; font-size: 15px; line-height: 48px; }
  .message { margin-bottom: 14px; padding: 12px 14px; border-width: 1px; border-radius: 11px; font-size: 14px; }
  .search-row { grid-template-columns: minmax(0, 1fr) 90px; gap: 10px; margin-bottom: 14px; }
  .search-row button { height: 48px; min-height: 48px; border-radius: 11px; font-size: 14px; line-height: 48px; }
  .pending-row { gap: 14px; padding: 12px 0; border-width: 1px; }
  .pending-row.has-retry { grid-template-columns: minmax(0, 1fr) 96px; }
  .pending-summary { grid-template-columns: minmax(0, 1fr) 96px; gap: 14px; }
  .failed-actions { gap: 8px; }
  .upload-stages { gap: 8px; margin-top: 10px; }
  .upload-stage { padding: 9px 4px; border-width: 1px; border-radius: 8px; font-size: 14px; }
  .pending-title { font-size: 17px; }
  .pending-error { margin-top: 4px; font-size: 14px; }
  .pending-row .retry-button { height: 48px; min-height: 48px; padding: 0 13px; border-width: 1px; border-radius: 9px; font-size: 14px; }
  .material-list { border-width: 1px; border-radius: 14px; }
  .material-row { min-height: 94px; gap: 16px; padding: 16px 18px; border-width: 1px; }
  .material-title-row { gap: 9px; }
  .material-title { font-size: 19px; }
  .material-meta { margin-top: 5px; font-size: 14px; }
  .material-actions { gap: 8px; }
  .material-actions button { min-height: 40px; padding: 0 14px; border-width: 1px; border-radius: 10px; font-size: 14px; }
  .material-actions .read-button { width: 88px !important; }
  .material-actions .status-button { width: 64px !important; }
  .empty { padding: 32px 16px; font-size: 14px; }
}

@media (min-width: 700px) and (max-width: 820px) {
  .upload-grid { grid-template-columns: minmax(0, 1fr) 160px 160px; gap: 12px; }
}
