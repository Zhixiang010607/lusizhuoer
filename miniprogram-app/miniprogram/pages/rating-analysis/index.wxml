<view class="page">
  <view class="page-heading"><text class="eyebrow">RATING ANALYSIS</text><text class="title">评价分析</text><text class="subtitle">按最低评分查询核销工单与评价覆盖率</text></view>

  <view class="card search-card">
    <view class="card-title"><text>查询条件</text><text class="badge">{{session.role === 'hq' ? '总部范围' : '本门店范围'}}</text></view>
    <view class="query-grid">
      <label wx:if="{{session.role === 'hq'}}" class="field"><text class="field-label">门店</text><picker range="{{storeLabels}}" value="{{storeIndex}}" bindchange="chooseStore" disabled="{{loading || exporting}}"><view class="picker">{{storeLabels[storeIndex]}}</view></picker></label>
      <label class="field"><text class="field-label">项目</text><picker range="{{productLabels}}" value="{{productIndex}}" bindchange="chooseProduct" disabled="{{loading || exporting}}"><view class="picker">{{productLabels[productIndex]}}</view></picker></label>
      <label class="field"><text class="field-label">老师</text><picker range="{{teacherLabels}}" value="{{teacherIndex}}" bindchange="chooseTeacher" disabled="{{loading || exporting}}"><view class="picker">{{teacherLabels[teacherIndex]}}</view></picker></label>
      <label class="field"><text class="field-label">时间范围</text><picker range="{{timeLabels}}" value="{{timeIndex}}" bindchange="chooseTime" disabled="{{loading || exporting}}"><view class="picker">{{timeLabels[timeIndex]}}</view></picker></label>
      <label wx:if="{{customRange}}" class="field"><text class="field-label">开始日期</text><picker mode="date" value="{{startDate}}" end="{{today}}" bindchange="changeStart" disabled="{{loading || exporting}}"><view class="picker">{{startDate || '请选择'}}</view></picker></label>
      <label wx:if="{{customRange}}" class="field"><text class="field-label">结束日期</text><picker mode="date" value="{{endDate}}" end="{{today}}" bindchange="changeEnd" disabled="{{loading || exporting}}"><view class="picker">{{endDate || '请选择'}}</view></picker></label>
    </view>
    <view class="score-filter">
      <text class="field-label">最低评分（可任意多选）</text>
      <view class="score-options"><button wx:for="{{scoreOptions}}" wx:key="score" class="score-option {{item.selected ? 'selected' : ''}}" data-score="{{item.score}}" bindtap="toggleScore" disabled="{{loading || exporting}}">{{item.label}}</button></view>
      <text class="query-note">0 表示未评价；已评价工单取门店环境、老师服务和整体体验中的最低分，无业务老师时取其余两项最低分。例如 5、5、4 归为 4 分。</text>
    </view>
    <view class="button-row"><button class="primary" bindtap="search" loading="{{loading}}" disabled="{{loading || exporting}}">查询评价</button><button class="ghost" bindtap="resetSearch" disabled="{{loading || exporting}}">重置查询</button></view>
  </view>

  <view wx:if="{{searched}}" class="chart-grid">
    <view class="card chart-card">
      <view class="card-title"><text>1–5 分分布</text><text class="badge">共 {{summary.rated}} 单</text></view>
      <view class="chart-body">
        <view class="pie-chart">
          <view wx:for="{{summary.scoreSlices}}" wx:key="key" class="pie-slice" style="{{item.sliceStyle}}"><view class="pie-slice-fill" style="{{item.fillStyle}}"></view></view>
          <view class="pie-center"><text class="pie-total">{{summary.rated}}</text><text class="pie-label">已评价</text></view>
        </view>
        <view class="chart-legend">
          <view class="legend-head"><text>评分</text><text>数量</text><text>占比</text></view>
          <view wx:for="{{summary.scoreLegend}}" wx:key="score" class="legend-row"><view class="legend-key"><view class="legend-key-content"><text class="legend-dot" style="background: {{item.color}}"></text><text class="legend-label">{{item.label}}</text></view></view><text class="legend-count">{{item.count}}</text><text class="legend-value">{{item.percentage}}</text></view>
        </view>
      </view>
      <text class="chart-note">仅统计当前条件下已评价工单；0 分未评价不进入本图。</text>
    </view>
    <view class="card chart-card">
      <view class="card-title"><text>评价覆盖率</text><text class="badge">{{summary.rated}} / {{summary.total}}</text></view>
      <view class="chart-body coverage-body">
        <view class="pie-chart">
          <view wx:for="{{summary.coverageSlices}}" wx:key="key" class="pie-slice" style="{{item.sliceStyle}}"><view class="pie-slice-fill" style="{{item.fillStyle}}"></view></view>
          <view class="pie-center"><text class="pie-total">{{summary.coveragePercent}}</text><text class="pie-label">评价覆盖率</text></view>
        </view>
        <view class="chart-legend">
          <view class="legend-head"><text>状态</text><text>数量</text><text>占比</text></view>
          <view wx:for="{{summary.coverageLegend}}" wx:key="label" class="legend-row"><view class="legend-key"><view class="legend-key-content"><text class="legend-dot" style="background: {{item.color}}"></text><text class="legend-label">{{item.label}}</text></view></view><text class="legend-count">{{item.count}}</text><text class="legend-value">{{item.percentage}}</text></view>
        </view>
      </view>
      <text class="chart-note">已评价与全部可评价核销工单的比例；分数多选不会改变图表分母。</text>
    </view>
  </view>

  <view class="card result-card">
    <view class="card-title"><text>工单结果</text><text class="badge">共 {{total}} 单</text></view>
    <view wx:if="{{searched}}" class="result-export"><text>导出当前条件下的全部工单，按门店分组；PDF、Excel 单次上限均为 1000 单。</text><view class="export-buttons"><button class="secondary" bindtap="exportPdf" loading="{{exporting}}" disabled="{{loading || exporting || total <= 0}}">导出 PDF</button><button class="secondary" bindtap="exportExcel" loading="{{exporting}}" disabled="{{loading || exporting || total <= 0}}">导出 Excel</button></view></view>
    <view wx:if="{{loading}}" class="empty">正在读取评价工单…</view>
    <scroll-view wx:elif="{{orders.length}}" class="rating-table-scroll" scroll-x="true" data-visible-rows="{{orders.length > 5 ? 5 : orders.length}}" scroll-y="{{orders.length > 5}}" scroll-left="{{tableScrollLeft}}" enhanced="true" show-scrollbar="{{orders.length > 5}}">
      <view class="rating-table">
        <view class="rating-row rating-head"><text>工单号</text><text>客户</text><text>门店</text><text>项目</text><text>老师</text><text>服务时间</text><text>最低分</text><text>门店环境</text><text>老师服务</text><text>整体体验</text></view>
        <view wx:for="{{orders}}" wx:key="rowKey" class="rating-row"><text class="table-link" data-id="{{item.id}}" data-code="{{item.recordCode}}" data-category="{{item.verificationType}}" bindtap="openOrder">{{item.recordCode}}</text><text class="table-link" data-code="{{item.customerCode}}" bindtap="openCustomer">{{item.customerName}}</text><text>{{item.storeName}}</text><text>{{item.productName}}</text><text>{{item.teacherName}}</text><text>{{item.serviceTime}}</text><text class="effective-score score-{{item.effectiveScore}}">{{item.effectiveScoreLabel}}</text><text>{{item.storeScoreLabel}}</text><text>{{item.teacherScoreLabel}}</text><text>{{item.overallScoreLabel}}</text></view>
      </view>
    </scroll-view>
    <view wx:elif="{{searched}}" class="empty">当前条件下没有匹配工单</view>
    <view wx:else class="empty">选择条件后查询评价工单</view>
    <view wx:if="{{searched}}" class="pager"><button class="ghost" bindtap="previousPage" disabled="{{loading || exporting || page <= 1}}">上一页</button><text>第 {{page}} / {{totalPages}} 页</text><button class="ghost" bindtap="nextPage" disabled="{{loading || exporting || page >= totalPages}}">下一页</button></view>
    <view wx:if="{{searched}}" class="page-jump"><text>跳至</text><input type="number" value="{{pageJump}}" bindinput="inputPageJump" disabled="{{exporting}}" /><text>页</text><button class="secondary" bindtap="jumpPage" disabled="{{loading || exporting}}">跳转</button></view>
  </view>

  <view wx:if="{{message}}" class="message {{error ? 'error' : ''}}">{{message}}</view>
  <view class="safe-bottom"></view>
</view>
