.search-card { padding: 18rpx; }
.search-card .card-title { margin-bottom: 12rpx; }
.query-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 12rpx; }
.query-grid .field { min-width: 0; margin-bottom: 10rpx; }
.query-grid .field-label { margin-bottom: 6rpx; font-size: 22rpx; }
.query-grid .picker { min-height: 72rpx; padding-right: 16rpx; padding-left: 16rpx; font-size: 24rpx; }
.score-filter { margin: 2rpx 0 14rpx; padding: 14rpx; background: #f8f0e4; border: 1rpx solid #e1cfaf; border-radius: 14rpx; }
.score-filter .field-label { margin-bottom: 10rpx; }
.score-options { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8rpx; }
.score-option { min-width: 0; min-height: 58rpx; margin: 0; padding: 0 6rpx; color: #6d6255; background: #fff; border: 1rpx solid #d9c8ad; border-radius: 12rpx; font-size: 20rpx; line-height: 1; }
.score-option.selected { color: #fffdf8; background: #75572f; border-color: #75572f; font-weight: 800; }
.score-option[disabled] { opacity: .68; }
.query-note { display: block; margin-top: 10rpx; color: #7c7062; font-size: 19rpx; line-height: 1.5; }
.search-card > .button-row button { min-height: 72rpx; font-size: 23rpx; }

.chart-grid { display: grid; grid-template-columns: 1fr; gap: 12rpx; margin-bottom: 14rpx; }
.chart-card { margin-bottom: 0; padding: 18rpx; }
.chart-card .card-title { margin-bottom: 8rpx; }
.chart-card .card-title text:first-child { font-size: 27rpx; }
.chart-body { min-width: 0; display: grid; grid-template-columns: 220rpx minmax(0, 1fr); align-items: center; gap: 12rpx; }
.pie-canvas { width: 220rpx; height: 220rpx; }
.chart-legend { min-width: 0; display: grid; gap: 5rpx; }
.legend-row { min-width: 0; display: grid; grid-template-columns: 14rpx minmax(0, 1fr) auto; align-items: center; gap: 7rpx; font-size: 18rpx; }
.legend-dot { width: 14rpx; height: 14rpx; border-radius: 50%; }
.legend-label { min-width: 0; overflow: hidden; color: #665a4b; text-overflow: ellipsis; white-space: nowrap; }
.legend-value { color: #302a22; font-variant-numeric: tabular-nums; font-weight: 750; white-space: nowrap; }
.chart-note { display: block; margin-top: 8rpx; color: #817463; font-size: 17rpx; line-height: 1.45; }

.result-card { min-width: 0; overflow: hidden; }
.rating-table-scroll { width: 100%; max-width: 100%; margin-top: 14rpx; overflow-x: auto; overflow-y: hidden; border: 1rpx solid #dfcfb4; border-radius: 14rpx; }
.rating-table-scroll[data-visible-rows="1"] { height: 138rpx; }
.rating-table-scroll[data-visible-rows="2"] { height: 210rpx; }
.rating-table-scroll[data-visible-rows="3"] { height: 282rpx; }
.rating-table-scroll[data-visible-rows="4"] { height: 354rpx; }
.rating-table-scroll[data-visible-rows="5"] { height: 426rpx; }
.rating-table { width: auto; min-width: 100%; display: inline-table; table-layout: auto; border-collapse: collapse; background: #fff; }
.rating-row { display: table-row; font-variant-numeric: tabular-nums; }
.rating-row text { height: 72rpx; display: table-cell; padding: 10rpx 18rpx; box-sizing: border-box; vertical-align: middle; border-top: 1rpx solid #dfcfb4; font-size: 21rpx; line-height: 1.25; text-align: center; white-space: nowrap; }
.rating-row:first-child text { border-top: 0; }
.rating-head { color: #675b4b; background: #f5ead8; font-weight: 800; }
.rating-head text { height: 66rpx; }
.table-link { color: #8b642e; font-weight: 800; }
.effective-score { font-weight: 900; }
.score-0 { color: #7d746b; }
.score-1, .score-2 { color: #9a3f37; }
.score-3 { color: #9a6926; }
.score-4, .score-5 { color: #4d7259; }
.pager { width: 100%; display: grid; grid-template-columns: 116rpx minmax(0, 1fr) 116rpx; align-items: center; gap: 10rpx; padding-top: 20rpx; border-top: 1rpx solid #eadfce; }
.pager button { width: 116rpx; min-height: 56rpx; display: flex; align-items: center; justify-content: center; margin: 0; padding: 0 10rpx; font-size: 18rpx; line-height: 1; }
.pager text { min-width: 0; color: #7c7062; font-size: 18rpx; text-align: center; white-space: nowrap; }
.page-jump { width: 100%; min-width: 0; display: flex; align-items: center; justify-content: center; gap: 8rpx; margin-top: 12rpx; overflow: hidden; }
.page-jump input { width: 100rpx; min-height: 56rpx; padding: 0 10rpx; font-size: 18rpx; text-align: center; background: #fff; border: 1rpx solid #d8c5a3; border-radius: 12rpx; }
.page-jump button { width: 116rpx; min-height: 56rpx; display: flex; align-items: center; justify-content: center; margin: 0; padding: 0 10rpx; font-size: 18rpx; line-height: 1; }

@media (min-width: 700px) {
  .page-heading { margin-bottom: 12px; padding: 12px 16px; border-radius: 14px; }
  .page-heading .title { font-size: 22px; }
  .search-card { padding: 14px 16px; }
  .query-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 0 12px; }
  .query-grid .field { margin-bottom: 10px; }
  .query-grid .field-label { margin-bottom: 5px; font-size: 13px; }
  .query-grid .picker { min-height: 42px; padding-right: 12px; padding-left: 12px; font-size: 14px; }
  .score-filter { margin: 0 0 10px; padding: 10px 12px; border-width: 1px; border-radius: 10px; }
  .score-filter .field-label { margin-bottom: 7px; font-size: 13px; }
  .score-options { grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 7px; }
  .score-option { min-height: 36px; padding: 0 5px; border-width: 1px; border-radius: 9px; font-size: 12px; }
  .query-note { margin-top: 7px; font-size: 11px; }
  .search-card > .button-row { gap: 10px; }
  .search-card > .button-row button { min-height: 42px; font-size: 14px; }
  .chart-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; margin-bottom: 12px; }
  .chart-card { padding: 14px 16px; }
  .chart-card .card-title { margin-bottom: 6px; }
  .chart-card .card-title text:first-child { font-size: 18px; }
  .chart-body { grid-template-columns: 150px minmax(0, 1fr); gap: 10px; }
  .pie-canvas { width: 150px; height: 150px; }
  .chart-legend { gap: 4px; }
  .legend-row { grid-template-columns: 9px minmax(0, 1fr) auto; gap: 6px; font-size: 11px; }
  .legend-dot { width: 9px; height: 9px; }
  .chart-note { margin-top: 6px; font-size: 10px; }
  .result-card { padding: 14px 16px; }
  .rating-table-scroll { margin-top: 10px; border-width: 1px; border-radius: 11px; }
  .rating-table-scroll[data-visible-rows="1"] { height: 104px; }
  .rating-table-scroll[data-visible-rows="2"] { height: 164px; }
  .rating-table-scroll[data-visible-rows="3"] { height: 224px; }
  .rating-table-scroll[data-visible-rows="4"] { height: 284px; }
  .rating-table-scroll[data-visible-rows="5"] { height: 344px; }
  .rating-row text { height: 60px; padding: 8px 14px; border-top-width: 1px; font-size: 14px; }
  .rating-head text { height: 44px; }
  .pager { grid-template-columns: 84px minmax(0, 1fr) 84px; gap: 8px; padding-top: 14px; border-top-width: 1px; }
  .pager button { width: 84px; min-height: 38px; padding: 0 8px; font-size: 12px; }
  .pager text { font-size: 12px; }
  .page-jump { gap: 6px; margin-top: 8px; }
  .page-jump input { width: 72px; min-height: 38px; padding: 0 8px; font-size: 12px; border-width: 1px; border-radius: 9px; }
  .page-jump button { width: 84px; min-height: 38px; padding: 0 8px; font-size: 12px; }
}
