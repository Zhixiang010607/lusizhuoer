<view class="workspace-page">
  <hq-rail active="management" />
  <view class="workspace-topbar detail-topbar"><view><text class="topbar-title">门店全局视图</text></view><view class="topbar-actions"><button class="ghost" bindtap="back">返回门店管理</button><button class="{{storeHero.archived ? 'secondary' : 'danger'}}" bindtap="toggleStatus" loading="{{statusLoading}}" disabled="{{statusLoading || !store}}">{{storeHero.archived ? '激活门店' : '封存门店'}}</button></view></view>
  <view class="workspace-main">
    <view wx:if="{{message}}" class="form-message {{error ? 'error' : ''}}">{{message}}</view>
    <view wx:if="{{loading && !store}}" class="web-panel empty">正在读取门店数据库…</view>
    <block wx:if="{{store}}">
      <view class="web-panel profile-hero"><view class="profile-avatar">店</view><view class="profile-copy"><text class="profile-type">门店账号</text><view class="profile-title-row"><text>{{storeHero.name}}</text><text class="store-status-badge {{storeHero.archived ? 'archived' : ''}}">{{storeHero.archived ? '封存' : '活跃'}}</text></view><text>{{storeHero.account}}</text></view></view>
      <view class="web-panel"><view class="panel-heading"><view><text class="panel-title">门店基础资料</text></view></view><view class="detail-info-grid"><view wx:for="{{profileFacts}}" wx:key="label" class="detail-info-item"><text>{{item.label}}</text><text>{{item.value}}</text></view></view></view>
      <view class="web-panel overview-panel">
        <view class="panel-heading"><view><text class="panel-title">门店业务汇总</text></view></view>
        <view class="range-presets"><button wx:for="{{rangeOptions}}" wx:key="value" class="range-button {{rangePreset === item.value ? 'active' : ''}}" data-value="{{item.value}}" bindtap="chooseRange">{{item.label}}</button></view>
        <view wx:if="{{customRangeVisible}}" class="custom-range"><label><text>开始日期</text><picker mode="date" value="{{rangeStart}}" bindchange="chooseStart"><view class="date-picker">{{rangeStart || '请选择'}}</view></picker></label><label><text>结束日期</text><picker mode="date" value="{{rangeEnd}}" bindchange="chooseEnd"><view class="date-picker">{{rangeEnd || '请选择'}}</view></picker></label><button bindtap="applyCustomRange">应用日期</button></view>
        <scroll-view class="table-scroll" scroll-x><view class="summary-table"><view class="table-row table-head"><view>项目</view><view>核销</view><view>充值</view><view>体验</view><view>退费</view></view><view wx:for="{{summaryRows}}" wx:key="productId" class="table-row {{item.total ? 'summary-total' : ''}}"><view class="summary-product"><text>{{item.productName}}</text><text>{{item.productCode}}</text></view><view><text class="metric-number">{{item.verification}}</text><text class="metric-unit">次</text></view><view><text class="metric-number">{{item.recharge}}</text><text class="metric-unit">次</text></view><view><text class="metric-number">{{item.experience}}</text><text class="metric-unit">次</text></view><view><text class="metric-number">{{item.refund}}</text><text class="metric-unit">次</text></view></view><view wx:if="{{!summaryRows.length}}" class="table-empty">{{businessLoading ? '正在计算业务汇总…' : '所选时间内暂无有效业务'}}</view></view></scroll-view>
        <view class="record-tabs"><button wx:for="{{businessTabs}}" wx:key="type" class="record-tab {{item.active ? 'active' : ''}}" data-type="{{item.type}}" bindtap="chooseBusiness"><text>{{item.label}}</text><text>{{item.total}} 次</text></button></view>
        <scroll-view class="table-scroll" scroll-x><view class="record-table"><view class="table-row table-head"><view>单号</view><view>门店</view><view>客户</view><view>项目</view><view>次数</view><view>提交时间</view></view><view wx:for="{{businessRecords}}" wx:key="id" class="table-row"><view class="table-link" data-id="{{item.id}}" data-code="{{item.recordCode}}" bindtap="openOrder">{{item.recordCode}}</view><view>{{item.storeName}}</view><view class="table-link" data-code="{{item.customerCode}}" bindtap="openCustomer">{{item.customerName}} · {{item.customerCode}}</view><view>{{item.productName}}</view><view><text class="metric-number">{{item.unitCount}}</text><text class="metric-unit">次</text></view><view>{{item.submittedAt}}</view></view><view wx:if="{{!businessRecords.length}}" class="table-empty">{{businessLoading ? '正在读取业务明细…' : '所选时间内暂无有效记录'}}</view></view></scroll-view>
        <view class="table-pagination"><button bindtap="previousBusiness" disabled="{{businessPage.previousDisabled || businessLoading}}">上一页</button><text>第 {{businessPage.page}} / {{businessPage.totalPages}} 页 · 共 {{businessPage.total}} 条</text><button bindtap="nextBusiness" disabled="{{businessPage.nextDisabled || businessLoading}}">下一页</button></view>
      </view>
      <view class="web-panel"><view class="panel-heading"><view><text class="panel-title">活跃用户</text></view><text class="web-badge">{{activeCustomers.total}} 位用户</text></view><template is="customerTable" data="{{group: activeCustomers, status: 'ACTIVE'}}" /></view>
      <view class="web-panel archived-section"><view class="panel-heading"><view><text class="panel-title">封存用户</text></view><text class="web-badge archived-badge">{{archivedCustomers.total}} 位用户</text></view><template is="customerTable" data="{{group: archivedCustomers, status: 'ARCHIVED'}}" /></view>
    </block>
  </view>
  <view class="safe-bottom"></view>
</view>

<template name="customerTable"><scroll-view class="table-scroll" scroll-x><view class="customer-table"><view class="table-row table-head"><view>姓名</view><view>门店</view><view>生日</view><view>充值次数</view><view>核销次数</view></view><view wx:for="{{group.rows}}" wx:key="customerCode" class="table-row"><view class="table-link" data-code="{{item.customerCode}}" bindtap="openCustomer">{{item.customerName}}</view><view>{{item.storeName}}</view><view>{{item.birthDate}}</view><view>{{item.rechargeCount}} 次</view><view>{{item.verificationCount}} 次</view></view><view wx:if="{{!group.rows.length}}" class="table-empty">暂无{{status === 'ARCHIVED' ? '封存' : '活跃'}}用户</view></view></scroll-view><view class="table-pagination"><button data-status="{{status}}" bindtap="previousCustomer" disabled="{{group.previousDisabled}}">上一页</button><text>第 {{group.page}} / {{group.totalPages}} 页</text><button data-status="{{status}}" bindtap="nextCustomer" disabled="{{group.nextDisabled}}">下一页</button></view></template>
