page { height: 100%; overflow: hidden; background: #f7f1e8; }
.company-page { position: relative; width: 100%; height: 100vh; overflow: hidden; color: #302a22; background: #f7f1e8; }
.reading-progress { position: fixed; z-index: 30; top: 0; right: 0; left: 0; height: 4rpx; background: rgba(122,87,43,.1); }
.reading-progress view { height: 100%; background: linear-gradient(90deg, #d4b37b, #98713b); transition: width 480ms cubic-bezier(.22,1,.36,1); }
.company-topbar { position: fixed; z-index: 24; top: 0; right: 0; left: 0; height: calc(88px + env(safe-area-inset-top)); display: flex; align-items: flex-end; padding: 0 30rpx 10px; transition: background-color 320ms ease, box-shadow 320ms ease; }
.company-topbar.scrolled { background: rgba(255,250,243,.96); box-shadow: 0 6rpx 24rpx rgba(94,67,32,.08); }
.topbar-brand { color: #5d4428; font-family: "Songti SC", "STSong", serif; font-size: 24rpx; font-weight: 600; letter-spacing: 5rpx; }
.topbar-login { position: absolute; right: 104px; bottom: 8px; width: 100rpx !important; min-width: 0; height: 32px; min-height: 32px; margin: 0; padding: 0; color: #634826; background: rgba(255,250,243,.68); border: 1rpx solid rgba(126,91,45,.56); border-radius: 16px; font-size: 24rpx; font-weight: 600; line-height: 31px; transition: transform 160ms ease, background-color 160ms ease; }
.topbar-login::after, .contact-link::after, .project-link::after { border: 0; }
.topbar-login-hover { transform: scale(.96); background: #fffaf3; }
.company-swiper { width: 100%; height: 100vh; }
.company-slide { position: relative; width: 100%; height: 100%; display: flex; align-items: center; overflow: hidden; padding: calc(112px + env(safe-area-inset-top)) 42rpx calc(70rpx + env(safe-area-inset-bottom)); }
.slide-content { position: relative; z-index: 3; width: 100%; max-width: 666rpx; margin: 0 auto; }
.hero-slide { padding-top: calc(104px + env(safe-area-inset-top)); background: linear-gradient(150deg, #faf3e8, #e2c48f); }
.hero-slide::after { content: ""; position: absolute; z-index: 1; inset: 0; background: linear-gradient(180deg, rgba(255,250,243,.03) 0%, rgba(255,250,243,0) 42%, rgba(205,163,95,.16) 100%); pointer-events: none; }
.about-slide { background: linear-gradient(160deg, #fbf7f0, #f3e8d8); }
.focus-slide { background: linear-gradient(155deg, #f7f0e6, #ead9bd); }
.partners-slide { background: linear-gradient(150deg, #f2e6d2, #e3cba3); }
.belief-slide { background: linear-gradient(150deg, #f7f0e5, #ead4b2); }
.contact-slide { background: linear-gradient(150deg, #faf5ed, #ead7b7); }
.projects-slide { background: linear-gradient(150deg, #f8f1e7, #e5cea8); }
.hero-background { position: absolute; z-index: 0; inset: 0; width: 100%; height: 100%; }
.is-active .hero-background { animation: hero-background-in 1200ms cubic-bezier(.22,1,.36,1) both; }
.hero-copy { position: relative; z-index: 3; width: 100%; max-width: 680rpx; margin: 0 auto; transform: translateY(-24rpx); text-align: center; }
.section-label { display: block; color: #8c6632; font-size: 22rpx; font-weight: 600; letter-spacing: 5rpx; line-height: 1.4; }
.title-lines text, .balanced-copy text, .belief-copy text { display: block; }
.hero-title { display: block; color: #4b3620; font-family: "Songti SC", "STSong", serif; font-size: 45rpx; font-weight: 600; letter-spacing: 1rpx; line-height: 1.35; white-space: nowrap; }
.hero-statement { display: block; margin-top: 28rpx; color: #6b4e2b; font-family: "Songti SC", "STSong", serif; font-size: 28rpx; font-weight: 600; line-height: 1.55; white-space: nowrap; }
.hero-lead { max-width: 620rpx; margin: 24rpx auto 0; color: #6d5b46; font-size: 23rpx; line-height: 1.82; }
.section-title { margin-top: 20rpx; color: #3b3025; font-family: "Songti SC", "STSong", serif; font-size: 39rpx; font-weight: 600; line-height: 1.58; }
.section-body { margin-top: 32rpx; color: #6c5f50; font-size: 25rpx; line-height: 1.9; }
.value-flow { position: relative; margin-top: 42rpx; padding-left: 36rpx; border-left: 1rpx solid #c3a979; }
.value-row { position: relative; padding: 0 0 36rpx 24rpx; }
.value-row:last-child { padding-bottom: 0; }
.value-row::before { content: ""; position: absolute; top: 10rpx; left: -43rpx; width: 13rpx; height: 13rpx; background: #a98243; border: 7rpx solid #f0e2cc; border-radius: 50%; }
.value-index, .value-name, .value-copy { display: block; }
.value-index { color: #9b753d; font-size: 20rpx; font-weight: 600; }
.value-name { margin-top: 5rpx; color: #594126; font-family: "Songti SC", "STSong", serif; font-size: 33rpx; font-weight: 600; }
.value-copy { margin-top: 10rpx; color: #6e604e; font-size: 23rpx; line-height: 1.68; }
.service-lead { margin-top: 27rpx; color: #6d5b45; font-size: 25rpx; line-height: 1.82; }
.service-list { margin-top: 38rpx; border-top: 1rpx solid rgba(119,83,40,.25); }
.service-item { display: grid; grid-template-columns: 140rpx minmax(0,1fr); gap: 16rpx; padding: 25rpx 0; border-bottom: 1rpx solid rgba(119,83,40,.2); }
.service-item text:first-child { color: #765328; font-size: 26rpx; font-weight: 600; }
.service-item text:last-child { color: #665541; font-size: 23rpx; line-height: 1.65; }
.belief-content { padding-left: 4rpx; }
.belief-mark { position: absolute; z-index: -1; top: -92rpx; left: -18rpx; color: rgba(125,87,41,.12); font-family: Georgia, serif; font-size: 170rpx; line-height: 1; }
.belief-copy { margin-top: 25rpx; color: #553e25; font-family: "Songti SC", "STSong", serif; font-size: 38rpx; font-weight: 600; line-height: 1.78; }
.vision-block { margin-top: 50rpx; padding-top: 36rpx; border-top: 1rpx solid rgba(126,91,45,.25); }
.vision-label { display: block; color: #92703e; font-size: 21rpx; font-weight: 600; letter-spacing: 4rpx; }
.vision-title { margin-top: 17rpx; color: #533d27; font-family: "Songti SC", "STSong", serif; font-size: 35rpx; font-weight: 600; line-height: 1.58; }
.vision-copy { margin-top: 18rpx; color: #756654; font-size: 23rpx; line-height: 1.72; }
.contact-copy { display: block; margin-top: 25rpx; color: #756654; font-size: 24rpx; line-height: 1.8; }
.contact-list, .project-list { margin-top: 40rpx; border-top: 1rpx solid #cdb890; }
.contact-link, .project-link { width: 100% !important; max-width: 100%; min-width: 0; display: flex; align-items: center; justify-content: space-between; gap: 20rpx; margin: 0; padding: 22rpx 2rpx; color: #5c4328; background: transparent; border-bottom: 1rpx solid #d2bd96; border-radius: 0; line-height: 1.4; text-align: left; transition: padding 180ms ease, background-color 180ms ease; }
.contact-link { min-height: 108rpx; }
.contact-link view { display: flex; align-items: baseline; gap: 14rpx; }
.contact-link view text:first-child { font-size: 28rpx; font-weight: 600; }
.contact-link view text:last-child { color: #8b765d; font-size: 21rpx; }
.contact-number { flex: none; color: #765328; font-size: 27rpx; font-weight: 600; letter-spacing: 1rpx; }
.contact-link-hover, .project-link-hover { padding-right: 10rpx; background: rgba(255,250,243,.45); }
.project-list { margin-top: 34rpx; }
.project-link { min-height: 104rpx; }
.project-link view { min-width: 0; }
.project-link view text { display: block; }
.project-link view text:first-child { color: #5c4328; font-size: 27rpx; font-weight: 600; }
.project-link view text:last-child { margin-top: 5rpx; color: #806e59; font-size: 21rpx; }
.project-link > text { flex: none; font-size: 27rpx; transition: transform 180ms ease; }
.project-link-hover > text { transform: translate(4rpx,-4rpx); }
.slide-brand { margin-top: 38rpx; text-align: center; }
.slide-brand text { display: block; color: #86663d; }
.slide-brand text:first-child { font-family: "Songti SC", "STSong", serif; font-size: 28rpx; font-weight: 600; letter-spacing: 7rpx; }
.slide-brand text:last-child { margin-top: 8rpx; color: #89765e; font-size: 19rpx; }
.slide-footer { position: fixed; z-index: 18; right: 34rpx; bottom: calc(25rpx + env(safe-area-inset-bottom)); left: 34rpx; display: flex; align-items: center; justify-content: space-between; color: rgba(103,75,40,.62); font-size: 19rpx; pointer-events: none; }
.slide-number { font-variant-numeric: tabular-nums; letter-spacing: 1rpx; }
.swipe-guide { animation: swipe-hint 1700ms ease-in-out infinite; }
.slide-animate { opacity: 0; transform: translateY(30rpx); }
.is-active .slide-animate { animation: text-rise 720ms cubic-bezier(.22,1,.36,1) both; }
.is-active .delay-1 { animation-delay: 80ms; }
.is-active .delay-2 { animation-delay: 180ms; }
.is-active .delay-3 { animation-delay: 300ms; }
.is-active .delay-4 { animation-delay: 420ms; }
.is-active .delay-5 { animation-delay: 540ms; }
@keyframes text-rise { from { opacity: 0; transform: translateY(30rpx); } to { opacity: 1; transform: none; } }
@keyframes hero-background-in { from { opacity: .72; transform: scale(1.025); } to { opacity: 1; transform: none; } }
@keyframes swipe-hint { 0%,100% { transform: translateY(0); opacity: .5; } 50% { transform: translateY(-8rpx); opacity: 1; } }
@media (max-height: 720px) {
  .company-slide { padding-top: calc(94px + env(safe-area-inset-top)); padding-bottom: calc(42rpx + env(safe-area-inset-bottom)); }
  .section-title { margin-top: 14rpx; font-size: 35rpx; line-height: 1.48; }
  .section-body { margin-top: 20rpx; font-size: 23rpx; line-height: 1.68; }
  .value-flow { margin-top: 25rpx; }
  .value-row { padding-bottom: 22rpx; }
  .value-name { font-size: 29rpx; }
  .value-copy { margin-top: 5rpx; font-size: 21rpx; line-height: 1.5; }
  .service-lead { margin-top: 18rpx; font-size: 22rpx; line-height: 1.62; }
  .service-list { margin-top: 22rpx; }
  .service-item { padding: 18rpx 0; }
  .belief-copy { font-size: 33rpx; line-height: 1.58; }
  .vision-block { margin-top: 30rpx; padding-top: 24rpx; }
  .vision-title { font-size: 31rpx; }
  .vision-copy { margin-top: 12rpx; font-size: 21rpx; }
  .contact-list, .project-list { margin-top: 24rpx; }
  .contact-link, .project-link { min-height: 86rpx; padding: 14rpx 2rpx; }
  .slide-brand { margin-top: 20rpx; }
}
@media (min-width: 700px) {
  .company-topbar { height: calc(88px + env(safe-area-inset-top)); padding: 0 28px 10px; }
  .topbar-brand { font-size: 15px; letter-spacing: 4px; }
  .topbar-login { width: 58px !important; height: 32px; min-height: 32px; border-width: 1px; border-radius: 16px; font-size: 14px; line-height: 31px; }
  .company-slide { padding: calc(112px + env(safe-area-inset-top)) 50px calc(62px + env(safe-area-inset-bottom)); }
  .slide-content { max-width: 800px; }
  .hero-copy { max-width: 850px; margin-top: 26px; }
  .section-label { font-size: 13px; letter-spacing: 3px; }
  .hero-title { font-size: 38px; letter-spacing: 1px; }
  .hero-statement { margin-top: 20px; font-size: 21px; }
  .hero-lead { max-width: 720px; margin-top: 18px; font-size: 15px; }
  .balanced-copy text { display: inline; }
  .section-title { margin-top: 12px; font-size: 29px; }
  .section-body { max-width: 760px; margin-top: 20px; font-size: 16px; }
  .value-flow { margin-top: 34px; padding-left: 28px; }
  .value-row { display: grid; grid-template-columns: 40px 120px minmax(0,1fr); gap: 16px; align-items: start; padding: 0 0 30px 20px; }
  .value-row::before { top: 7px; left: -34px; width: 9px; height: 9px; border-width: 5px; }
  .value-index { font-size: 12px; }
  .value-name { margin-top: 0; font-size: 21px; }
  .value-copy { margin-top: 0; font-size: 15px; }
  .service-lead { max-width: 720px; margin-top: 18px; font-size: 16px; }
  .service-list { margin-top: 30px; }
  .service-item { grid-template-columns: 110px minmax(0,1fr); gap: 15px; padding: 19px 0; }
  .service-item text:first-child { font-size: 16px; }
  .service-item text:last-child { font-size: 14px; }
  .belief-content { max-width: 760px; }
  .belief-copy { margin-top: 18px; font-size: 30px; }
  .vision-block { margin-top: 38px; padding-top: 28px; }
  .vision-label { font-size: 13px; }
  .vision-title { margin-top: 10px; font-size: 27px; }
  .vision-copy { margin-top: 12px; font-size: 15px; }
  .contact-copy { margin-top: 16px; font-size: 15px; }
  .contact-list, .project-list { margin-top: 28px; }
  .contact-link, .project-link { min-height: 66px; padding: 13px 2px; border-bottom-width: 1px; }
  .contact-link view { gap: 10px; }
  .contact-link view text:first-child, .project-link view text:first-child { font-size: 18px; }
  .contact-link view text:last-child, .project-link view text:last-child { font-size: 13px; }
  .contact-number { font-size: 17px; }
  .project-link > text { font-size: 18px; }
  .slide-brand { margin-top: 28px; }
  .slide-brand text:first-child { font-size: 20px; }
  .slide-brand text:last-child { font-size: 12px; }
  .slide-footer { right: 28px; bottom: calc(20px + env(safe-area-inset-bottom)); left: 28px; font-size: 12px; }
}
@media (prefers-reduced-motion: reduce) {
  .hero-background, .swipe-guide, .is-active .slide-animate { animation: none; }
  .slide-animate { opacity: 1; transform: none; }
  .reading-progress view { transition: none; }
}
