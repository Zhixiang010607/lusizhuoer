.hero-slide::after { content: ""; position: absolute; z-index: 1; inset: 0; background: linear-gradient(180deg, rgba(255,250,243,.03) 0%, rgba(255,250,243,0) 42%, rgba(205,163,95,.16) 100%); pointer-events: none; }
