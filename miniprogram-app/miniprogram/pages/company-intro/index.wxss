@keyframes text-rise { from { opacity: 0; transform: translateY(30rpx); } to { opacity: 1; transform: none; } }
@keyframes hero-background-in { from { opacity: .72; transform: scale(1.025); } to { opacity: 1; transform: none; } }
@keyframes slide-art-in { from { opacity: .12; transform: scale(1.018); } to { opacity: .34; transform: none; } }
@keyframes logo-float { from { transform: translate3d(-50%,-8rpx,0) scale(.96); opacity: .36; } to { transform: translate3d(-50%,10rpx,0) scale(1.04); opacity: .82; } }
