.content-slide::after { content: ""; position: absolute; z-index: 1; bottom: 7%; left: -160rpx; width: 460rpx; height: 460rpx; background: radial-gradient(circle, rgba(217,177,108,.2) 0%, rgba(217,177,108,.07) 42%, rgba(217,177,108,0) 70%); border: 1rpx solid rgba(179,135,70,.16); border-radius: 50%; box-shadow: 0 0 0 68rpx rgba(179,135,70,.06), 0 0 0 148rpx rgba(179,135,70,.035); pointer-events: none; }
