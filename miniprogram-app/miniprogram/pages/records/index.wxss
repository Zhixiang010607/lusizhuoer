.filter-card .query-modes { margin-bottom: 20rpx; }
.two-fields { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12rpx; }
.summary-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 8rpx; margin-bottom: 14rpx; }
.summary-grid view { min-width: 0; padding: 16rpx 8rpx; text-align: center; background: #fff; border: 1rpx solid #dfcfb4; border-radius: 16rpx; }
.summary-grid text { display: block; }
.summary-grid text { color: #7c7062; font-size: 20rpx; }
.summary-grid .summary-value { margin-top: 6rpx; color: #302a22; font-size: 30rpx; font-weight: 800; }
.record-scroll { width: 100%; overflow: hidden; border: 1rpx solid #dfcfb4; border-radius: 14rpx; }
.record-table { width: 1900rpx; min-width: 1900rpx; background: #fff; }
.verification-table { width: 2120rpx; min-width: 2120rpx; }
.record-row { min-height: 78rpx; display: grid; grid-template-columns: 250rpx 210rpx 190rpx 260rpx 220rpx 180rpx 120rpx 170rpx 260rpx; align-items: center; border-top: 1rpx solid #dfcfb4; }
.verification-table .record-row { grid-template-columns: 250rpx 210rpx 190rpx 260rpx 220rpx 180rpx 210rpx 120rpx 170rpx 260rpx; }
.record-row text { min-width: 0; padding: 14rpx 16rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.record-head { min-height: 68rpx; color: #675b4b; background: #f5ead8; font-size: 22rpx; font-weight: 800; }
.table-link { color: #8b642e; font-weight: 800; }
.pager { margin-top: 18rpx; }
.page-jump { display: flex; align-items: center; justify-content: center; gap: 10rpx; margin-top: 14rpx; }
.page-jump input { width: 120rpx; min-height: 70rpx; padding: 0 16rpx; text-align: center; background: #fff; border: 1rpx solid #d8c5a3; border-radius: 12rpx; }
.page-jump button { width: 150rpx; min-height: 70rpx; margin: 0; font-size: 23rpx; }
