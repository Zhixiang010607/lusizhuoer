.recovery-card { border-color: #efc1bd; }
.disabled-card { opacity: .68; }
.impact { margin: -4rpx 0 22rpx; padding: 18rpx; color: #625747; background: #f5ead8; border-left: 6rpx solid #a98243; border-radius: 12rpx; line-height: 1.5; }
.verify-button { margin-top: 18rpx; }
.submit-card { position: sticky; bottom: calc(16rpx + env(safe-area-inset-bottom)); z-index: 3; }

@media (min-width: 700px) {
  .workflow-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); align-items: start; gap: 16px; }
  .workflow-grid > .card { height: 100%; margin: 0; }
  .workflow-grid .workflow-wide { grid-column: 1 / -1; height: auto; }
  .impact { margin: -2px 0 16px; padding: 13px 14px; border-left-width: 4px; border-radius: 10px; font-size: 14px; }
  .verify-button { width: min(420px, 100%); margin: 14px auto 0; }
  .submit-card { position: static; }
  .submit-card .primary { width: min(420px, 100%); margin: 0 auto; }
}
