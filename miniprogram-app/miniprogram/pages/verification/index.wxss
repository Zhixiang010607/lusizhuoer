.recovery-card { border-color: #efc1bd; }
.disabled-card { opacity: .68; }
.impact { margin: -4rpx 0 22rpx; padding: 18rpx; color: #625747; background: #f5ead8; border-left: 6rpx solid #a98243; border-radius: 12rpx; line-height: 1.5; }
.verify-button { margin-top: 18rpx; }
.submit-card { position: sticky; bottom: calc(16rpx + env(safe-area-inset-bottom)); z-index: 3; }
.locked-summary, .face-locked { display: flex; flex-direction: column; gap: 8rpx; padding: 22rpx; border: 1px solid #dfc79f; border-radius: 18rpx; background: #fbf5ea; color: #70614d; }
.locked-summary-title { color: #2f2a23; font-weight: 700; }
.face-locked { flex-direction: row; justify-content: space-between; align-items: center; color: #276b57; }
.ble-mask { position: fixed; inset: 0; z-index: 90; display: flex; align-items: flex-end; justify-content: center; padding: 24rpx; padding-bottom: calc(24rpx + env(safe-area-inset-bottom)); background: rgba(34, 29, 23, .58); box-sizing: border-box; }
.ble-dialog { width: 100%; max-height: 86vh; overflow-y: auto; padding: 30rpx; border: 1px solid #d7b77f; border-radius: 34rpx; background: #fffaf2; box-sizing: border-box; box-shadow: 0 20rpx 60rpx rgba(32, 24, 14, .28); }
.ble-dialog-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 24rpx; }
.ble-dialog-head > view { display: flex; flex-direction: column; gap: 8rpx; min-width: 0; }
.ble-dialog-title { font-size: 36rpx; line-height: 1.25; color: #2f2922; font-weight: 800; }
.ble-countdown { color: #8a672e; font-size: 26rpx; font-weight: 700; }
.ble-close { flex: 0 0 auto; min-width: 120rpx; height: 70rpx; line-height: 70rpx; padding: 0 24rpx; margin: 0; border: 1px solid #d7b77f; border-radius: 18rpx; background: #fff; color: #76582d; font-size: 26rpx; }
.ble-close::after { border: 0; }
.ble-context { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12rpx; margin: 28rpx 0 20rpx; }
.ble-context > view { display: flex; flex-direction: column; gap: 8rpx; min-width: 0; padding: 18rpx 14rpx; border-radius: 16rpx; background: #f5ead8; text-align: center; }
.ble-context text { color: #81735f; font-size: 23rpx; }
.ble-context-value { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: #3b3127 !important; font-size: 27rpx !important; font-weight: 700; }
.ble-state { display: flex; flex-direction: column; gap: 10rpx; min-height: 150rpx; justify-content: center; padding: 24rpx; border: 1px solid #d9c7aa; border-radius: 18rpx; background: #fff; color: #5f5446; line-height: 1.5; }
.ble-state.has-error { border-color: #e4aaa3; background: #fff1ef; color: #8f342a; }
.ble-state-title { color: #332d26; font-size: 30rpx; font-weight: 800; }
.ble-code { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 23rpx; word-break: break-all; }
.ble-advice { font-weight: 600; }
.ble-start { margin-top: 22rpx; }
.ble-window-note { display: block; margin-top: 16rpx; color: #827461; font-size: 23rpx; line-height: 1.5; text-align: center; }

@media (min-width: 700px) {
  .workflow-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); align-items: start; gap: 16px; }
  .workflow-grid > .card { height: 100%; margin: 0; }
  .workflow-grid .workflow-wide { grid-column: 1 / -1; height: auto; }
  .impact { margin: -2px 0 16px; padding: 13px 14px; border-left-width: 4px; border-radius: 10px; font-size: 14px; }
  .verify-button { width: min(420px, 100%); margin: 14px auto 0; }
  .submit-card { position: static; }
  .submit-card .primary { width: min(420px, 100%); margin: 0 auto; }
  .ble-mask { align-items: center; padding: 28px; }
  .ble-dialog { width: min(680px, 100%); padding: 28px; border-radius: 24px; }
  .ble-dialog-title { font-size: 24px; }
  .ble-countdown, .ble-dialog, .ble-close { font-size: 15px; }
  .ble-close { height: 42px; line-height: 42px; min-width: 76px; padding: 0 16px; border-radius: 12px; }
  .ble-context { gap: 10px; margin: 22px 0 16px; }
  .ble-context > view { padding: 13px 10px; border-radius: 12px; }
  .ble-context text, .ble-code, .ble-window-note { font-size: 13px; }
  .ble-context-value { font-size: 16px !important; }
  .ble-state { min-height: 112px; padding: 18px; border-radius: 14px; }
  .ble-state-title { font-size: 18px; }
}
