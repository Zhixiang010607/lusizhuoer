<view class="page">
  <view class="page-heading">
    <text class="eyebrow">{{experience ? '老师赠送体验' : '正常核销'}}</text>
    <text class="title">{{experience ? '体验核销' : '客户项目核销'}}</text>
    <text class="subtitle">{{store.id ? store.name + ' · 只扫客户的脸，不扫老师的脸。' : '进入业务页后先选择本次核销的发生门店。'}}</text>
  </view>

  <view wx:if="{{locked}}" class="card recovery-card">
    <view class="card-title"><text>上次核销结果待确认</text><text class="badge">禁止再扣</text></view>
    <text class="section-note">{{message}}</text>
    <button class="primary" bindtap="recoverPending" loading="{{recovering}}" disabled="{{recovering}}">检查上次核销结果</button>
  </view>

  <block wx:else>
    <view class="workflow-grid">
    <view class="card customer-step-card">
      <view class="card-title"><text>第一步：确认客户</text><text class="badge">本门店活跃客户</text></view>
      <label wx:if="{{session.role === 'teacher'}}" class="field">
        <text class="field-label">办理门店</text>
        <picker range="{{storeLabels}}" value="{{storeIndex}}" bindchange="selectStore" disabled="{{busy || qualificationActive || loadingStores || !stores.length}}">
          <view class="picker">{{loadingStores ? '正在读取可办理门店…' : (store.id ? store.name + ' · ' + (store.code || store.id) : (stores.length ? '请选择门店' : '暂无可办理门店'))}}</view>
        </picker>
      </label>
      <button wx:if="{{session.role === 'teacher' && !loadingStores && !stores.length}}" class="secondary" bindtap="loadTeacherStores">重试门店列表</button>
      <customer-picker wx:if="{{store.id && !qualificationActive}}" store-id="{{store.id}}" bindconfirm="customerConfirmed" bindchange="customerChanged"></customer-picker>
      <view wx:elif="{{qualificationActive && customer}}" class="locked-summary">
        <text class="locked-summary-title">{{customer.customerName}}</text>
        <text>客户已锁定；完成或结束本次 90 秒设备流程前不可更换。</text>
      </view>
      <text wx:else class="section-note">选择办理门店后即可确认客户</text>
    </view>

    <view class="card info-step-card {{customer ? '' : 'disabled-card'}}">
      <view class="card-title"><text>第二步：选择项目信息</text><text class="badge">{{experience ? '扣老师体验次数' : '扣客户剩余次数'}}</text></view>
      <label class="field">
        <text class="field-label">项目</text>
        <picker range="{{productLabels}}" value="{{productIndex}}" bindchange="selectProduct" disabled="{{qualificationActive || !customer || loadingOptions || !products.length}}">
          <view class="picker">{{loadingOptions ? '正在读取可核销项目…' : (selectedProduct ? productLabels[productIndex] : (products.length ? '请选择项目' : '暂无可核销项目'))}}</view>
        </picker>
      </label>
      <label class="field">
        <text class="field-label">{{experience ? '体验次数' : '核销次数'}}（必填）</text>
        <input class="input" type="number" inputmode="numeric" maxlength="3" value="{{unitCount}}" bindinput="inputUnitCount" disabled="{{qualificationActive || !selectedProduct}}" placeholder="{{selectedProduct ? '请输入 1 至 ' + unitCountMax + ' 次' : '请先选择项目'}}" />
      </label>
      <label class="field">
        <text class="field-label">业务老师{{session.role === 'teacher' ? '（自动绑定）' : '（可选）'}}</text>
        <picker range="{{teacherLabels}}" value="{{teacherIndex}}" bindchange="selectTeacher" disabled="{{qualificationActive || !customer || session.role === 'teacher' || !teacherOptionsReady}}">
          <view class="picker">{{selectedTeacher ? selectedTeacher.teacherName + (selectedTeacher.teacherCode ? ' · ' + selectedTeacher.teacherCode : '') : '正在读取老师选项…'}}</view>
        </picker>
      </label>
      <view wx:if="{{selectedProduct}}" class="impact">{{experience ? '当前老师可用 ' + selectedProduct.availableCount + ' 次' : '当前客户剩余 ' + selectedProduct.remainingCount + ' 次'}}；请自行填写本次{{experience ? '体验' : '核销'}}次数。</view>
      <label class="field"><text class="field-label">{{experience ? '老师留言' : '门店留言'}}（可选）</text><textarea class="textarea" maxlength="500" value="{{note}}" bindinput="inputNote" disabled="{{qualificationActive || !customer}}" placeholder="{{customer ? '留在本次核销单中' : '请先确认客户'}}" /></label>
    </view>

    <view class="card workflow-wide {{selectedProduct && teacherReady && unitCountValid ? '' : 'disabled-card'}}">
      <view class="card-title"><text>第三步：客户 1:1 人脸验证</text><text class="badge">{{faceVerified ? '已通过' : '待验证'}}</text></view>
      <camera-capture wx:if="{{customer && selectedProduct && teacherReady && unitCountValid && !qualificationActive}}" id="verificationCamera" title="拍照并验证客户" bindchange="captureChanged"></camera-capture>
      <view wx:elif="{{qualificationActive && faceVerified}}" class="face-locked"><text>客户人脸验证已通过</text><text>资格剩余 {{qualificationSeconds}} 秒</text></view>
      <text wx:else class="section-note">完成门店、客户、项目和次数选择后即可拍照验证；门店可不指定业务老师</text>
      <button wx:if="{{!qualificationActive}}" class="secondary verify-button" bindtap="verifyFace" loading="{{verifying}}" disabled="{{verifying || !captureReady || !customer || !selectedProduct || !teacherReady || !unitCountValid}}">用该照片验证客户</button>
      <view wx:if="{{faceMessage}}" class="message {{faceVerified ? 'success' : (faceError ? 'error' : '')}}">{{faceMessage}}</view>
    </view>

    <view class="card submit-card workflow-wide">
      <view class="card-title"><text>第四步：扫码并连接设备</text><text class="badge">{{qualificationActive ? qualificationSeconds + ' 秒' : '尚未授权'}}</text></view>
      <view class="section-note">人脸通过后建立一次 90 秒设备资格。设备进入工作状态前不会扣次；成功后二维码窗口永久关闭并自动打开核销工单。</view>
      <button wx:if="{{!qualificationActive}}" class="primary" bindtap="submit" loading="{{busy}}" disabled="{{busy || !ready}}">建立 90 秒设备核销资格</button>
      <button wx:else class="primary" bindtap="openBleWindow" disabled="{{blePermanentlyClosed || qualificationSeconds <= 0}}">打开设备二维码窗口（{{qualificationSeconds}} 秒）</button>
    </view>
    </view>
  </block>
  <view wx:if="{{message && !locked}}" class="message {{error ? 'error' : 'success'}}">{{message}}</view>

  <view wx:if="{{bleWindowVisible}}" class="ble-mask" catchtouchmove="preventTouchMove">
    <view class="ble-dialog">
      <view class="ble-dialog-head">
        <view>
          <text class="ble-dialog-title">设备扫码与蓝牙连接</text>
          <text class="ble-countdown">资格剩余 {{qualificationSeconds}} 秒</text>
        </view>
        <button wx:if="{{!blePermanentlyClosed}}" class="ble-close" bindtap="closeBleWindow" disabled="{{bleRunning}}">关闭</button>
      </view>
      <view class="ble-context">
        <view><text>项目</text><text class="ble-context-value">{{selectedProduct.productName}}</text></view>
        <view><text>设备类型</text><text class="ble-context-value">{{qualification.expectedDeviceType}}</text></view>
        <view><text>本次次数</text><text class="ble-context-value">{{unitCount}} 次</text></view>
      </view>
      <view class="ble-state {{bleErrorCode ? 'has-error' : ''}}">
        <text class="ble-state-title">{{bleErrorTitle || (bleRunning ? '正在办理' : '准备就绪')}}</text>
        <text>{{bleStatusMessage}}</text>
        <text wx:if="{{bleErrorCode}}" class="ble-code">错误代码：{{bleErrorCode}}</text>
        <text wx:if="{{bleErrorAdvice}}" class="ble-advice">{{bleErrorAdvice}}</text>
      </view>
      <button class="primary ble-start" bindtap="startBleVerification" loading="{{bleRunning}}" disabled="{{bleRunning || blePermanentlyClosed || qualificationSeconds <= 0}}">{{bleRunning ? '正在连接设备…' : (bleAuthorizationSent ? '重新连接并核对原设备' : '扫描设备二维码并开启蓝牙')}}</button>
      <text class="ble-window-note">关闭此窗口不会取消资格。90 秒内可再次打开；设备进入工作状态后不可再次打开。</text>
    </view>
  </view>
  <view class="safe-bottom"></view>
</view>
