<view class="page tracking-page">
  <view class="page-heading"><view><text class="title">打卡追踪</text><text class="subtitle">总部按日期查看在职老师的上班、下班时间和工作时长</text></view><button class="back" bindtap="back"><text class="button-label">返回工作台</text></button></view>
  <view wx:if="{{!authorized}}" class="notice-card">正在确认总部账号…</view>
  <view wx:else class="tracking-layout">
    <view class="calendar-card date-query-card"><date-selector value="{{pendingDate}}" end="{{serverToday}}" disabled="{{loading}}" bindchange="chooseDate"></date-selector><button class="confirm-button" bindtap="confirmDate" disabled="{{loading}}"><text class="button-label">确认</text></button></view>
    <view class="results">
      <view class="result-summary"><view><text class="section-title">{{selectedDate}}</text><text class="section-note">在职老师考勤</text></view><view class="summary-counts"><text>完整打卡 {{completed.length}}</text><text>仅上班打卡 {{clockInOnly.length}}</text><text>仅下班打卡 {{clockOutOnly.length}}</text><text>未打卡 {{missing.length}}</text></view></view>
      <view wx:if="{{loading}}" class="notice-card">正在读取上下班打卡情况…</view>
      <view wx:else class="result-columns">
        <view wx:for="{{statusGroups}}" wx:for-item="group" wx:key="key" class="list-card status-list status-{{group.key}}">
          <view class="list-heading"><text>{{group.title}}</text><text>{{group.items.length}} 人</text></view>
          <view wx:if="{{!group.items.length}}" class="empty">{{group.empty}}</view>
          <scroll-view wx:else class="tracking-table-scroll" scroll-x="true" data-visible-rows="{{group.items.length > 5 ? 5 : group.items.length}}" scroll-y="{{group.items.length > 5}}" enhanced="true" show-scrollbar="{{group.items.length > 5}}">
            <view class="tracking-table">
              <view class="tracking-row tracking-head"><text>老师姓名</text><text>老师电话</text><text>上班时间（北京）</text><text>上班详情</text><text>下班时间（北京）</text><text>下班详情</text><text>工作时长</text></view>
              <view wx:for="{{group.items}}" wx:for-item="person" wx:key="teacherId" class="tracking-row"><text class="link" data-id="{{person.teacherId}}" bindtap="openTeacher">{{person.teacherName}}</text><text>{{person.phone}}</text><text>{{person.clockInTime}}</text><text wx:if="{{person.clockIn}}" class="link" data-id="{{person.teacherId}}" data-kind="clockIn" bindtap="openDetail">查看详情</text><text wx:else>—</text><text>{{person.clockOutTime}}</text><text wx:if="{{person.clockOut}}" class="link" data-id="{{person.teacherId}}" data-kind="clockOut" bindtap="openDetail">查看详情</text><text wx:else>—</text><text>{{person.workDurationText}}</text></view>
            </view>
          </scroll-view>
        </view>
      </view>
      <view wx:if="{{message && !loading}}" class="form-message {{error ? 'error' : ''}}">{{message}}</view>
    </view>
  </view>
</view>

<view wx:if="{{detailOpen}}" class="modal-backdrop" catchtap="closeDetail"><view class="detail-dialog" catchtap="noop"><view class="detail-heading"><view><text class="section-title">{{detail.attendance.punchLabel}}详情</text><text class="section-note">{{detail.teacherName}} · {{detail.phone}}</text></view><button bindtap="closeDetail"><text class="button-label">关闭</text></button></view><view class="detail-meta"><view><text>老师姓名</text><text>{{detail.teacherName}}</text></view><view><text>老师电话</text><text>{{detail.phone}}</text></view><view><text>打卡类型</text><text>{{detail.attendance.punchLabel}}</text></view><view><text>打卡时间（北京时间）</text><text>{{detail.attendance.checkedTime}}</text></view><view wx:if="{{detail.attendance.placeName}}"><text>附近地点</text><text>{{detail.attendance.placeName}}</text></view><view wx:if="{{detail.attendance.formattedAddress}}" class="address-meta"><text>具体地址</text><text>{{detail.attendance.formattedAddress}}</text></view><view><text>经纬度</text><text>{{detail.attendance.coordinateText}}</text></view><view><text>定位精度</text><text>约 {{detail.attendance.accuracy}} 米</text></view></view><map class="tracking-map" latitude="{{detail.attendance.latitude}}" longitude="{{detail.attendance.longitude}}" markers="{{detail.attendance.markers}}" scale="17" show-location></map><button class="map-button" bindtap="openLocation"><text class="button-label">在地图中打开</text></button></view></view>
