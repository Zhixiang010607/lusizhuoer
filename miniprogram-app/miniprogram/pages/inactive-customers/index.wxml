<view class="page">
  <view class="page-heading"><text class="eyebrow">INACTIVE VERIFICATION QUERY</text><text class="title">活跃预警</text><text class="subtitle">按距离上次核销或建档的天数筛选客户</text></view>

  <view class="card search-card">
    <view class="card-title"><text>查询条件</text><text class="badge">{{session.role === 'hq' ? '总部范围' : '本门店范围'}}</text></view>
    <view class="query-grid">
      <label wx:if="{{session.role === 'hq'}}" class="field"><text class="field-label">门店范围</text><picker range="{{storeLabels}}" value="{{storeIndex}}" bindchange="chooseStore" disabled="{{loading || exporting}}"><view class="picker">{{storeLabels[storeIndex]}}</view></picker></label>
      <label class="field {{session.role === 'store' ? 'query-wide' : ''}}"><text class="field-label">核销间隔至少多少天</text><input class="input" type="number" maxlength="4" placeholder="例如：30" value="{{minimumDays}}" bindinput="inputMinimumDays" disabled="{{loading || exporting}}" /></label>
    </view>
    <text class="query-note">有正常核销时取最新正常核销；没有正常核销才取最新体验核销；两类都没有时取客户建档时间。只查询未封存客户。</text>
    <view class="button-row"><button class="primary" bindtap="search" loading="{{loading}}" disabled="{{loading || exporting}}">查询活跃预警</button><button class="ghost" bindtap="resetSearch" disabled="{{loading || exporting}}">重置查询</button></view>
  </view>

  <view wx:if="{{searched}}" class="summary-grid">
    <view><text>匹配客户</text><text class="summary-value">{{summary.selectedTotal || 0}}</text></view>
    <view><text>全部项目为 0</text><text class="summary-value">{{summary.zeroBalanceCustomers || 0}}</text></view>
    <view><text>任意项目非 0</text><text class="summary-value">{{summary.nonzeroBalanceCustomers || 0}}</text></view>
  </view>

  <view class="card result-card">
    <view class="card-title"><text>客户结果</text><text class="badge">共 {{total}} 位</text></view>
    <view wx:if="{{searched}}" class="result-export">
      <text>导出当前条件下的全部客户，按门店分组并保留预警分类；PDF、Excel 单次上限均为 10000 位。</text>
      <view class="export-buttons"><button class="secondary" bindtap="exportPdf" loading="{{exporting}}" disabled="{{loading || exporting || total <= 0}}">导出 PDF</button><button class="secondary" bindtap="exportExcel" loading="{{exporting}}" disabled="{{loading || exporting || total <= 0}}">导出 Excel</button></view>
    </view>
    <view wx:if="{{loading && !searched}}" class="empty">正在读取客户…</view>
    <view wx:elif="{{searched}}" class="result-sections">
      <view class="result-section">
        <view class="section-title"><view><text>全部项目为 0</text><text class="section-note">客户所有项目当前余次均为 0</text></view><text class="badge">{{zeroTotal}} 位</text></view>
        <scroll-view wx:if="{{zeroCustomers.length}}" class="inactive-table-scroll" scroll-x="true" data-visible-rows="{{zeroCustomers.length > 5 ? 5 : zeroCustomers.length}}" scroll-y="{{zeroCustomers.length > 5}}" scroll-left="{{zeroTableScrollLeft}}" enhanced="true" show-scrollbar="{{zeroCustomers.length > 5}}">
          <view class="inactive-table">
            <view class="inactive-row inactive-head"><text>客户</text><text>门店</text><text>间隔时间</text><text>计算起点</text><text>上次核销</text></view>
            <view wx:for="{{zeroCustomers}}" wx:key="customerCode" class="inactive-row" data-code="{{item.customerCode}}" bindtap="openCustomer"><text class="customer-name">{{item.customerName}}</text><text>{{item.storeName}}</text><text class="days-since">{{item.daysSince}} 天</text><text>{{item.baselineSourceLabel}}</text><text>{{item.lastVerificationLabel}}</text></view>
          </view>
        </scroll-view>
        <view wx:else class="empty compact-empty">当前条件下没有这类客户</view>
        <view class="pager"><button class="ghost" data-category="ZERO" bindtap="previousPage" disabled="{{zeroPage <= 1 || loading || exporting}}">上一页</button><text>第 {{zeroPage}} / {{zeroTotalPages}} 页</text><button class="ghost" data-category="ZERO" bindtap="nextPage" disabled="{{zeroPage >= zeroTotalPages || loading || exporting}}">下一页</button></view>
        <view class="page-jump"><text>跳至</text><input type="number" value="{{zeroPageJump}}" data-category="ZERO" bindinput="inputPageJump" disabled="{{loading || exporting}}" /><text>页</text><button class="secondary" data-category="ZERO" bindtap="jumpPage" disabled="{{loading || exporting}}">跳转</button></view>
      </view>

      <view class="result-section">
        <view class="section-title"><view><text>任意项目非 0</text><text class="section-note">客户至少一个项目当前余次不为 0</text></view><text class="badge">{{nonzeroTotal}} 位</text></view>
        <scroll-view wx:if="{{nonzeroCustomers.length}}" class="inactive-table-scroll" scroll-x="true" data-visible-rows="{{nonzeroCustomers.length > 5 ? 5 : nonzeroCustomers.length}}" scroll-y="{{nonzeroCustomers.length > 5}}" scroll-left="{{nonzeroTableScrollLeft}}" enhanced="true" show-scrollbar="{{nonzeroCustomers.length > 5}}">
          <view class="inactive-table">
            <view class="inactive-row inactive-head"><text>客户</text><text>门店</text><text>间隔时间</text><text>计算起点</text><text>上次核销</text></view>
            <view wx:for="{{nonzeroCustomers}}" wx:key="customerCode" class="inactive-row" data-code="{{item.customerCode}}" bindtap="openCustomer"><text class="customer-name">{{item.customerName}}</text><text>{{item.storeName}}</text><text class="days-since">{{item.daysSince}} 天</text><text>{{item.baselineSourceLabel}}</text><text>{{item.lastVerificationLabel}}</text></view>
          </view>
        </scroll-view>
        <view wx:else class="empty compact-empty">当前条件下没有这类客户</view>
        <view class="pager"><button class="ghost" data-category="NONZERO" bindtap="previousPage" disabled="{{nonzeroPage <= 1 || loading || exporting}}">上一页</button><text>第 {{nonzeroPage}} / {{nonzeroTotalPages}} 页</text><button class="ghost" data-category="NONZERO" bindtap="nextPage" disabled="{{nonzeroPage >= nonzeroTotalPages || loading || exporting}}">下一页</button></view>
        <view class="page-jump"><text>跳至</text><input type="number" value="{{nonzeroPageJump}}" data-category="NONZERO" bindinput="inputPageJump" disabled="{{loading || exporting}}" /><text>页</text><button class="secondary" data-category="NONZERO" bindtap="jumpPage" disabled="{{loading || exporting}}">跳转</button></view>
      </view>
    </view>
    <view wx:else class="empty">请输入核销间隔天数后查询</view>
  </view>
  <view wx:if="{{message}}" class="message {{error ? 'error' : ''}}">{{message}}</view>
  <view class="safe-bottom"></view>
</view>
