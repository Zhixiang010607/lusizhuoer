<view class="page">
  <view class="page-heading"><text class="eyebrow">INACTIVE VERIFICATION QUERY</text><text class="title">未核销客户</text><text class="subtitle">按正常核销 → 体验核销 → 客户建档的固定优先级计算</text></view>

  <view class="card search-card">
    <view class="card-title"><text>查询条件</text><text class="badge">{{session.role === 'hq' ? '总部范围' : '本门店范围'}}</text></view>
    <view class="query-grid">
      <label wx:if="{{session.role === 'hq'}}" class="field"><text class="field-label">门店范围</text><picker range="{{storeLabels}}" value="{{storeIndex}}" bindchange="chooseStore"><view class="picker">{{storeLabels[storeIndex]}}</view></picker></label>
      <label class="field {{session.role === 'store' ? 'query-wide' : ''}}"><text class="field-label">至少多少天没有核销</text><input class="input" type="number" maxlength="4" placeholder="例如：30" value="{{minimumDays}}" bindinput="inputMinimumDays" /></label>
    </view>
    <text class="query-note">有正常核销时取最新正常核销；没有正常核销才取最新体验核销；两类都没有时取客户建档时间。</text>
    <view class="button-row"><button class="primary" bindtap="search" loading="{{loading}}" disabled="{{loading}}">查询未核销客户</button><button class="ghost" bindtap="resetSearch" disabled="{{loading}}">重置查询</button></view>
  </view>

  <view wx:if="{{searched}}" class="summary-grid">
    <view><text>当前结果</text><text class="summary-value">{{summary.selectedTotal || 0}}</text></view>
    <view><text>正常核销起点</text><text class="summary-value">{{summary.normalBaseline || 0}}</text></view>
    <view><text>体验核销起点</text><text class="summary-value">{{summary.experienceBaseline || 0}}</text></view>
    <view><text>从未核销</text><text class="summary-value">{{summary.neverVerified || 0}}</text></view>
  </view>

  <view class="card result-card">
    <view class="card-title"><text>客户结果</text><text class="badge">共 {{total}} 位</text></view>
    <view wx:if="{{loading}}" class="empty">正在读取客户…</view>
    <scroll-view wx:elif="{{customers.length}}" class="inactive-table-scroll" scroll-x="true" data-visible-rows="{{customers.length > 5 ? 5 : customers.length}}" scroll-y="{{customers.length > 5}}" scroll-left="{{tableScrollLeft}}" enhanced="true" show-scrollbar="{{customers.length > 5}}">
      <view class="inactive-table">
        <view class="inactive-row inactive-head"><text>客户</text><text>门店</text><text>间隔时间</text><text>计算起点</text><text>上次核销</text></view>
        <view wx:for="{{customers}}" wx:key="customerCode" class="inactive-row" data-code="{{item.customerCode}}" bindtap="openCustomer"><text class="customer-name">{{item.customerName}}</text><text>{{item.storeName}}</text><text class="days-since">{{item.daysSince}} 天</text><text>{{item.baselineSourceLabel}}</text><text>{{item.lastVerificationLabel}}</text></view>
      </view>
    </scroll-view>
    <view wx:elif="{{searched}}" class="empty">当前条件下暂无客户</view>
    <view wx:else class="empty">请输入未核销天数后查询</view>
    <view wx:if="{{searched}}" class="pager"><button class="ghost" bindtap="previousPage" disabled="{{page <= 1 || loading}}">上一页</button><text>第 {{page}} / {{totalPages}} 页</text><button class="ghost" bindtap="nextPage" disabled="{{page >= totalPages || loading}}">下一页</button></view>
    <view wx:if="{{searched}}" class="page-jump"><text>跳至</text><input type="number" value="{{pageJump}}" bindinput="inputPageJump" /><text>页</text><button class="secondary" bindtap="jumpPage" disabled="{{loading}}">跳转</button></view>
  </view>
  <view wx:if="{{message}}" class="message {{error ? 'error' : ''}}">{{message}}</view>
  <view class="safe-bottom"></view>
</view>
