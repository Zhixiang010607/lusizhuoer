<view class="page"><button class="back" bindtap="back">‹ {{view === 'members' ? '返回小组运营' : '返回老师工作台'}}</button><text class="title">{{view === 'members' ? '管理名单' : '小组运营'}}</text><text wx:if="{{error}}" class="error">{{error}}</text><text wx:if="{{loading}}" class="notice">正在读取小组资料…</text><block wx:elif="{{!error}}"><block wx:if="{{view === 'operations'}}"><view class="card"><view class="heading"><text>管理名单</text><text class="badge">{{members.total}} 位老师</text></view><button class="entry" bindtap="openMembers"><text>查看成员主页</text><text>›</text></button></view><view class="card"><view class="heading"><text>运营查询</text></view><button class="entry" data-type="team-dashboard" bindtap="openQuery"><text>小组总览</text><text>›</text></button><button class="entry" data-type="attendance-tracking" bindtap="openQuery"><text>打卡追踪</text><text>›</text></button><button class="entry" data-type="daily-report-tracking" bindtap="openQuery"><text>日报追踪</text><text>›</text></button><button class="entry" data-type="inactive-customers" bindtap="openQuery"><text>活跃预警</text><text>›</text></button><button class="entry" data-type="low-balance-customers" bindtap="openQuery"><text>余次预警</text><text>›</text></button><button class="entry" data-type="rating-analysis" bindtap="openQuery"><text>评价分析</text><text>›</text></button></view></block><view wx:else class="card"><view class="search"><input value="{{keyword}}" bindinput="keyword" bindconfirm="search" maxlength="80" placeholder="搜索成员姓名"/><button bindtap="search">搜索</button></view><view wx:for="{{members.records}}" wx:key="teacherId" class="person"><text>{{index + 1}}</text><view><text class="link" data-id="{{item.teacherId}}" bindtap="openTeacher">{{item.teacherName}}</text><text class="phone">{{item.phone}}</text></view><button class="open" data-id="{{item.teacherId}}" bindtap="openTeacher">查看主页</button></view><text wx:if="{{!members.total}}" class="notice">暂无匹配成员</text><view wx:if="{{members.total > 0}}" class="team-pager"><view class="page-controls"><button class="pager-button {{loading || members.page <= 1 ? 'is-disabled' : ''}}" disabled="{{loading || members.page <= 1}}" data-kind="members" data-delta="-1" bindtap="movePage">上一页</button><text class="pager-label">第 {{members.page}} / {{members.totalPages}} 页 · 共 {{members.total}} 条</text><button class="pager-button {{loading || members.page >= members.totalPages ? 'is-disabled' : ''}}" disabled="{{loading || members.page >= members.totalPages}}" data-kind="members" data-delta="1" bindtap="movePage">下一页</button></view><view wx:if="{{members.totalPages > 1}}" class="page-jump"><text class="pager-label">跳至第</text><input class="pager-input" type="number" value="{{membersInput}}" data-kind="members" bindinput="changePageInput" disabled="{{loading}}" aria-label="跳转页码"/><text class="pager-label">页</text><button class="pager-button {{loading ? 'is-disabled' : ''}}" data-kind="members" bindtap="jumpPage" disabled="{{loading}}">跳转</button></view></view></view></block></view>
