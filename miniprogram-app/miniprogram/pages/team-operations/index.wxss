page{background:#f3ede2;color:#302a22}.page{box-sizing:border-box;width:calc(100% - 40rpx);max-width:1120px;margin:auto;padding:28rpx 0 calc(40rpx + env(safe-area-inset-bottom))}.back{width:auto!important;margin:0 0 10rpx;padding:0;height:40rpx;display:flex;align-items:center;justify-content:flex-start;background:none;color:#80602c;font-size:24rpx;line-height:1}.title{display:block;font-size:38rpx;font-weight:700;margin-bottom:28rpx}.card{box-sizing:border-box;min-width:0;border:1rpx solid #dfcfb4;border-radius:24rpx;padding:28rpx;margin-bottom:24rpx;background:#fffaf3}.heading{display:flex;justify-content:space-between;align-items:center;gap:16rpx;margin-bottom:20rpx;font-size:30rpx;font-weight:700}.badge{padding:7rpx 12rpx;background:#f4e7d0;color:#74592d;border-radius:9rpx;font-size:24rpx;white-space:nowrap}button::after{border:0}.entry{box-sizing:border-box;width:100%!important;margin:0;min-width:0;display:flex;align-items:center;justify-content:space-between;padding:26rpx 0;border-radius:0;background:none;border-bottom:1rpx solid #eadfce;color:#74592d;font-size:27rpx;line-height:1.3;text-align:left}.entry:last-child{border-bottom:0;padding-bottom:4rpx}.search{display:grid;grid-template-columns:minmax(0,1fr) 116rpx;gap:14rpx;margin-bottom:16rpx}.search input{box-sizing:border-box;min-width:0;width:100%;height:76rpx;padding:0 18rpx;border:1rpx solid #dfcfb4;border-radius:12rpx;background:white;font-size:25rpx}.search button,.open{box-sizing:border-box;width:auto!important;min-width:0;margin:0;height:76rpx;padding:0 18rpx;display:flex;align-items:center;justify-content:center;border-radius:12rpx;font-size:24rpx;background:#74592d;color:#fff;line-height:1}.person{display:grid;grid-template-columns:30rpx minmax(0,1fr) auto;gap:14rpx;align-items:center;padding:24rpx 0;border-bottom:1rpx solid #eadfce;font-size:24rpx}.link{color:#74592d;font-weight:700;text-decoration:underline;overflow-wrap:anywhere}.phone{display:block;margin-top:7rpx;color:#8b7e6d;font-size:24rpx}.open{height:62rpx;background:#fff;border:1rpx solid #d8c5a3;color:#74592d;font-size:24rpx;white-space:nowrap}.notice,.error{display:block;font-size:24rpx;color:#8b7e6d;line-height:1.7;margin:18rpx 0}.error{color:#a64d40}@media(min-width:700px){.page{width:calc(100% - 48px);padding:24px 0 40px}.back{height:25px;font-size:14px;margin-bottom:8px}.title{font-size:28px;margin-bottom:20px}.card{padding:20px;margin-bottom:18px;border-width:1px;border-radius:18px}.heading{font-size:20px;margin-bottom:15px}.badge{font-size:14px;padding:5px 9px;border-radius:6px}.entry{padding:18px 0;font-size:16px;border-width:1px}.entry:last-child{padding-bottom:4px}.search{grid-template-columns:minmax(0,1fr) 76px;gap:10px}.search input{height:44px;font-size:14px;padding:0 12px;border-width:1px;border-radius:9px}.search button,.open{height:44px;font-size:14px;padding:0 14px;border-radius:9px}.person{grid-template-columns:24px minmax(0,1fr) auto;gap:12px;padding:16px 0;font-size:14px}.phone{font-size:14px;margin-top:5px}.open{height:38px;border-width:1px}.notice,.error{font-size:14px;margin:12px 0}}

.team-pager{padding-top:22rpx;display:grid;gap:16rpx;color:#7c7062;font-size:24rpx}.page-controls,.page-jump{display:flex;align-items:center;justify-content:center;gap:16rpx;min-width:0}.page-controls{justify-content:space-between}.page-controls .pager-label{white-space:nowrap;font-size:24rpx}.pager-button{box-sizing:border-box;width:auto!important;margin:0;min-width:0;height:64rpx;padding:0 18rpx;display:flex;align-items:center;justify-content:center;font-size:24rpx;line-height:1;background:#fffaf3;border:1rpx solid #d8c5a3;border-radius:10rpx;color:#74592d;white-space:nowrap}.pager-button::after{border:0}.pager-button.is-disabled{color:#aa9c87;background:#eee7da}.page-jump .pager-input{width:84rpx;height:62rpx;box-sizing:border-box;text-align:center;background:#fff;border:1rpx solid #dfcfb4;border-radius:10rpx}.page-jump .pager-button{background:#74592d;color:white}@media(min-width:700px){.team-pager{padding-top:16px;gap:10px;font-size:14px}.page-controls{justify-content:center;gap:22px}.page-controls .pager-label{font-size:14px}.page-jump{gap:10px}.pager-button{height:38px;padding:0 14px;font-size:14px;border-width:1px;border-radius:8px}.page-jump .pager-input{width:58px;height:38px;border-width:1px;border-radius:8px}}
