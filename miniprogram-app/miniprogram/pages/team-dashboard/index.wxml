<view class="workspace-page role-hq"><view class="workspace-topbar"><button class="team-back" bindtap="back">‹ 返回小组运营</button><text class="topbar-role hq-page-title">小组总览</text></view><view class="workspace-main"><view wx:if="{{message}}" class="form-message {{error ? 'error' : ''}}">{{message}}</view><block wx:if="{{authorized}}">      <view class="web-panel hq-filters">
        <view class="panel-heading"><view><text class="panel-title">数据范围</text></view></view>
        <view class="hq-filter-grid hq-ranking-control-grid">
          <label class="hq-control-field"><text>时间周期</text><picker range="{{hqPeriodLabels}}" value="{{hqPeriodIndex}}" bindchange="chooseHqPeriod"><view class="filter-picker"><text class="picker-value">{{hqPeriodLabels[hqPeriodIndex]}}</text></view></picker></label>
          <view class="hq-control-field"><text class="hq-control-label">排名对象</text><view class="hq-dimension-tabs"><button wx:for="{{hqDimensions}}" wx:key="value" class="{{item.value === hqDimension ? 'active' : ''}}" data-index="{{index}}" bindtap="chooseHqDimension">{{item.label}}</button></view></view>
          <view class="hq-control-field hq-product-filter"><view class="hq-control-heading"><text class="hq-control-label">项目范围</text></view><picker range="{{hqProductLabels}}" value="{{hqProductIndex}}" bindchange="chooseHqProduct"><view class="filter-picker"><text class="picker-value">{{hqProductLabels[hqProductIndex]}}</text></view></picker></view>
          <view class="hq-control-field"><text class="hq-control-label">排序指标</text><view class="hq-dimension-tabs hq-metric-tabs"><button wx:for="{{hqRankingMetrics}}" wx:key="value" class="{{item.value === hqRankingMetric ? 'active' : ''}}" data-index="{{index}}" bindtap="chooseHqRankingMetric">{{item.label}}</button></view></view>
          <view wx:if="{{hqPeriod === 'CUSTOM'}}" class="hq-custom-dates"><label><text>开始日期</text><picker mode="date" value="{{hqStart}}" bindchange="changeHqStart"><view class="filter-picker"><text class="picker-value">{{hqStart}}</text></view></picker></label><label><text>结束日期</text><picker mode="date" value="{{hqEnd}}" bindchange="changeHqEnd"><view class="filter-picker"><text class="picker-value">{{hqEnd}}</text></view></picker></label></view>
        </view>
      </view>

      <view class="web-panel hq-project-summary-panel">
        <view class="panel-heading"><view><text class="panel-title">项目汇总</text><text class="hq-ranking-rule">当前时间范围内的全部项目，按项目名称排列</text></view><text wx:if="{{!hqProjectSummaryLoading && !hqProjectSummaryError}}" class="web-badge">共 {{hqProjectSummaryPage.total}} 个项目</text></view>
        <project-summary id="hq-project-summary" rows="{{hqProjectSummaryRows}}" totals="{{hqProjectSummaryTotals}}" totals-ready="{{hqProjectSummaryTotalsReady}}" loading="{{hqProjectSummaryLoading}}" error="{{hqProjectSummaryError}}" bindretry="retryHqProjectSummary" />
        <view wx:if="{{!hqProjectSummaryLoading && !hqProjectSummaryError && hqProjectSummaryPage.totalPages > 1}}" class="table-pagination hq-project-summary-pagination"><button disabled="{{hqProjectSummaryPage.previousDisabled || hqProjectSummaryLoading}}" bindtap="previousHqProductSummaryPage">上一页</button><text>第 {{hqProjectSummaryPage.page}} / {{hqProjectSummaryPage.totalPages}} 页</text><button disabled="{{hqProjectSummaryPage.nextDisabled || hqProjectSummaryLoading}}" bindtap="nextHqProductSummaryPage">下一页</button></view>
      </view>

      <view class="web-panel ranking-panel">
        <view class="panel-heading ranking-heading"><view><text class="panel-title">完整排名</text><text class="hq-ranking-rule">{{hqProductLabels[hqProductIndex]}} · 按{{hqDimensionLabels[hqDimensionIndex]}}的{{hqRankingMetricLabels[hqRankingMetricIndex]}}次数降序</text></view><view class="ranking-actions"><button bindtap="exportHqRanking" disabled="{{loading || hqRankingLoading || hqExporting || hqRankingError}}">{{hqExporting ? '正在导出…' : '导出完整报表 PDF'}}</button></view></view>
        <scroll-view wx:if="{{hqRanking.length}}" class="hq-ranking-scroll" data-visible-rows="{{hqRankingVisibleRows}}" scroll-x="true" enhanced show-scrollbar="{{false}}" style="height: {{hqRankingViewportHeight}}rpx">
        <view class="hq-ranking-list">
          <view class="hq-ranking-row hq-ranking-table-head"><text>名次</text><text>{{hqDimensionLabels[hqDimensionIndex]}}</text><text>充值</text><text>核销</text><text>体验</text><text>退费</text></view>
          <view wx:for="{{hqRanking}}" wx:key="entityId" class="hq-ranking-row hq-ranking-card"><text class="hq-ranking-rank">{{item.rank}}</text><text wx:if="{{item.profileRef && hqDimension === 'teacher'}}" class="hq-ranking-name hq-ranking-link" role="link" data-id="{{item.entityId}}" data-dimension="{{hqDimension}}" bindtap="openHqRankedProfile">{{item.name}}</text><text wx:else class="hq-ranking-name">{{item.name}}</text><text class="hq-ranking-value">{{item.recharge}} 次</text><text class="hq-ranking-value">{{item.verification}} 次</text><text class="hq-ranking-value">{{item.experience}} 次</text><text class="hq-ranking-value">{{item.refund}} 次</text></view>
        </view>
        </scroll-view>
        <view wx:else class="hq-ranking-notice"><text>{{loading || hqRankingLoading ? '正在读取排名…' : (hqRankingError || '当前日期范围暂无有效数据')}}</text><button wx:if="{{hqRankingError && !hqRankingLoading}}" class="ranking-retry" bindtap="retryHqRanking">重新读取</button></view>
        <view wx:if="{{!hqRankingError && (hqRankingPage.total > 0)}}" class="table-pagination hq-ranking-pagination"><button disabled="{{hqRankingPage.previousDisabled || hqRankingLoading}}" bindtap="previousHqPage">上一页</button><text>第 {{hqRankingPage.page}} / {{hqRankingPage.totalPages}} 页 · 共 {{hqRankingPage.total}} 条</text><button disabled="{{hqRankingPage.nextDisabled || hqRankingLoading}}" bindtap="nextHqPage">下一页</button><view class="ranking-page-jump"><text>跳至第</text><input type="number" value="{{hqRankingInput}}" bindinput="inputHqPage" /><text>页</text><button disabled="{{hqRankingLoading}}" bindtap="jumpHqPage">跳转</button></view></view>
      </view></block><view class="safe-bottom"></view></view></view>
