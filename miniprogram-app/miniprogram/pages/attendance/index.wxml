<view class="page daily-page">
  <view class="page-heading"><view><text class="title">考勤打卡</text><text class="subtitle">每天分别完成上班和下班打卡；现场照片只用于当次人脸验证</text></view><button class="back" bindtap="back">返回工作台</button></view>
  <view wx:if="{{!authorized}}" class="notice-card">正在确认老师账号…</view>
  <view wx:else class="daily-layout">
    <view class="calendar-card date-query-card"><date-selector value="{{pendingDate}}" end="{{serverToday}}" disabled="{{loading || locating || clocking}}" bindchange="chooseDate"></date-selector><button class="confirm-button" bindtap="confirmDate" disabled="{{loading || locating || clocking}}">确认</button></view>
    <view class="editor-card attendance-card">
      <view class="section-heading"><view><text class="section-title">{{selectedDate}}</text><text class="section-note">{{selectedAttendance.completed ? '上下班均已打卡' : (selectedAttendance.started ? '已上班打卡，待下班打卡' : '尚未上班打卡')}}</text></view><text class="state-badge {{selectedAttendance.started ? 'editable' : ''}}">{{selectedAttendance.completed ? '已完成' : (selectedAttendance.started ? '进行中' : '未打卡')}}</text></view>
      <view wx:if="{{selectedAttendance.clockIn}}" class="punch-card">
        <view class="punch-heading"><text>上班打卡</text><text>{{selectedAttendance.clockIn.checkedTime}}</text></view>
        <view class="record-detail"><view><text>定位精度</text><text>约 {{selectedAttendance.clockIn.accuracy}} 米</text></view><view><text>人脸分数</text><text>{{selectedAttendance.clockIn.faceScore}}</text></view></view>
        <map class="attendance-map" latitude="{{selectedAttendance.clockIn.latitude}}" longitude="{{selectedAttendance.clockIn.longitude}}" markers="{{selectedAttendance.clockIn.markers}}" scale="17" show-location></map>
        <button class="location-button" data-kind="clockIn" bindtap="openLocation">查看上班打卡位置</button>
      </view>
      <view wx:if="{{selectedAttendance.clockOut}}" class="punch-card">
        <view class="punch-heading"><text>下班打卡</text><text>{{selectedAttendance.clockOut.checkedTime}}</text></view>
        <view class="record-detail"><view><text>定位精度</text><text>约 {{selectedAttendance.clockOut.accuracy}} 米</text></view><view><text>人脸分数</text><text>{{selectedAttendance.clockOut.faceScore}}</text></view></view>
        <map class="attendance-map" latitude="{{selectedAttendance.clockOut.latitude}}" longitude="{{selectedAttendance.clockOut.longitude}}" markers="{{selectedAttendance.clockOut.markers}}" scale="17" show-location></map>
        <button class="location-button" data-kind="clockOut" bindtap="openLocation">查看下班打卡位置</button>
      </view>
      <view wx:if="{{selectedAttendance.completed}}" class="work-duration"><text>工作时长</text><text>{{selectedAttendance.workDurationText}}</text></view>
      <block wx:if="{{selectedDate === serverToday && !selectedAttendance.completed}}">
        <view class="next-punch"><text>本次办理</text><text>{{selectedAttendance.clockIn ? '下班打卡' : '上班打卡'}}</text></view>
        <block wx:if="{{!faceEnrolled}}"><view class="form-message">当前账号未录入考勤人脸，可以进入并查看考勤记录，但暂时不能进行人脸打卡。</view><button class="save-button" disabled>未录入人脸，暂不能打卡</button></block>
        <block wx:elif="{{checkInStage === 'idle'}}"><view class="check-step"><text>第一步</text><text>读取并确认本次打卡的当前时间和地点</text></view><button class="save-button" bindtap="prepareCheckIn" loading="{{locating}}" disabled="{{locating || clocking}}">获取{{selectedAttendance.clockIn ? '下班' : '上班'}}打卡时间地点</button></block>
        <block wx:elif="{{checkInStage === 'confirm'}}"><view class="check-step"><text>第二步</text><text>确认无误后再进行人脸识别</text></view><view class="location-confirm"><view><text>打卡类型</text><text>{{pendingAttendanceLabel}}</text></view><view><text>手机当前时间</text><text>{{locationPreview.checkedTime}}</text></view><view><text>经纬度</text><text>{{locationPreview.coordinateText}}</text></view><view><text>坐标类型</text><text>{{locationPreview.coordinateType}}</text></view><view><text>定位精度</text><text>约 {{locationPreview.accuracy}} 米</text></view><map class="attendance-map preview-map" latitude="{{locationPreview.latitude}}" longitude="{{locationPreview.longitude}}" markers="{{locationPreview.markers}}" scale="17" show-location></map><button class="location-button" bindtap="openPreviewLocation">在地图中打开</button></view><view class="confirm-actions"><button class="location-button" bindtap="resetCheckInContext">重新定位</button><button class="save-button" bindtap="confirmCheckInContext">确认时间地点</button></view></block>
        <block wx:else><view class="check-step"><text>第三步</text><text>时间地点已确认，完成人脸识别并提交{{pendingAttendanceLabel}}</text></view><view class="confirmed-context"><text>{{pendingAttendanceLabel}} · {{locationPreview.checkedTime}}</text><text>{{locationPreview.coordinateText}} · 精度约 {{locationPreview.accuracy}} 米</text></view><camera-capture id="attendanceCamera" title="老师本次打卡照片" bindchange="captureChanged"></camera-capture><text class="privacy-note">现场照片仅发送给人脸验证接口，本次验证结束后不保存；最终打卡时间以服务端记录为准。</text><button class="location-button" bindtap="resetCheckInContext" disabled="{{clocking}}">重新确认时间地点</button><button class="save-button face-submit" bindtap="clockIn" loading="{{clocking}}" disabled="{{clocking || !captureReady}}">验证人脸并提交{{pendingAttendanceLabel}}</button></block>
      </block>
      <view wx:elif="{{!selectedAttendance.started}}" class="notice-card inline">这一天没有打卡记录，历史日期不能补打卡。</view>
      <view wx:elif="{{!selectedAttendance.clockOut && selectedDate !== serverToday}}" class="notice-card inline">这一天只有上班打卡，没有下班打卡；历史记录不可补写。</view>
      <view wx:if="{{message}}" class="form-message {{error ? 'error' : ''}}">{{message}}<text wx:if="{{locationErrorCode}}" class="location-error-code">错误代码：{{locationErrorCode}}</text></view>
      <view wx:if="{{permissionDenied && permissionAction === 'privacy'}}" class="permission-actions"><button class="location-button permission-button" bindtap="openPrivacyContract">查看隐私保护指引</button><button class="save-button permission-button" bindtap="retryPrivacyAuthorization">重新请求隐私授权</button></view>
      <view wx:elif="{{permissionDenied}}" class="permission-actions"><button class="save-button permission-button" bindtap="retryLocationAuthorization">重新请求定位授权</button><button class="location-button permission-button" bindtap="openSettings">打开小程序权限设置</button><button wx:if="{{permissionAction === 'system'}}" class="location-button permission-button" bindtap="openSystemLocationSettings">打开手机系统定位设置</button></view>
      <view wx:if="{{permissionDenied && permissionAction === 'privacy'}}" class="permission-help"><text>点击“重新请求隐私授权”，微信会再次显示本小程序的隐私授权提示；同意后会继续读取位置。</text></view>
      <view wx:elif="{{permissionDenied}}" class="permission-help"><text>先点击“重新请求定位授权”，让微信重新生成本小程序的位置授权项。</text><text>只有微信已明确拒绝过位置权限时，才需要打开小程序权限设置。</text><text wx:if="{{permissionAction === 'system'}}">系统级定位被关闭时，再打开手机系统定位设置；返回本页后会自动重试。</text></view>
    </view>
  </view>
</view>
