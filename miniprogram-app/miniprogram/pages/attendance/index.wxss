page { background: #f3ede2; color: #302a22; }
.page { width: calc(100% - 40rpx); margin: 0 auto; padding: 26rpx 0 calc(42rpx + env(safe-area-inset-bottom)); }
.page-heading { position: relative; min-height: 72rpx; display: flex; align-items: center; gap: 18rpx; margin-bottom: 22rpx; padding-right: 180rpx; box-sizing: border-box; }
.page-heading > view { min-width: 0; }
.title, .subtitle { display: block; }
.title { font-size: 38rpx; font-weight: 700; }
.subtitle { margin-top: 7rpx; color: #7c7062; font-size: 22rpx; line-height: 1.5; }
button::after { border: 0; }
.back, .today-button, .confirm-button, .month-toolbar button { width: auto !important; min-width: 0; margin: 0; color: #74592d; background: #fffaf3; border: 1rpx solid #d8c5a3; }
.back, .today-button, .confirm-button { min-height: 72rpx; display: flex; align-items: center; justify-content: center; padding: 0 20rpx; border-radius: 13rpx; font-size: 23rpx; line-height: 1; text-align: center; }
.back { position: absolute; top: 0; right: 0; margin-left: auto !important; background: transparent; border-color: transparent; }
.daily-layout { display: grid; grid-template-columns: minmax(0, 1fr); gap: 18rpx; }
.date-query-card { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: 14rpx; }
.date-query-card date-selector { min-width: 0; }
.confirm-button { min-width: 118rpx !important; }
.date-query-label { min-width: 0; }
.date-query-picker { min-width: 0; }
.calendar-card, .editor-card, .notice-card { padding: 24rpx; background: #fffaf3; border: 1rpx solid #dfcfb4; border-radius: 24rpx; }
.section-heading { display: flex; align-items: flex-start; justify-content: space-between; gap: 16rpx; margin-bottom: 20rpx; }
.section-title, .section-note { display: block; }
.section-title { font-size: 30rpx; font-weight: 700; }
.section-note { margin-top: 6rpx; color: #7c7062; font-size: 22rpx; }
.state-badge { flex: none; padding: 7rpx 13rpx; color: #7c7062; background: #eee4d6; border-radius: 999rpx; font-size: 20rpx; }
.state-badge.editable { color: #08725f; background: #e8f8f2; }
.month-toolbar { display: grid; grid-template-columns: 64rpx minmax(0, 1fr) 64rpx; align-items: center; gap: 10rpx; margin-bottom: 16rpx; }
.month-toolbar button { width: 64rpx !important; height: 64rpx; min-height: 0; padding: 0; border-radius: 12rpx; font-size: 38rpx; line-height: 1; }
.month-picker { min-height: 64rpx; display: flex; align-items: center; justify-content: center; color: #5f4a2f; background: #f5ead8; border: 1rpx solid #d8c5a3; border-radius: 12rpx; font-size: 26rpx; font-weight: 700; }
.weekdays, .calendar-grid { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); gap: 7rpx; }
.weekdays { margin-bottom: 8rpx; color: #847766; font-size: 20rpx; text-align: center; }
.day { position: relative; width: 100% !important; min-width: 0; height: 76rpx; min-height: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 4rpx; margin: 0; padding: 0; color: #4e4336; background: #fff; border: 1rpx solid #eadfce; border-radius: 13rpx; font-size: 24rpx; }
.day.blank { background: transparent; border-color: transparent; }
.day.today { border-color: #a98243; }
.day.selected { color: #fff; background: #74592d; border-color: #74592d; font-weight: 700; }
.day[disabled] { color: #b7ab9b; background: #f5efe7; }
.day-dot { width: 8rpx; height: 8rpx; background: #b9893e; border-radius: 50%; }
.day.selected .day-dot { background: #fff5d8; }
.report-field { display: block; margin-bottom: 19rpx; }
.report-field > view { display: flex; align-items: center; gap: 10rpx; margin-bottom: 9rpx; color: #675b4b; font-size: 24rpx; font-weight: 700; }
.required { padding: 3rpx 8rpx; color: #8b3f35; background: #fff0ee; border-radius: 7rpx; font-size: 18rpx; }
.report-field textarea { width: 100%; min-height: 178rpx; padding: 17rpx 19rpx; color: #302a22; background: #fff; border: 1rpx solid #d8c5a3; border-radius: 14rpx; font-size: 25rpx; line-height: 1.55; }
.report-field textarea[disabled] { color: #554a3c; background: #f6f0e7; }
.counter { display: block; margin-top: 6rpx; color: #8a7d6d; font-size: 19rpx; text-align: right; }
.form-message, .notice-card { color: #625747; font-size: 24rpx; line-height: 1.6; }
.notice-card.inline { margin-bottom: 0; padding: 18rpx; border-radius: 14rpx; }
.form-message { margin-bottom: 16rpx; padding: 15rpx 17rpx; background: #f5ead8; border-radius: 12rpx; }
.form-message.error { color: #8b3f35; background: #fff0ee; }
.save-button { width: 100% !important; height: 84rpx; min-height: 84rpx; display: flex; align-items: center; justify-content: center; box-sizing: border-box; margin: 0; padding: 0 24rpx; color: #fff; background: #6f532e; border-radius: 14rpx; font-size: 26rpx; font-weight: 700; line-height: 1; text-align: center; }
.edit-button { width: 100% !important; height: 84rpx; min-height: 84rpx; display: flex; align-items: center; justify-content: center; box-sizing: border-box; margin: 0; padding: 0 24rpx; color: #74592d; background: #fff; border: 1rpx solid #d8c5a3; border-radius: 14rpx; font-size: 26rpx; font-weight: 700; line-height: 1; text-align: center; }
button[disabled] { opacity: .55; }
@media (min-width: 700px) {
  .page { width: calc(100% - 48px); max-width: 1120px; padding: 24px 0 40px; }
  .page-heading { margin-bottom: 20px; }
  .page-heading { min-height: 44px; padding-right: 132px; }
  .title { font-size: 28px; }
  .subtitle { margin-top: 5px; font-size: 14px; }
  .back, .today-button, .confirm-button { min-height: 46px; padding: 0 16px; border-width: 1px; border-radius: 10px; font-size: 14px; }
  .daily-layout { grid-template-columns: minmax(0, 1fr); align-items: start; gap: 18px; }
  .date-query-card { grid-template-columns: minmax(0, 1fr) auto; gap: 14px; }
  .confirm-button { min-width: 82px !important; }
  .calendar-card, .editor-card, .notice-card { padding: 20px; border-width: 1px; border-radius: 18px; }
  .section-heading { gap: 12px; margin-bottom: 16px; }
  .section-title { font-size: 20px; }
  .section-note { margin-top: 5px; font-size: 13px; }
  .state-badge { padding: 5px 10px; font-size: 13px; }
  .month-toolbar { grid-template-columns: 42px minmax(0, 1fr) 42px; gap: 8px; margin-bottom: 12px; }
  .month-toolbar button { width: 42px !important; height: 42px; border-width: 1px; border-radius: 9px; font-size: 24px; }
  .month-picker { min-height: 42px; border-width: 1px; border-radius: 9px; font-size: 15px; }
  .weekdays, .calendar-grid { gap: 5px; }
  .weekdays { margin-bottom: 6px; font-size: 12px; }
  .day { height: 48px; border-width: 1px; border-radius: 9px; font-size: 14px; }
  .day-dot { width: 5px; height: 5px; }
  .report-field { margin-bottom: 15px; }
  .report-field > view { gap: 8px; margin-bottom: 7px; font-size: 14px; }
  .required { padding: 2px 6px; border-radius: 5px; font-size: 11px; }
  .report-field textarea { min-height: 112px; padding: 13px 14px; border-width: 1px; border-radius: 11px; font-size: 15px; }
  .counter { margin-top: 5px; font-size: 12px; }
  .form-message, .notice-card { font-size: 14px; }
  .form-message { margin-bottom: 12px; padding: 11px 13px; border-radius: 9px; }
  .save-button, .edit-button { height: 48px; min-height: 48px; padding: 0 16px; border-radius: 10px; font-size: 15px; }
}

.attendance-card { min-width: 0; }
.punch-card { margin-bottom: 18rpx; padding: 18rpx; background: #fff; border: 1rpx solid #eadfce; border-radius: 16rpx; }
.punch-heading { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; padding-bottom: 10rpx; border-bottom: 1rpx solid #eadfce; }
.punch-heading text:first-child { color: #74592d; font-size: 25rpx; font-weight: 700; }
.punch-heading text:last-child { font-size: 22rpx; font-variant-numeric: tabular-nums; }
.record-detail > view { display: flex; justify-content: space-between; gap: 18rpx; padding: 14rpx 0; border-bottom: 1rpx solid #eadfce; font-size: 24rpx; }
.record-detail > view text:first-child { color: #7c7062; }
.attendance-map { width: 100%; height: 420rpx; margin-top: 20rpx; border-radius: 16rpx; overflow: hidden; }
.location-button { width: 100% !important; min-height: 74rpx; margin: 16rpx 0 0; color: #74592d; background: #fff; border: 1rpx solid #d8c5a3; border-radius: 13rpx; font-size: 24rpx; }
.privacy-note { display: block; margin: 16rpx 0; color: #7c7062; font-size: 22rpx; line-height: 1.55; }
.location-error-code { display: block; margin-top: 8rpx; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 19rpx; overflow-wrap: anywhere; }
.check-step { display: flex; align-items: center; gap: 12rpx; margin-bottom: 16rpx; color: #5d5142; font-size: 23rpx; }
.check-step text:first-child { flex: none; padding: 6rpx 11rpx; color: #74592d; background: #f4e7d0; border-radius: 999rpx; font-size: 19rpx; font-weight: 700; }
.location-confirm { padding: 18rpx; background: #fff; border: 1rpx solid #eadfce; border-radius: 16rpx; }
.location-confirm > view { display: flex; justify-content: space-between; gap: 18rpx; padding: 11rpx 0; border-bottom: 1rpx solid #eadfce; font-size: 22rpx; }
.location-confirm > view text:first-child { color: #7c7062; }
.location-confirm > view text:last-child { text-align: right; font-variant-numeric: tabular-nums; }
.preview-map { margin-top: 18rpx; }
.confirm-actions { display: grid; grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr); gap: 12rpx; margin-top: 16rpx; }
.confirm-actions .location-button, .confirm-actions .save-button { min-height: 74rpx; margin: 0; }
.confirmed-context { margin-bottom: 16rpx; padding: 15rpx 17rpx; color: #5d5142; background: #f5ead8; border-radius: 12rpx; }
.confirmed-context text { display: block; font-size: 21rpx; line-height: 1.5; }
.confirmed-context text + text { margin-top: 5rpx; color: #7c7062; }
.face-submit { margin-top: 14rpx; }
.work-duration, .next-punch { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin: 16rpx 0; padding: 16rpx 18rpx; background: #f5ead8; border-radius: 13rpx; font-size: 23rpx; }
.work-duration text:last-child, .next-punch text:last-child { color: #74592d; font-weight: 700; }
.permission-actions { display: grid; grid-template-columns: minmax(0, 1fr); gap: 10rpx; }
.permission-actions .location-button { margin-top: 0; }
.permission-help { display: block; margin-top: 12rpx; padding: 16rpx 18rpx; color: #6e5e4b; background: #fff8eb; border: 1rpx solid #dfcfb4; border-radius: 13rpx; font-size: 21rpx; line-height: 1.55; }
.permission-help text { display: block; }
.permission-help text + text { margin-top: 8rpx; }

@media (min-width: 700px) {
  .punch-card { margin-bottom: 14px; padding: 15px; border-width: 1px; border-radius: 12px; }
  .punch-heading { gap: 12px; padding-bottom: 9px; border-width: 1px; }
  .punch-heading text:first-child { font-size: 15px; }
  .punch-heading text:last-child { font-size: 13px; }
  .attendance-map { height: 320px; margin-top: 16px; border-radius: 12px; }
  .record-detail > view { gap: 12px; padding: 11px 0; border-width: 1px; font-size: 14px; }
  .location-button { min-height: 44px; margin-top: 12px; border-width: 1px; border-radius: 10px; font-size: 14px; }
  .privacy-note { margin: 12px 0; font-size: 13px; }
  .location-error-code { margin-top: 6px; font-size: 12px; }
  .check-step { gap: 9px; margin-bottom: 12px; font-size: 14px; }
  .check-step text:first-child { padding: 4px 8px; font-size: 12px; }
  .location-confirm { padding: 15px; border-width: 1px; border-radius: 12px; }
  .location-confirm > view { gap: 12px; padding: 9px 0; border-width: 1px; font-size: 14px; }
  .preview-map { margin-top: 14px; }
  .confirm-actions { gap: 10px; margin-top: 12px; }
  .confirm-actions .location-button, .confirm-actions .save-button { min-height: 44px; }
  .confirmed-context { margin-bottom: 12px; padding: 11px 13px; border-radius: 9px; }
  .confirmed-context text { font-size: 13px; }
  .confirmed-context text + text { margin-top: 4px; }
  .face-submit { margin-top: 10px; }
  .work-duration, .next-punch { gap: 12px; margin: 12px 0; padding: 12px 14px; border-radius: 10px; font-size: 14px; }
  .permission-actions { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
  .permission-help { margin-top: 9px; padding: 12px 14px; border-width: 1px; border-radius: 10px; font-size: 13px; }
  .permission-help text + text { margin-top: 6px; }
}
