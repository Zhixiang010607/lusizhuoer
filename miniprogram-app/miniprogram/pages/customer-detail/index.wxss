.profile-card { padding-bottom: 24rpx; }
.profile-top { display: flex; align-items: center; gap: 20rpx; margin-bottom: 16rpx; }
.profile-name { min-width: 0; flex: 1; }
.profile-name text { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.profile-name > text:first-child { font-size: 36rpx; font-weight: 850; }
.profile-name .profile-sub { margin-top: 6rpx; color: #7c7062; font-size: 24rpx; }
.photo-placeholder { display: flex; align-items: center; justify-content: center; padding: 10rpx; color: #74695c; background: #f5ead8; font-size: 24rpx; line-height: 1.3; text-align: center; }
.profile-facts { grid-template-columns: repeat(4, minmax(0, 1fr)); margin-top: 18rpx; }
.profile-facts .fact { padding: 14rpx 8rpx; text-align: center; }
.profile-facts .value { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.subsection-title { margin: 22rpx 0 12rpx; font-size: 27rpx; font-weight: 850; }
.recent-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10rpx; }
.recent-item { min-width: 0; min-height: 104rpx; display: flex; flex-direction: column; justify-content: center; padding: 14rpx 16rpx; background: #fff7eb; border: 1rpx solid #eadcc6; border-radius: 14rpx; }
.recent-item > text:first-child { color: #7c7062; font-size: 24rpx; }
.recent-item > text:last-child { margin-top: 8rpx; overflow: hidden; font-weight: 800; text-overflow: ellipsis; white-space: nowrap; }
.status-item { justify-content: flex-start; }
.status-line { min-width: 0; display: flex; align-items: center; gap: 10rpx; margin-top: 7rpx; }
.status-badge { flex: none; padding: 5rpx 11rpx; border-radius: 999rpx; font-size: 24rpx; font-weight: 800; white-space: nowrap; }
.status-badge.active { color: #426b55; background: #e7f2e9; }
.status-badge.archived { color: #934d43; background: #f8e7e3; }
.status-line button { min-width: 0; flex: 1; min-height: 54rpx; display: flex; align-items: center; justify-content: center; margin: 0; padding: 0 10rpx; border-radius: 10rpx; font-size: 24rpx; font-weight: 800; line-height: 1.2; white-space: nowrap; }
.status-activate { color: #426b55; background: #e7f2e9; border: 1rpx solid #b8d5c0; }
.status-archive { color: #934d43; background: #f8e7e3; border: 1rpx solid #e1bab2; }

.section-message { margin-top: 12rpx; padding: 12rpx 14rpx; color: #48705b; background: #edf5ee; border-radius: 10rpx; font-size: 24rpx; line-height: 1.45; }
.section-message.error { color: #9a302b; background: #fff0ee; }

.notes-card, .messages-card { background: linear-gradient(180deg, #fffaf3 0%, #fff6e8 100%); border-color: #dcc49c; }
.notes-title { align-items: center; }
.notes-actions { min-width: 0; display: flex; align-items: center; gap: 8rpx; }
.notes-actions button { width: auto; min-width: 94rpx; min-height: 54rpx; display: flex; align-items: center; justify-content: center; margin: 0; padding: 0 14rpx; border-radius: 10rpx; font-size: 24rpx; font-weight: 800; line-height: 1.2; }
.small-action { color: #fff; background: #76592f; }
.small-action[disabled] { color: #9b9082; background: #e7ddce; }
.ghost-action { color: #76592f; background: #fff; border: 1rpx solid #d8bc8c; }
.notes-read { width: 100%; height: 220rpx; box-sizing: border-box; padding: 18rpx 20rpx; overflow: hidden; background: #fff7eb; border: 1rpx solid #d8bc8c; border-radius: 14rpx; }
.notes-read text { width: 100%; display: block; color: #302a22; font-size: 24rpx; line-height: 1.6; white-space: pre-wrap; word-break: break-word; }
.notes-input { height: 220rpx; min-height: 220rpx; padding: 18rpx 20rpx; background: #fff7eb; border-color: #d8bc8c; }
.character-count { margin-top: 7rpx; color: #8a7d6d; font-size: 24rpx; text-align: right; }
.character-count.limit { color: #99574b; font-weight: 800; }

.message-list { width: 100%; min-height: 220rpx; max-height: 620rpx; box-sizing: border-box; display: grid; gap: 10rpx; overflow-y: auto; }
.message-list.has-messages { min-height: 300rpx; max-height: 840rpx; }
.message-item { min-width: 0; padding: 15rpx 17rpx; background: #f9edda; border: 1rpx solid #dfc69e; border-radius: 14rpx; }
.message-meta { min-width: 0; display: flex; align-items: baseline; gap: 10rpx; }
.message-author { min-width: 0; flex: 1; overflow: hidden; font-size: 24rpx; font-weight: 800; text-overflow: ellipsis; white-space: nowrap; }
.message-time { flex: none; color: #8a7d6d; font-size: 24rpx; white-space: nowrap; }
.message-content { display: block; margin-top: 9rpx; color: #3c342a; font-size: 24rpx; line-height: 1.55; white-space: pre-wrap; word-break: break-word; }
.message-empty { min-height: 220rpx; display: flex; align-items: center; justify-content: center; color: #7c7062; background: #f9edda; border: 1rpx dashed #d8bc8c; border-radius: 14rpx; font-size: 24rpx; }
.load-message-button { width: auto; min-width: 190rpx; min-height: 62rpx; display: flex; align-items: center; justify-content: center; margin: 14rpx auto 0; padding: 0 20rpx; font-size: 24rpx; line-height: 1.2; }
.message-compose { min-width: 0; display: flex; flex-direction: column; align-items: stretch; gap: 10rpx; margin-top: 14rpx; padding: 0; background: transparent; border: 0; }
.message-input-wrap { width: 100%; min-width: 0; }
.messages-card .message-input { width: 100%; height: 96rpx; min-height: 96rpx; padding: 10rpx 14rpx; box-sizing: border-box; background: #fffaf3; border-color: #d8bc8c; font-size: 24rpx; line-height: 1.5; }
.message-compose-footer { min-width: 0; display: flex; align-items: center; justify-content: space-between; gap: 14rpx; }
.message-compose-footer .character-count { min-width: 0; margin: 0; text-align: left; white-space: nowrap; }
.messages-card .submit-message-button { width: 184rpx; max-width: 100%; min-width: 0; height: 80rpx; min-height: 80rpx; flex: none; display: flex; align-items: center; justify-content: center; margin: 0; padding: 0 14rpx; font-size: 24rpx; line-height: 1; text-align: center; white-space: nowrap; }
.messages-card .submit-message-button[disabled] { color: #9b9082; background: #e7ddce; opacity: 1; }

.table-scroll { width: 100%; overflow-x: auto; overflow-y: hidden; border: 1rpx solid #dfcfb4; border-radius: 14rpx; }
.balance-table { width: auto; min-width: 100%; display: inline-table; table-layout: auto; border-collapse: collapse; background: #fffaf3; }
.balance-table-row { display: table-row; }
.balance-table-row text, .record-row text { width: auto; min-width: 0; height: 74rpx; box-sizing: border-box; display: table-cell; padding: 10rpx 18rpx; border-top: 1rpx solid #dfcfb4; font-size: 24rpx; line-height: 1.25; text-align: center; vertical-align: middle; white-space: nowrap; }
.balance-table-row:first-child text, .record-row:first-child text { border-top: 0; }
.retail-summary-hint { display: block; margin: -4rpx 0 10rpx; color: #7c7062; font-size: 24rpx; text-align: right; }
.retail-summary-scroll { width: 100%; box-sizing: border-box; overflow-x: auto; overflow-y: hidden; border: 1rpx solid #dfcfb4; border-radius: 16rpx; background: #fffaf3; }
.retail-summary-table { width: auto; min-width: 100%; display: inline-table; table-layout: auto; border-collapse: collapse; background: #fffaf3; }
.retail-summary-row { display: table-row; }
.retail-summary-row text { width: auto; min-width: 0; height: 76rpx; box-sizing: border-box; display: table-cell; padding: 10rpx 18rpx; border-top: 1rpx solid #eadfce; font-size: 24rpx; line-height: 1.25; text-align: center; vertical-align: middle; white-space: nowrap; }
.retail-summary-row:first-child text { border-top: 0; }
.retail-summary-row.table-head text { height: 68rpx; }
.retail-summary-row .retail-count { color: #74592d; font-size: inherit; font-weight: 850; }
.table-head { color: #675b4b; background: #f5ead8; font-weight: 800; }
.balance-count { color: #76592f; font-weight: 850; }

.history-tabs { grid-template-columns: repeat(5, minmax(0, 1fr)); margin-bottom: 14rpx; }
.history-tabs button { min-width: 0; display: flex; align-items: center; justify-content: center; padding: 0 6rpx; font-size: 24rpx; line-height: 1.2; text-align: center; white-space: nowrap; }
.record-table { width: auto; min-width: 100%; display: inline-table; table-layout: auto; border-collapse: collapse; background: #fffaf3; }
.record-row { display: table-row; }
.record-row.table-head text { height: 66rpx; }
.record-link { color: #76592f; font-weight: 850; text-decoration: underline; }
.customer-communication-grid, .customer-summary-grid { display: contents; }
.table-scroll-hint { display: block; margin: -4rpx 0 10rpx; color: #7c7062; font-size: 24rpx; text-align: right; }
.balance-scroll[data-visible-rows="1"] { height: 148rpx; }
.balance-scroll[data-visible-rows="2"] { height: 222rpx; }
.balance-scroll[data-visible-rows="3"] { height: 296rpx; }
.balance-scroll[data-visible-rows="4"] { height: 370rpx; }
.balance-scroll[data-visible-rows="5"] { height: 444rpx; }
.retail-summary-scroll[data-visible-rows="1"] { height: 144rpx; }
.retail-summary-scroll[data-visible-rows="2"] { height: 220rpx; }
.retail-summary-scroll[data-visible-rows="3"] { height: 296rpx; }
.retail-summary-scroll[data-visible-rows="4"] { height: 372rpx; }
.retail-summary-scroll[data-visible-rows="5"] { height: 448rpx; }

@media (min-width: 700px) {
  .profile-card { padding-bottom: 20px; }
  .profile-top { gap: 16px; margin-bottom: 12px; }
  .profile-name > text:first-child { font-size: 24px; }
  .profile-name .profile-sub { margin-top: 4px; font-size: 14px; }
  .photo-placeholder { padding: 8px; font-size: 14px; }
  page .page .profile-facts { grid-template-columns: repeat(4, minmax(0, 1fr)); margin-top: 14px; }
  .profile-facts .fact { padding: 12px 8px; }
  .subsection-title { margin: 18px 0 10px; font-size: 19px; }
  .recent-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
  .recent-item { min-height: 82px; padding: 12px 14px; border-width: 1px; border-radius: 12px; }
  .recent-item > text:first-child { font-size: 14px; }
  .recent-item > text:last-child { margin-top: 6px; font-size: 15px; }
  .status-line { gap: 8px; margin-top: 6px; }
  .status-badge { padding: 4px 8px; font-size: 14px; }
  .status-line button { min-height: 38px; padding: 0 8px; border-radius: 9px; font-size: 14px; }
  .section-message { margin-top: 10px; padding: 10px 12px; border-radius: 9px; font-size: 14px; }
  .customer-communication-grid, .customer-summary-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); align-items: stretch; gap: 16px; margin-bottom: 16px; }
  .customer-communication-grid > .card, .customer-summary-grid > .card { min-width: 0; height: 100%; margin: 0; }
  .customer-communication-grid > .notes-card { display: flex; flex-direction: column; }
  .customer-communication-grid > .notes-card .notes-read,
  .customer-communication-grid > .notes-card .notes-input { height: auto; min-height: 178px; flex: 1; }
  .notes-actions { gap: 6px; }
  .notes-actions button { min-width: 72px; min-height: 40px; padding: 0 11px; border-radius: 9px; font-size: 14px; }
  .notes-read, .notes-input { height: 178px; min-height: 178px; padding: 14px 16px; border-width: 1px; border-radius: 12px; }
  .notes-read text { font-size: 15px; }
  .character-count { margin-top: 6px; font-size: 14px; }
  .message-list { min-height: 128px; max-height: 210px; gap: 8px; }
  .message-list.has-messages { min-height: 160px; max-height: 300px; }
  .message-item { padding: 11px 13px; border-width: 1px; border-radius: 11px; }
  .message-meta { gap: 8px; }
  .message-author { font-size: 14px; }
  .message-time { font-size: 14px; }
  .message-content { margin-top: 6px; font-size: 14px; }
  .message-empty { min-height: 128px; border-width: 1px; border-radius: 11px; font-size: 14px; }
  .message-compose { gap: 8px; margin-top: 10px; }
  .messages-card .message-input { height: 60px; min-height: 60px; padding: 8px 12px; font-size: 14px; }
  .message-compose-footer { gap: 12px; }
  .messages-card .submit-message-button { width: 120px; height: 40px; min-height: 40px; padding: 0 12px; font-size: 14px; }
  .load-message-button { min-width: 150px; min-height: 44px; margin-top: 12px; padding: 0 14px; font-size: 14px; }
  .table-scroll-hint, .retail-summary-hint { margin: -2px 0 8px; font-size: 14px; }
  .table-scroll, .retail-summary-scroll { border-width: 1px; border-radius: 12px; }
  .balance-table, .retail-summary-table, .record-table { width: auto; min-width: 100%; }
  .balance-table-row text, .retail-summary-row text, .record-row text { height: 52px; padding: 8px 12px; border-width: 1px; font-size: 14px; }
  .balance-scroll[data-visible-rows="1"] { height: 104px; }
  .balance-scroll[data-visible-rows="2"] { height: 156px; }
  .balance-scroll[data-visible-rows="3"] { height: 208px; }
  .balance-scroll[data-visible-rows="4"] { height: 260px; }
  .balance-scroll[data-visible-rows="5"] { height: 312px; }
  .retail-summary-row.table-head text { height: 48px; }
  .retail-summary-scroll[data-visible-rows="1"] { height: 100px; }
  .retail-summary-scroll[data-visible-rows="2"] { height: 152px; }
  .retail-summary-scroll[data-visible-rows="3"] { height: 204px; }
  .retail-summary-scroll[data-visible-rows="4"] { height: 256px; }
  .retail-summary-scroll[data-visible-rows="5"] { height: 308px; }
  .history-tabs { grid-template-columns: repeat(5, minmax(0, 1fr)); margin-bottom: 12px; }
  .history-tabs button { padding: 0 6px; font-size: 14px; }
  .record-row.table-head text { height: 48px; }
}

.profile-facts.large-counts { grid-template-columns: repeat(2, minmax(0, 1fr)); }
.profile-facts.large-counts .value { text-overflow: clip; }
.message-list { display: block; overflow-x: hidden; }
.message-item + .message-item { margin-top: 10rpx; }
.message-item { width: 100%; max-width: 100%; }
.message-meta { flex-wrap: wrap; }
.message-author { flex: 1 1 180rpx; max-width: 100%; }
.message-content { min-width: 0; overflow-wrap: anywhere; word-break: break-all; }
@media (min-width: 700px) {
  page .page .profile-facts.large-counts { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  .message-author { flex-basis: 120px; }
}

@media (min-width: 700px) { .message-item + .message-item { margin-top: 8px; } }

/* Ten complete rows, with only horizontal table scrolling. */
.record-scroll[data-visible-rows="1"] { height: 140rpx; }
.record-scroll[data-visible-rows="2"] { height: 214rpx; }
.record-scroll[data-visible-rows="3"] { height: 288rpx; }
.record-scroll[data-visible-rows="4"] { height: 362rpx; }
.record-scroll[data-visible-rows="5"] { height: 436rpx; }
.record-scroll[data-visible-rows="6"] { height: 510rpx; }
.record-scroll[data-visible-rows="7"] { height: 584rpx; }
.record-scroll[data-visible-rows="8"] { height: 658rpx; }
.record-scroll[data-visible-rows="9"] { height: 732rpx; }
.record-scroll[data-visible-rows="10"] { height: 806rpx; }
.record-row .list-row-number { width: 64rpx; padding-left: 10rpx; padding-right: 10rpx; color: #7c7062; font-variant-numeric: tabular-nums; }
.table-pagination.customer-pagination { width: 100%; min-width: 0; display: flex; flex-direction: column; align-items: center; gap: 14rpx; margin-top: 18rpx; }
.customer-page-controls { width: 100%; min-width: 0; display: grid; grid-template-columns: 144rpx minmax(0, 1fr) 144rpx; align-items: center; gap: 12rpx; }
.customer-page-controls > text { min-width: 0; height: 80rpx; display: flex; align-items: center; justify-content: center; font-variant-numeric: tabular-nums; line-height: 1; white-space: nowrap; }
.customer-pagination button { width: 144rpx; min-width: 0; max-width: 100%; height: 80rpx; min-height: 80rpx; display: flex; align-items: center; justify-content: center; margin: 0; padding: 0 12rpx; box-sizing: border-box; border-radius: 12rpx; font-size: inherit; line-height: 1; white-space: nowrap; }
.customer-pagination .customer-page-jump { min-width: 0; max-width: 100%; display: grid; grid-template-columns: auto 112rpx auto 144rpx; align-items: center; justify-content: center; gap: 12rpx; white-space: nowrap; }
.customer-pagination .customer-page-jump input { width: 112rpx; min-width: 0; height: 80rpx; min-height: 80rpx; padding: 0 12rpx; box-sizing: border-box; font-size: inherit; }
.customer-pagination .customer-page-jump input { color: #302a22; background: #fff; border: 1rpx solid #dcc8a6; border-radius: 11rpx; text-align: center; font-variant-numeric: tabular-nums; }
.customer-page-jump button { color: #fffdf8; background: #6f532e; border-color: #6f532e; }
.customer-pagination button[disabled] { color: #9b9082; background: #f4eee5; border-color: #dfcfb4; opacity: 1; }
@media (min-width: 700px) {
  .balance-table { width: 100%; table-layout: fixed; }
  .balance-table-row text { padding-left: 2px; padding-right: 2px; font-size: 14px; white-space: normal; overflow-wrap: anywhere; }
  .table-pagination.customer-pagination { flex-direction: row; justify-content: center; gap: 16px; margin-top: 16px; font-size: 14px; }
  .customer-page-controls { width: auto; grid-template-columns: 80px auto 80px; gap: 10px; }
  .customer-page-controls > text { min-width: 96px; height: 42px; }
  .customer-pagination button { width: 80px; height: 42px; min-height: 42px; padding: 0 12px; border-width: 1px; border-radius: 8px; }
  .customer-pagination .customer-page-jump { grid-template-columns: auto 72px auto 80px; gap: 8px; }
  .customer-pagination .customer-page-jump input { width: 72px; height: 42px; min-height: 42px; padding: 0 8px; border-width: 1px; border-radius: 8px; }
  .record-scroll[data-visible-rows="1"] { height: 100px; }
  .record-scroll[data-visible-rows="2"] { height: 152px; }
  .record-scroll[data-visible-rows="3"] { height: 204px; }
  .record-scroll[data-visible-rows="4"] { height: 256px; }
  .record-scroll[data-visible-rows="5"] { height: 308px; }
  .record-scroll[data-visible-rows="6"] { height: 360px; }
  .record-scroll[data-visible-rows="7"] { height: 412px; }
  .record-scroll[data-visible-rows="8"] { height: 464px; }
  .record-scroll[data-visible-rows="9"] { height: 516px; }
  .record-scroll[data-visible-rows="10"] { height: 568px; }
  .record-row .list-row-number { width: 44px; padding-left: 8px; padding-right: 8px; }
}
