.profile-top { display: flex; align-items: center; gap: 22rpx; margin-bottom: 24rpx; }
.profile-name { min-width: 0; flex: 1; }
.profile-name text { display: block; }
.profile-name > text:first-child { overflow: hidden; font-size: 36rpx; font-weight: 850; text-overflow: ellipsis; white-space: nowrap; }
.profile-name .profile-sub { margin-top: 7rpx; color: #63778d; font-size: 22rpx; }
.save-note { width: 100%; margin: 16rpx 0 0; }
.balance-row { display: flex; align-items: center; justify-content: space-between; gap: 18rpx; padding: 19rpx 0; border-top: 1rpx solid #e4ecf4; }
.balance-row:first-of-type { border-top: 0; }
.balance-name, .balance-code { display: block; }
.balance-name { font-weight: 800; }
.balance-code { margin-top: 5rpx; color: #6d8094; font-size: 21rpx; }
.balance-count { color: #145ca7; font-size: 31rpx; font-weight: 850; }
.history-tabs { margin-bottom: 16rpx; }
.history-tabs button { padding: 0 8rpx; }
.record-scroll { width: 100%; overflow: hidden; border: 1rpx solid #e4e8ef; border-radius: 14rpx; }
.record-table { width: 1300rpx; min-width: 1300rpx; background: #fff; }
.record-row { min-height: 76rpx; display: grid; grid-template-columns: 310rpx 280rpx 260rpx 180rpx 270rpx; align-items: center; border-top: 1rpx solid #e4e8ef; }
.record-row:first-child { border-top: 0; }
.record-row text { min-width: 0; padding: 14rpx 16rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.record-head { min-height: 66rpx; color: #52647a; background: #f3f6f9; font-size: 22rpx; font-weight: 800; }
.record-code { color: #1f5eff; font-weight: 800; }
.photo-placeholder { display: flex; align-items: center; justify-content: center; padding: 10rpx; color: #587089; background: #edf3f9; font-size: 20rpx; line-height: 1.3; text-align: center; }
.photo-actions { margin-top: 20rpx; }
.record-link { color: #1f5eff; font-weight: 800; text-decoration: underline; }
