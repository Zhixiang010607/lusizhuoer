.profile-card { padding-bottom: 24rpx; }
.profile-top { display: flex; align-items: center; gap: 20rpx; margin-bottom: 16rpx; }
.profile-name { min-width: 0; flex: 1; }
.profile-name text { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.profile-name > text:first-child { font-size: 36rpx; font-weight: 850; }
.profile-name .profile-sub { margin-top: 6rpx; color: #7c7062; font-size: 22rpx; }
.photo-placeholder { display: flex; align-items: center; justify-content: center; padding: 10rpx; color: #74695c; background: #f5ead8; font-size: 20rpx; line-height: 1.3; text-align: center; }
.profile-facts { grid-template-columns: repeat(3, minmax(0, 1fr)); margin-top: 18rpx; }
.profile-facts .fact { padding: 14rpx 8rpx; text-align: center; }
.profile-facts .value { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.subsection-title { margin: 22rpx 0 12rpx; font-size: 27rpx; font-weight: 850; }
.recent-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10rpx; }
.recent-item { min-width: 0; min-height: 104rpx; display: flex; flex-direction: column; justify-content: center; padding: 14rpx 16rpx; background: #fff7eb; border: 1rpx solid #eadcc6; border-radius: 14rpx; }
.recent-item > text:first-child { color: #7c7062; font-size: 21rpx; }
.recent-item > text:last-child { margin-top: 8rpx; overflow: hidden; font-weight: 800; text-overflow: ellipsis; white-space: nowrap; }
.status-item { justify-content: flex-start; }
.status-line { min-width: 0; display: flex; align-items: center; gap: 10rpx; margin-top: 7rpx; }
.status-badge { flex: none; padding: 5rpx 11rpx; border-radius: 999rpx; font-size: 20rpx; font-weight: 800; white-space: nowrap; }
.status-badge.active { color: #426b55; background: #e7f2e9; }
.status-badge.archived { color: #934d43; background: #f8e7e3; }
.status-line button { min-width: 0; flex: 1; min-height: 54rpx; display: flex; align-items: center; justify-content: center; margin: 0; padding: 0 10rpx; border-radius: 10rpx; font-size: 20rpx; font-weight: 800; line-height: 1.2; white-space: nowrap; }
.status-activate { color: #426b55; background: #e7f2e9; border: 1rpx solid #b8d5c0; }
.status-archive { color: #934d43; background: #f8e7e3; border: 1rpx solid #e1bab2; }

.section-message { margin-top: 12rpx; padding: 12rpx 14rpx; color: #48705b; background: #edf5ee; border-radius: 10rpx; font-size: 21rpx; line-height: 1.45; }
.section-message.error { color: #9a302b; background: #fff0ee; }

.notes-card, .messages-card { background: linear-gradient(180deg, #fffaf3 0%, #fff6e8 100%); border-color: #dcc49c; }
.notes-title { align-items: center; }
.notes-actions { min-width: 0; display: flex; align-items: center; gap: 8rpx; }
.notes-actions button { width: auto; min-width: 94rpx; min-height: 54rpx; display: flex; align-items: center; justify-content: center; margin: 0; padding: 0 14rpx; border-radius: 10rpx; font-size: 21rpx; font-weight: 800; line-height: 1.2; }
.small-action { color: #fff; background: #76592f; }
.small-action[disabled] { color: #9b9082; background: #e7ddce; }
.ghost-action { color: #76592f; background: #fff; border: 1rpx solid #d8bc8c; }
.notes-read { width: 100%; height: 220rpx; box-sizing: border-box; padding: 18rpx 20rpx; overflow: hidden; background: #fff7eb; border: 1rpx solid #d8bc8c; border-radius: 14rpx; }
.notes-read text { width: 100%; display: block; color: #302a22; font-size: 24rpx; line-height: 1.6; white-space: pre-wrap; word-break: break-word; }
.notes-input { height: 220rpx; min-height: 220rpx; padding: 18rpx 20rpx; background: #fff7eb; border-color: #d8bc8c; }
.character-count { margin-top: 7rpx; color: #8a7d6d; font-size: 20rpx; text-align: right; }
.character-count.limit { color: #99574b; font-weight: 800; }

.message-list { width: 100%; max-height: 620rpx; box-sizing: border-box; display: grid; gap: 10rpx; overflow-y: auto; }
.message-item { min-width: 0; padding: 15rpx 17rpx; background: #f9edda; border: 1rpx solid #dfc69e; border-radius: 14rpx; }
.message-meta { min-width: 0; display: flex; align-items: baseline; gap: 10rpx; }
.message-author { min-width: 0; flex: 1; overflow: hidden; font-size: 22rpx; font-weight: 800; text-overflow: ellipsis; white-space: nowrap; }
.message-time { flex: none; color: #8a7d6d; font-size: 19rpx; white-space: nowrap; }
.message-content { display: block; margin-top: 9rpx; color: #3c342a; font-size: 23rpx; line-height: 1.55; white-space: pre-wrap; word-break: break-word; }
.message-empty { min-height: 120rpx; display: flex; align-items: center; justify-content: center; color: #7c7062; background: #f9edda; border: 1rpx dashed #d8bc8c; border-radius: 14rpx; font-size: 22rpx; }
.load-message-button, .load-history-button { width: auto; min-width: 190rpx; min-height: 62rpx; display: flex; align-items: center; justify-content: center; margin: 14rpx auto 0; padding: 0 20rpx; font-size: 22rpx; line-height: 1.2; }
.message-compose { min-width: 0; display: flex; flex-direction: column; align-items: stretch; gap: 12rpx; margin-top: 16rpx; padding: 16rpx; background: #f5ead8; border: 1rpx solid #dfc69e; border-radius: 18rpx; }
.message-input-wrap { width: 100%; min-width: 0; }
.message-input-wrap .character-count { width: 100%; display: block; text-align: right; }
.message-input { height: 126rpx; min-height: 126rpx; padding: 14rpx 17rpx; background: #fffaf3; border-color: #d8bc8c; font-size: 23rpx; }
.submit-message-button { width: 100%; min-height: 64rpx; display: flex; align-items: center; justify-content: center; margin: 0; padding: 0 14rpx; font-size: 21rpx; line-height: 1.2; text-align: center; }

.table-scroll { width: 100%; overflow: hidden; border: 1rpx solid #dfcfb4; border-radius: 14rpx; }
.balance-table { width: 660rpx; min-width: 660rpx; background: #fffaf3; }
.balance-table-row { width: 660rpx; min-height: 74rpx; display: grid; grid-template-columns: 240rpx 140rpx 140rpx 140rpx; border-top: 1rpx solid #dfcfb4; }
.balance-table-row:first-child { border-top: 0; }
.balance-table-row text, .record-row text { width: 100%; min-width: 0; display: flex; align-items: center; justify-content: center; justify-self: stretch; overflow: hidden; text-align: center; text-overflow: ellipsis; white-space: nowrap; }
.balance-table-row text { min-height: 74rpx; padding: 12rpx 8rpx; font-size: 21rpx; }
.retail-summary-hint { display: block; margin: -4rpx 0 10rpx; color: #7c7062; font-size: 18rpx; text-align: right; }
.retail-summary-scroll { width: 100%; box-sizing: border-box; overflow: hidden; border: 1rpx solid #dfcfb4; border-radius: 16rpx; background: #fffaf3; }
.retail-summary-table { width: 100%; min-width: 0; background: #fffaf3; }
.retail-summary-row { height: 76rpx; min-height: 76rpx; display: grid; grid-template-columns: minmax(0, 1.4fr) repeat(2, minmax(110rpx, .8fr)); border-top: 1rpx solid #eadfce; }
.retail-summary-row:first-child { border-top: 0; }
.retail-summary-row.table-head { height: 68rpx; min-height: 68rpx; }
.retail-summary-row text { min-width: 0; display: flex; align-items: center; justify-content: center; overflow: hidden; padding: 10rpx 8rpx; font-size: 21rpx; text-align: center; text-overflow: ellipsis; white-space: nowrap; }
.retail-summary-row .retail-count { color: #74592d; font-size: 23rpx; font-weight: 850; }
.table-head { color: #675b4b; background: #f5ead8; font-weight: 800; }
.balance-count { color: #76592f; font-weight: 850; }

.history-tabs { grid-template-columns: repeat(5, minmax(0, 1fr)); margin-bottom: 14rpx; }
.history-tabs button { min-width: 0; display: flex; align-items: center; justify-content: center; padding: 0 6rpx; font-size: 22rpx; line-height: 1.2; text-align: center; white-space: nowrap; }
.record-table { width: 100%; background: #fffaf3; }
.record-table.recharge-history, .record-table.recharge-history .record-row { min-width: 1020rpx; }
.record-table.compact-history, .record-table.compact-history .record-row { min-width: 950rpx; }
.record-row { width: 100%; min-height: 76rpx; display: grid; border-top: 1rpx solid #dfcfb4; }
.recharge-history .record-row { grid-template-columns: minmax(210rpx, 1.35fr) minmax(130rpx, 0.8fr) minmax(130rpx, 0.8fr) minmax(90rpx, 0.55fr) minmax(230rpx, 1.15fr) minmax(230rpx, 1.3fr); }
.compact-history .record-row { grid-template-columns: minmax(210rpx, 1.4fr) minmax(130rpx, 0.85fr) minmax(130rpx, 0.85fr) minmax(90rpx, 0.6fr) minmax(230rpx, 1.2fr) minmax(160rpx, 1fr); }
.record-row:first-child { border-top: 0; }
.record-row text { min-height: 76rpx; padding: 12rpx 9rpx; font-size: 21rpx; }
.record-row.table-head { min-height: 66rpx; }
.record-row.table-head text { min-height: 66rpx; }
.record-link { color: #76592f; font-weight: 850; text-decoration: underline; }
.history-pagination { min-height: 8rpx; display: flex; justify-content: center; }
