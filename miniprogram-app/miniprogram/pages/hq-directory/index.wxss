page { min-height: 100%; color: #302a22; background: #f3ede2; }
.page { width: calc(100% - 28rpx); min-height: 100vh; margin: 0 auto; padding: 16rpx 0 40rpx; overflow-x: hidden; }
.page-heading { margin: 8rpx 6rpx 20rpx; }
.title { font-family: Georgia, "Times New Roman", serif; font-size: 40rpx; font-weight: 800; }
.search-panel, .table-section { width: 100%; min-width: 0; margin-bottom: 16rpx; padding: 24rpx; background: #fffaf3; border: 1rpx solid #dfcfb4; border-radius: 24rpx; box-sizing: border-box; box-shadow: 0 12rpx 34rpx rgba(93,72,39,.08); }
.search-fields { display: grid; grid-template-columns: minmax(0, 1fr); gap: 16rpx; }
.search-fields label { min-width: 0; display: flex; flex-direction: column; gap: 9rpx; }
.search-fields label > text { color: #554a3c; font-size: 24rpx; font-weight: 800; }
.search-fields input { width: 100%; min-height: 80rpx; padding: 0 20rpx; color: #302a22; background: #fff; border: 1rpx solid #d8c5a3; border-radius: 15rpx; box-sizing: border-box; font-size: 26rpx; }
.search-actions { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12rpx; margin-top: 18rpx; }
.search-actions button { width: 100%; min-width: 0; min-height: 74rpx; display: flex; align-items: center; justify-content: center; margin: 0; border-radius: 14rpx; box-sizing: border-box; font-size: 24rpx; font-weight: 800; line-height: 1; }
.primary { color: #fffdf8; background: #6f532e; }
.secondary { color: #74592d; background: #fff; border: 1rpx solid #d7c39f; }
.section-heading { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin-bottom: 16rpx; }
.section-heading > text:first-child { font-size: 28rpx; font-weight: 850; }
.section-heading > text:last-child { padding: 6rpx 12rpx; color: #74592d; background: #f4e7d0; border-radius: 999rpx; font-size: 24rpx; font-weight: 800; }
.table-scroll { width: 100%; max-width: 100%; min-width: 0; overflow-x: auto; overflow-y: hidden; box-sizing: border-box; }
.table-scroll[data-visible-rows="1"] { height: 146rpx; }
.table-scroll[data-visible-rows="2"] { height: 224rpx; }
.table-scroll[data-visible-rows="3"] { height: 302rpx; }
.table-scroll[data-visible-rows="4"] { height: 380rpx; }
.table-scroll[data-visible-rows="5"] { height: 458rpx; }
.table-scroll[data-visible-rows="6"] { height: 536rpx; }
.table-scroll[data-visible-rows="7"] { height: 614rpx; }
.table-scroll[data-visible-rows="8"] { height: 692rpx; }
.table-scroll[data-visible-rows="9"] { height: 770rpx; }
.table-scroll[data-visible-rows="10"] { height: 848rpx; }
.data-table { width: auto; min-width: 100%; display: inline-table; table-layout: auto; border-collapse: collapse; background: #fff; }
.table-row { display: table-row; font-variant-numeric: tabular-nums; }
.table-row > text { height: 78rpx; display: table-cell; padding: 10rpx 18rpx; box-sizing: border-box; vertical-align: middle; border-top: 1rpx solid #eadfce; font-size: 24rpx; line-height: 1.25; text-align: center; white-space: nowrap; }
.table-row:first-child > text { border-top: 0; }
.table-head { height: 68rpx; color: #5a4e3e; background: #f4e8d4; font-weight: 850; }
.table-head > text { height: 68rpx; }
.link { color: #74592d; font-weight: 850; text-decoration: underline; }
.status { display: inline-flex; align-items: center; justify-content: center; padding: 5rpx 11rpx; border-radius: 999rpx; font-size: inherit; font-weight: 800; }
.status.active { color: #4f6f5d; background: #e9f1ec; }
.status.archived { color: #8b4a40; background: #f8e8e4; }
.danger-button { color: #8b4a40; border-color: #dbb5a9; background: #fff8f5; }
.table-empty { min-width: 100%; padding: 40rpx 20rpx; color: #887c6d; font-size: 24rpx; line-height: 1.6; text-align: left; white-space: normal; overflow-wrap: anywhere; }
.archived-section { background: #fff8f3; border-color: #e1c9bc; }
.message { margin-bottom: 16rpx; padding: 17rpx 20rpx; border-radius: 16rpx; font-size: 24rpx; line-height: 1.5; }
.message.error { color: #8b3f35; background: #fff1ed; border: 1rpx solid #e4bdb4; }
.message.success { color: #4f664f; background: #f0f6ec; border: 1rpx solid #c9dbc0; }
.safe-bottom { height: calc(24rpx + env(safe-area-inset-bottom)); }
.directory-pagination { width: 100%; min-width: 0; display: flex; flex-direction: column; align-items: center; gap: 16rpx; margin-top: 20rpx; color: #74592d; text-align: center; font-size: 24rpx; }
.directory-page-controls { width: 100%; min-width: 0; display: grid; grid-template-columns: 144rpx minmax(0, 1fr) 144rpx; align-items: center; gap: 12rpx; }
.directory-pagination button { width: 144rpx; min-width: 0; max-width: 100%; height: 80rpx; min-height: 80rpx; margin: 0; padding: 0 16rpx; display: flex; align-items: center; justify-content: center; box-sizing: border-box; border-radius: 12rpx; color: #74592d; background: #fff; border: 1rpx solid #d8c5a3; font-size: inherit; font-weight: 700; line-height: 1; white-space: nowrap; }
.directory-page-status { min-width: 0; height: 80rpx; display: flex; align-items: center; justify-content: center; font-variant-numeric: tabular-nums; line-height: 1.25; white-space: nowrap; }
.directory-page-jump { min-width: 0; max-width: 100%; display: grid; grid-template-columns: auto 112rpx auto 144rpx; align-items: center; justify-content: center; gap: 12rpx; white-space: nowrap; }
.directory-page-jump input { width: 112rpx; min-width: 0; height: 80rpx; min-height: 80rpx; margin: 0; padding: 0 12rpx; box-sizing: border-box; color: #302a22; text-align: center; border: 1rpx solid #d8c5a3; border-radius: 12rpx; background: #fff; font-size: inherit; }
.directory-pagination .directory-jump-button { color: #fffdf8; background: #6f532e; border-color: #6f532e; }
.directory-pagination button[disabled] { color: #9b9082; background: #f4eee5; border-color: #dfcfb4; opacity: 1; }
.directory-page-jump input[disabled] { color: #9b9082; background: #f4eee5; }
@media (min-width: 700px) {
  .directory-pagination { flex-direction: row; justify-content: center; gap: 16px; margin-top: 16px; font-size: 14px; }
  .directory-page-controls { width: auto; grid-template-columns: 80px auto 80px; gap: 10px; }
  .directory-pagination button { width: 80px; height: 42px; min-height: 42px; padding: 0 12px; border-width: 1px; border-radius: 8px; }
  .directory-page-status { min-width: 96px; height: 42px; }
  .directory-page-jump { grid-template-columns: auto 72px auto 80px; gap: 8px; }
  .directory-page-jump input { width: 72px; height: 42px; min-height: 42px; padding: 0 8px; border-width: 1px; border-radius: 8px; }
}

@media (min-width: 700px) {
  .page { width: calc(100% - 48px); max-width: 1120px; padding: 20px 0 36px; }
  .page-heading { margin: 0 4px 16px; }
  .title { font-size: 28px; }
  .search-panel, .table-section { margin-bottom: 16px; padding: 20px; border-width: 1px; border-radius: 20px; box-shadow: 0 8px 24px rgba(93,72,39,.08); }
  .search-fields { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
  .search-fields label { gap: 7px; }
  .search-fields label > text { font-size: 14px; }
  .search-fields input { min-height: 48px; padding: 0 16px; border-width: 1px; border-radius: 12px; font-size: 15px; }
  .search-actions { gap: 12px; margin-top: 16px; }
  .search-actions button { min-height: 48px; border-width: 1px; border-radius: 12px; font-size: 15px; }
  .section-heading { gap: 14px; margin-bottom: 14px; }
  .section-heading > text:first-child { font-size: 22px; }
  .section-heading > text:last-child { padding: 5px 10px; font-size: 14px; }
  .table-scroll[data-visible-rows="1"] { height: 108px; }
  .table-scroll[data-visible-rows="2"] { height: 164px; }
  .table-scroll[data-visible-rows="3"] { height: 220px; }
  .table-scroll[data-visible-rows="4"] { height: 276px; }
  .table-scroll[data-visible-rows="5"] { height: 332px; }
  .data-table { width: auto; min-width: 100%; }
  .table-row > text { height: 56px; padding: 8px 12px; border-width: 1px; font-size: 14px; }
  .table-head, .table-head > text { height: 52px; }
  .status { padding: 4px 8px; font-size: inherit; }
  .table-empty { padding: 28px 16px; font-size: 14px; }
  .message { margin-bottom: 16px; padding: 12px 14px; border-width: 1px; border-radius: 10px; font-size: 14px; }
}

@media (min-width: 700px) {
  .table-scroll[data-visible-rows="6"] { height: 388px; }
  .table-scroll[data-visible-rows="7"] { height: 444px; }
  .table-scroll[data-visible-rows="8"] { height: 500px; }
  .table-scroll[data-visible-rows="9"] { height: 556px; }
  .table-scroll[data-visible-rows="10"] { height: 612px; }
}

.search-actions.single { grid-template-columns: minmax(0, 1fr); }
