<view class="workspace-page">
  <view class="workspace-topbar detail-topbar">
    <view class="detail-heading-block"><button class="back-button" bindtap="back"><text>‹ 返回老师管理</text></button><text class="topbar-title">老师主页</text></view>
  </view>
  <view class="workspace-main">
    <view wx:if="{{message}}" class="form-message {{error ? 'error' : ''}}">{{message}}</view>
    <view wx:if="{{loading && !staff}}" class="web-panel empty">正在读取老师数据库…</view>
    <block wx:if="{{staff}}">
      <view class="teacher-section-tabs" role="tablist">
        <button class="teacher-section-tab {{activeSection === 'basic' ? 'active' : ''}}" data-section="basic" bindtap="switchSection">基本资料</button>
        <button class="teacher-section-tab {{activeSection === 'configuration' ? 'active' : ''}}" data-section="configuration" bindtap="switchSection">项目配置</button>
        <button class="teacher-section-tab {{activeSection === 'work' ? 'active' : ''}}" data-section="work" bindtap="switchSection">考勤日报</button>
      </view>

      <view wx:if="{{activeSection === 'basic'}}" class="teacher-detail-grid">
        <view class="teacher-detail-sidebar">
          <view class="web-panel profile-hero teacher-profile-hero">
            <view class="profile-avatar">{{profile.initials}}</view>
            <view class="profile-copy">
              <text class="profile-type">老师档案</text>
              <view class="profile-title-row"><text>{{profile.name}}</text><text class="store-status-badge {{profile.archived ? 'archived' : ''}}">{{profile.archived ? '封存' : '活跃'}}</text></view>
              <view class="teacher-profile-meta"><text>编号 {{profile.code}}</text><text>电话 {{profile.phone}}</text></view>
            </view>
          </view>
          <view class="web-panel security-panel">
            <view class="panel-heading"><view><text class="panel-title">老师账号管理</text></view></view>
            <view class="field"><text class="field-label">新临时密码</text><view class="temporary-password-control"><input class="input" password="{{!newPasswordVisible}}" maxlength="32" value="{{newPassword}}" data-field="newPassword" bindinput="input" placeholder="请输入新临时密码" disabled="{{mutating || !profile.authUid}}" /><button class="temporary-password-toggle" bindtap="toggleNewPassword" aria-label="{{newPasswordVisible ? '隐藏新临时密码' : '显示新临时密码'}}" disabled="{{mutating || !profile.authUid}}">{{newPasswordVisible ? '隐藏' : '显示'}}</button></view></view>
            <text class="field-help">8–32 位，以字母或数字开头；大写、小写、数字、特殊字符中至少含三类。</text>
            <view class="button-row"><button class="secondary" bindtap="resetPassword" loading="{{mutating === 'password'}}" disabled="{{mutating || !profile.authUid}}">保存新临时密码</button><button class="{{profile.archived ? 'secondary' : 'danger'}}" bindtap="toggleStatus" loading="{{mutating === 'status'}}" disabled="{{mutating}}">{{profile.archived ? '激活老师' : '封存老师'}}</button></view>
          </view>
        </view>
        <view class="web-panel face-reenroll-panel">
          <view class="panel-heading"><view><text class="panel-title">重新扫脸</text><text class="panel-note">仅覆盖本人考勤人脸档案，不影响登录、客户人脸、业务核销或历史打卡</text></view><text class="web-badge">总部现场办理</text></view>
          <view wx:if="{{profile.archived}}" class="face-disabled-note">老师已封存；请先激活老师，再现场重新录入考勤人脸。</view>
          <camera-capture wx:else id="attendance-face-capture" title="老师考勤人脸照片" bindchange="faceCaptureChange" />
          <checkbox-group wx:if="{{!profile.archived}}" class="face-consent" bindchange="faceConsentChange"><label><checkbox value="consent" checked="{{faceConsent}}" color="#80602c"/><text>已取得老师明确授权：用本次现场建档照覆盖原考勤人脸档案，仅用于本人上下班打卡验证。</text></label></checkbox-group>
          <button wx:if="{{!profile.archived}}" class="primary face-replace-button" bindtap="replaceAttendanceFace" loading="{{mutating === 'face'}}" disabled="{{mutating || !faceCaptureReady || !faceConsent}}">验证照片并重新扫脸</button>
        </view>
      </view>

      <view wx:if="{{activeSection === 'configuration'}}" class="configuration-section">
        <view class="web-panel experience-panel experience-overview-panel">
          <view class="panel-heading"><view><text class="panel-title">配置项目当月汇总</text><text class="panel-note monthly-summary-note">按上海自然月分别统计；删除后重新配置不会清空已完成体验</text></view><text class="web-badge">{{profile.archived ? '老师已封存 · 仅可查询' : overview.activeProducts + ' 个配置项目'}}</text></view>
          <text wx:if="{{entitlements.length}}" class="monthly-scroll-hint">左右滑动查看完整额度</text>
          <scroll-view wx:if="{{entitlements.length}}" class="monthly-overview-scroll" scroll-x enhanced style="height: {{entitlements.length * 84 + 2}}px;"><view class="monthly-overview-grid"><view wx:for="{{entitlements}}" wx:key="productId" class="monthly-overview-card"><view class="monthly-project-head"><text>{{item.productName}}</text><text>{{item.productCode || '—'}}</text></view><view class="monthly-metric"><text>基础额度</text><text>{{item.monthlyAllowance}} 次</text></view><view class="monthly-metric"><text>单独充值</text><text>{{item.monthlyRechargeCount}} 次</text></view><view class="monthly-metric"><text>已体验</text><text>{{item.monthlyExperienceCount}} 次</text></view><view class="monthly-metric monthly-available"><text>当前可用</text><text>{{item.availableCount}} 次</text></view></view></view></scroll-view>
          <view wx:else class="empty monthly-overview-empty">尚未配置体验项目</view>
        </view>
        <view class="web-panel experience-panel experience-project-panel">
          <view class="subsection"><text class="subsection-title">项目体验汇总</text><view class="summary-grid"><view wx:for="{{summaryRows}}" wx:key="productId" class="summary-item"><view><text>{{item.productName}}</text><text>{{item.productCode}}</text></view><view><text>{{item.totalDisplay}}</text><text>累计完成体验</text></view></view><view wx:if="{{!summaryRows.length}}" class="empty">暂无项目体验数据</view></view></view>
          <view class="subsection"><text class="subsection-title">已配置产品</text><view class="quota-grid"><view wx:for="{{entitlements}}" wx:key="productId" class="quota-card {{item.monthlyAllowance >= 10000000 || item.monthlyExperienceCount >= 10000000 ? 'large-counts' : ''}}"><view class="quota-head"><view><text>{{item.productName}}</text><text>{{item.productCode}}</text></view><view class="quota-actions"><button class="ghost delete-configuration" data-id="{{item.productId}}" bindtap="deleteConfiguration" loading="{{mutating === 'delete:' + item.productId}}" disabled="{{mutating || profile.archived || item.productArchived}}">删除配置</button></view></view><view class="quota-balance"><text>当前可用</text><text>{{item.availableCount}}<text class="unit">次</text></text></view><view class="quota-facts"><view><text>每月基础</text><text>{{item.monthlyAllowance}} 次</text></view><view><text>本月已体验</text><text>{{item.monthlyExperienceCount}} 次</text></view></view></view><view wx:if="{{!entitlements.length}}" class="empty">尚未配置体验产品</view></view></view>
        </view>
        <view class="web-panel experience-panel experience-operations-panel">
          <view class="forms-grid">
            <view class="action-form"><text class="subsection-title">配置新产品</text><label class="field"><text class="field-label">活跃产品</text><picker range="{{configureLabels}}" value="{{configureIndex}}" bindchange="chooseConfigureProduct" disabled="{{mutating || profile.archived || !configureProducts.length}}"><view class="picker"><text class="picker-value">{{configureLabels[configureIndex] || '没有可新增的活跃产品'}}</text></view></picker></label><label class="field"><text class="field-label">每月基础体验次数</text><input class="input" type="number" value="{{monthlyAllowance}}" data-field="monthlyAllowance" bindinput="input" placeholder="0 至 99,999" disabled="{{mutating || profile.archived}}" /></label><button class="primary" bindtap="saveConfiguration" loading="{{mutating === 'configure'}}" disabled="{{mutating || profile.archived || !configureProducts.length}}">保存体验额度</button></view>
            <view class="action-form"><text class="subsection-title">单独充值体验次数</text><view wx:if="{{rechargePending}}" class="pending-recharge"><text>有一笔体验充值结果待数据库确认，当前禁止建立新充值。</text><button class="secondary" bindtap="recoverRecharge" loading="{{mutating === 'recharge'}}" disabled="{{mutating}}">确认上次充值结果</button></view><label class="field"><text class="field-label">已配置活跃产品</text><picker range="{{rechargeLabels}}" value="{{rechargeIndex}}" bindchange="chooseRechargeProduct" disabled="{{mutating || rechargePending || profile.archived || !rechargeProducts.length}}"><view class="picker"><text class="picker-value">{{rechargeLabels[rechargeIndex] || '尚无可充值产品'}}</text></view></picker></label><label class="field"><text class="field-label">充值次数</text><input class="input" type="number" value="{{rechargeCount}}" data-field="rechargeCount" bindinput="input" placeholder="1 至 99,999" disabled="{{mutating || rechargePending || profile.archived}}" /></label><label class="field"><text class="field-label">充值说明（可选）</text><textarea class="textarea" maxlength="500" value="{{rechargeNote}}" data-field="rechargeNote" bindinput="input" placeholder="填写本次充值说明" disabled="{{mutating || rechargePending || profile.archived}}" /></label><button class="primary" bindtap="recharge" loading="{{mutating === 'recharge'}}" disabled="{{mutating || rechargePending || profile.archived || !rechargeProducts.length}}">确认充值体验次数</button></view>
          </view>
          <view class="subsection history-section"><view class="history-heading"><text class="subsection-title">额度变更记录</text><text class="history-count">{{history.length}} 条</text></view><scroll-view wx:if="{{history.length}}" class="history-list" scroll-y enhanced show-scrollbar="false"><view wx:for="{{history}}" wx:key="key" class="history-row"><view><text>{{item.type}}</text><text>{{item.productName}}{{item.productCode ? ' · ' + item.productCode : ''}}</text><text wx:if="{{item.note}}">{{item.note}}</text></view><view><text>{{item.countText}}</text><text>{{item.at}}</text><text>{{item.actorName}}</text></view></view></scroll-view><view wx:else class="empty">暂无额度变更记录</view></view>
        </view>
      </view>

      <view wx:if="{{activeSection === 'work'}}" class="work-section">
        <view class="work-mode-tabs"><button class="work-mode-tab {{workMode === 'attendance' ? 'active' : ''}}" data-mode="attendance" bindtap="switchWorkMode">考勤月历</button><button class="work-mode-tab {{workMode === 'report' ? 'active' : ''}}" data-mode="report" bindtap="switchWorkMode">日报月历</button></view>
        <view class="web-panel calendar-panel">
          <picker class="calendar-month-picker" mode="date" fields="month" value="{{workMonth}}" end="{{workMonthPickerEnd}}" bindchange="chooseWorkMonth" disabled="{{workLoading}}"><view><text>{{workMonthTitle}}</text><text>点此直接选择年月</text></view></picker>
          <view class="calendar-toolbar"><button data-delta="-12" bindtap="changeWorkMonth" disabled="{{workLoading}}">上一年</button><button data-delta="-1" bindtap="changeWorkMonth" disabled="{{workLoading}}">上月</button><button data-delta="1" bindtap="changeWorkMonth" disabled="{{workLoading || !canNextWorkMonth}}">下月</button><button data-delta="12" bindtap="changeWorkMonth" disabled="{{workLoading || !canNextWorkYear}}">下一年</button></view>
          <view wx:if="{{workMode === 'attendance'}}" class="calendar-legend"><view><text class="status-dot done"></text><text>已打卡</text></view><view><text class="status-dot missing"></text><text>未打卡</text></view><view><text class="status-dot not-employed"></text><text>未入职</text></view><text>每格左点上班、右点下班</text></view>
          <view wx:else class="calendar-legend"><view><text class="status-dot done"></text><text>已写日报</text></view><view><text class="status-dot missing"></text><text>未写日报</text></view><view><text class="status-dot not-employed"></text><text>未入职</text></view></view>
          <view class="calendar-weekdays"><text wx:for="{{weekdays}}" wx:key="*this">{{item}}</text></view>
          <view wx:if="{{workLoading}}" class="calendar-loading">正在读取月度记录…</view>
          <view wx:else class="calendar-grid"><view wx:for="{{calendarDays}}" wx:key="key" class="calendar-day {{item.blank ? 'blank' : ''}} {{selectedWorkDate === item.date ? 'selected' : ''}} {{item.future ? 'future' : ''}} {{item.notEmployed ? 'not-employed' : ''}}" data-date="{{item.date}}" bindtap="selectWorkDate"><text wx:if="{{!item.blank}}" class="calendar-day-number">{{item.day}}</text><text wx:if="{{!item.blank && item.notEmployed}}" class="not-employed-label">未入职</text><view wx:elif="{{!item.blank && workMode === 'attendance'}}" class="attendance-dots"><text class="status-dot {{item.clockInState}}"></text><text class="status-dot {{item.clockOutState}}"></text></view><view wx:elif="{{!item.blank && workMode === 'report'}}" class="report-dot"><text class="status-dot {{item.reportState}}"></text></view></view></view>
        </view>

        <view wx:if="{{selectedWorkDay && workMode === 'attendance'}}" class="web-panel selected-day-panel">
          <view class="panel-heading"><view><text class="panel-title">{{selectedWorkDay.date}} 考勤详情</text><text class="panel-note">{{profile.name}} · {{profile.phone}}</text></view><text class="web-badge">{{selectedWorkDay.notEmployed ? '未入职' : selectedWorkDay.workDurationText}}</text></view>
          <view wx:if="{{selectedWorkDay.notEmployed}}" class="empty selected-report-empty">该日期老师尚未入职</view>
          <view wx:else class="attendance-detail-grid">
            <view class="attendance-detail-card"><text class="detail-kind">上班打卡</text><block wx:if="{{selectedWorkDay.clockIn}}"><text class="detail-time">{{selectedWorkDay.clockIn.timeText}}</text><text>{{selectedWorkDay.clockIn.placeName || '未解析附近地点'}}</text><text>{{selectedWorkDay.clockIn.formattedAddress || '暂无文字地址'}}</text><text>精度约 {{selectedWorkDay.clockIn.accuracy}} 米</text><button class="secondary" data-kind="clockIn" bindtap="openAttendanceMap">在地图中打开</button></block><text wx:else class="empty-detail">未打卡</text></view>
            <view class="attendance-detail-card"><text class="detail-kind">下班打卡</text><block wx:if="{{selectedWorkDay.clockOut}}"><text class="detail-time">{{selectedWorkDay.clockOut.timeText}}</text><text>{{selectedWorkDay.clockOut.placeName || '未解析附近地点'}}</text><text>{{selectedWorkDay.clockOut.formattedAddress || '暂无文字地址'}}</text><text>精度约 {{selectedWorkDay.clockOut.accuracy}} 米</text><button class="secondary" data-kind="clockOut" bindtap="openAttendanceMap">在地图中打开</button></block><text wx:else class="empty-detail">未打卡</text></view>
          </view>
        </view>

        <view wx:if="{{selectedWorkDay && workMode === 'report'}}" class="web-panel selected-day-panel">
          <view class="panel-heading"><view><text class="panel-title">{{selectedWorkDay.date}} 日报</text><text class="panel-note">{{profile.name}} · {{profile.phone}}</text></view><text class="web-badge">{{selectedWorkDay.notEmployed ? '未入职' : selectedWorkDay.report ? '已填写' : '未填写'}}</text></view>
          <view wx:if="{{selectedWorkDay.report}}" class="report-detail-list"><view><text>今日完成事项</text><text>{{selectedWorkDay.report.completedWork}}</text></view><view><text>客户与项目进展</text><text>{{selectedWorkDay.report.customerProjectProgress}}</text></view><view><text>问题与所需支持</text><text>{{selectedWorkDay.report.problemsAndSupport}}</text></view><view><text>明日计划</text><text>{{selectedWorkDay.report.tomorrowPlan}}</text></view></view>
          <view wx:else class="empty selected-report-empty">{{selectedWorkDay.notEmployed ? '该日期老师尚未入职' : '当天没有日报'}}</view>
        </view>
      </view>
    </block>
  </view>
  <view class="safe-bottom"></view>
  <view wx:if="{{faceResultToast}}" class="face-result-toast {{faceResultToastError ? 'error' : ''}}">{{faceResultToast}}</view>
</view>
