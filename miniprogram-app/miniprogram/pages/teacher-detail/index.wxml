<view class="workspace-page">
  <view class="workspace-topbar detail-topbar"><view><text class="topbar-title">{{profile.name || '老师'}} · 老师主页</text></view><button class="ghost back-button" bindtap="back">返回老师管理</button></view>
  <view class="workspace-main">
    <view wx:if="{{message}}" class="form-message {{error ? 'error' : ''}}">{{message}}</view>
    <view wx:if="{{loading && !staff}}" class="web-panel empty">正在读取老师数据库…</view>
    <block wx:if="{{staff}}">
      <view class="teacher-detail-grid">
        <view class="teacher-detail-sidebar">
          <view class="web-panel profile-hero teacher-profile-hero"><view class="profile-avatar">{{profile.initials}}</view><view class="profile-copy"><text class="profile-type">老师档案</text><view class="profile-title-row"><text>{{profile.name}}</text><text class="store-status-badge {{profile.archived ? 'archived' : ''}}">{{profile.archived ? '封存' : '活跃'}}</text></view><view class="teacher-profile-meta"><text>编号 {{profile.code}}</text><text>电话 {{profile.phone}}</text></view></view></view>
          <view class="web-panel security-panel"><view class="panel-heading"><view><text class="panel-title">老师账号管理</text></view></view><label class="field"><text class="field-label">新临时密码</text><input class="input" password maxlength="32" value="{{newPassword}}" data-field="newPassword" bindinput="input" placeholder="8–32 位，字母或数字开头，至少含三类字符" disabled="{{mutating || !profile.authUid}}" /></label><view class="button-row"><button class="secondary" bindtap="resetPassword" loading="{{mutating === 'password'}}" disabled="{{mutating || !profile.authUid}}">保存新临时密码</button><button class="{{profile.archived ? 'secondary' : 'danger'}}" bindtap="toggleStatus" loading="{{mutating === 'status'}}" disabled="{{mutating}}">{{profile.archived ? '激活老师' : '封存老师'}}</button></view></view>
        </view>
        <view class="web-panel experience-panel experience-overview-panel">
        <view class="panel-heading"><view><text class="panel-title">配置项目当月汇总</text><text class="panel-note monthly-summary-note">按上海自然月分别统计；删除后重新配置不会清空已完成体验</text></view><text class="web-badge">{{profile.archived ? '老师已封存 · 仅可查询' : overview.activeProducts + ' 个配置项目'}}</text></view>
        <view wx:if="{{entitlements.length}}" class="monthly-overview-grid"><view wx:for="{{entitlements}}" wx:key="productId" class="monthly-overview-card"><view class="monthly-project-head"><view><text>{{item.productName}}</text><text>{{item.productCode || '—'}}</text></view><text>本月</text></view><view class="monthly-metrics"><view><text>基础额度</text><text>{{item.monthlyAllowance}} 次</text></view><view><text>单独充值</text><text>{{item.monthlyRechargeCount}} 次</text></view><view><text>已体验</text><text>{{item.monthlyExperienceCount}} 次</text></view><view class="monthly-available"><text>当前可用</text><text>{{item.availableCount}} 次</text></view></view></view></view><view wx:else class="empty monthly-overview-empty">尚未配置体验项目</view>
        </view>
        <view class="web-panel experience-panel experience-project-panel">
        <view class="subsection"><text class="subsection-title">项目体验汇总</text><view class="summary-grid"><view wx:for="{{summaryRows}}" wx:key="productId" class="summary-item"><view><text>{{item.productName}}</text><text>{{item.productCode}}</text></view><view><text>{{item.totalDisplay}}</text><text>累计完成体验</text></view></view><view wx:if="{{!summaryRows.length}}" class="empty">暂无项目体验数据</view></view></view>
        <view class="subsection"><text class="subsection-title">已配置产品</text><view class="quota-grid"><view wx:for="{{entitlements}}" wx:key="productId" class="quota-card"><view class="quota-head"><view><text>{{item.productName}}</text><text>{{item.productCode}}</text></view><view class="quota-actions"><button class="ghost delete-configuration" data-id="{{item.productId}}" bindtap="deleteConfiguration" loading="{{mutating === 'delete:' + item.productId}}" disabled="{{mutating || profile.archived || item.productArchived}}">删除配置</button></view></view><view class="quota-balance"><text>当前可用</text><text>{{item.availableCount}}<text class="unit">次</text></text></view><view class="quota-facts"><view><text>每月基础</text><text>{{item.monthlyAllowance}} 次</text></view><view><text>本月已体验</text><text>{{item.monthlyExperienceCount}} 次</text></view></view></view><view wx:if="{{!entitlements.length}}" class="empty">尚未配置体验产品</view></view></view>
        </view>
        <view class="web-panel experience-panel experience-operations-panel">
        <view class="forms-grid">
          <view class="action-form"><text class="subsection-title">配置新产品</text><label class="field"><text class="field-label">活跃产品</text><picker range="{{configureLabels}}" value="{{configureIndex}}" bindchange="chooseConfigureProduct" disabled="{{mutating || profile.archived || !configureProducts.length}}"><view class="picker">{{configureLabels[configureIndex] || '没有可新增的活跃产品'}}</view></picker></label><label class="field"><text class="field-label">每月基础体验次数</text><input class="input" type="number" value="{{monthlyAllowance}}" data-field="monthlyAllowance" bindinput="input" placeholder="0 至 99,999" disabled="{{mutating || profile.archived}}" /></label><button class="primary" bindtap="saveConfiguration" loading="{{mutating === 'configure'}}" disabled="{{mutating || profile.archived || !configureProducts.length}}">保存体验额度</button></view>
          <view class="action-form"><text class="subsection-title">单独充值体验次数</text><view wx:if="{{rechargePending}}" class="pending-recharge"><text>有一笔体验充值结果待数据库确认，当前禁止建立新充值。</text><button class="secondary" bindtap="recoverRecharge" loading="{{mutating === 'recharge'}}" disabled="{{mutating}}">确认上次充值结果</button></view><label class="field"><text class="field-label">已配置活跃产品</text><picker range="{{rechargeLabels}}" value="{{rechargeIndex}}" bindchange="chooseRechargeProduct" disabled="{{mutating || rechargePending || profile.archived || !rechargeProducts.length}}"><view class="picker">{{rechargeLabels[rechargeIndex] || '尚无可充值产品'}}</view></picker></label><label class="field"><text class="field-label">充值次数</text><input class="input" type="number" value="{{rechargeCount}}" data-field="rechargeCount" bindinput="input" placeholder="1 至 99,999" disabled="{{mutating || rechargePending || profile.archived}}" /></label><label class="field"><text class="field-label">充值说明（可选）</text><textarea class="textarea" maxlength="500" value="{{rechargeNote}}" data-field="rechargeNote" bindinput="input" placeholder="填写本次充值说明" disabled="{{mutating || rechargePending || profile.archived}}" /></label><button class="primary" bindtap="recharge" loading="{{mutating === 'recharge'}}" disabled="{{mutating || rechargePending || profile.archived || !rechargeProducts.length}}">确认充值体验次数</button></view>
        </view>
        <view class="subsection history-section"><view class="history-heading"><text class="subsection-title">额度变更记录</text><text class="history-count">{{history.length}} 条</text></view><scroll-view wx:if="{{history.length}}" class="history-list" scroll-y enhanced show-scrollbar="false"><view wx:for="{{history}}" wx:key="key" class="history-row"><view><text>{{item.type}}</text><text>{{item.productName}}{{item.productCode ? ' · ' + item.productCode : ''}}</text><text wx:if="{{item.note}}">{{item.note}}</text></view><view><text>{{item.countText}}</text><text>{{item.at}}</text><text>{{item.actorName}}</text></view></view></scroll-view><view wx:else class="empty">暂无额度变更记录</view></view>
        </view>
      </view>
    </block>
  </view>
  <view class="safe-bottom"></view>
</view>
