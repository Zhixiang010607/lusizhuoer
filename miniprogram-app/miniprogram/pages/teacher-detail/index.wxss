@import "../home/index.wxss";
.detail-topbar { width: calc(100% - 48rpx); min-height: 104rpx; justify-content: space-between; gap: 20rpx; margin: 0 auto; padding: 32rpx 0 24rpx; box-sizing: border-box; }
.back-button { width: auto !important; min-width: 0; min-height: 60rpx; display: flex; align-items: center; justify-content: center; margin: 0; padding: 0; color: #74592d; background: transparent; border: 0; border-radius: 0; font-size: 23rpx; font-weight: 600; line-height: 1; text-align: right; }
.back-button::after { border: 0; }
.teacher-detail-grid, .teacher-detail-sidebar { min-width: 0; display: grid; grid-template-columns: minmax(0, 1fr); }
.store-status-badge.archived { color: #8f3a34; background: #fff0ee; }
.teacher-profile-hero, .security-panel, .experience-panel { border-color: #e1cfaf; background: #fffaf3; }
.teacher-profile-meta { min-width: 0; display: flex; align-items: center; gap: 18rpx; margin-top: 8rpx; color: #7c7062; }
.teacher-profile-meta text { min-width: 0; display: block; overflow: hidden; font-size: 19rpx; text-overflow: ellipsis; white-space: nowrap; }
.teacher-profile-meta text:last-child { flex: 1; }
.security-panel .button-row button { min-height: 72rpx; font-size: 21rpx; }
.security-panel .input, .experience-panel .input, .experience-panel .picker, .experience-panel .textarea { background: #fff; border-color: #dcc8a6; }
.temporary-password-control { position: relative; min-width: 0; }
.temporary-password-control .input { padding-right: 116rpx; }
.temporary-password-toggle { position: absolute; top: 0; right: 0; width: 108rpx !important; min-height: 82rpx; height: 100%; margin: 0; padding: 0 12rpx; display: flex; align-items: center; justify-content: center; color: #74592d; background: transparent; border: 0; border-radius: 15rpx; font-size: 23rpx; line-height: 1.3; }
.temporary-password-toggle::after { border: 0; }
.monthly-summary-note { display: block; }
.monthly-overview-scroll { width: 100%; max-width: 100%; box-sizing: border-box; border: 1px solid #dfcfb4; border-radius: 14px; }
.monthly-overview-grid { display: inline-table; width: auto; min-width: 100%; border-collapse: collapse; table-layout: auto; }
.monthly-overview-card { display: table-row; }
.monthly-project-head, .monthly-metric { display: table-cell; height: 84px; padding: 12px; border-bottom: 1px solid #eadcc5; vertical-align: middle; text-align: center; white-space: nowrap; }
.monthly-overview-card:last-child > view { border-bottom: 0; }
.monthly-project-head { background: #f6ead7; }
.monthly-project-head text, .monthly-metric text { display: block; font-size: 13px; white-space: nowrap; }
.monthly-project-head text:first-child { color: #4a3825; font-weight: 750; }
.monthly-project-head text:last-child { margin-top: 6px; color: #85745d; font-size: 12px; }
.monthly-metric { background: #fffaf3; }
.monthly-metric text:first-child { color: #7c7062; font-size: 12px; }
.monthly-metric text:last-child { margin-top: 6px; color: #4a3825; font-size: 15px; font-weight: 750; }
.monthly-available { background: #f7ead3; }
.monthly-available text:last-child { color: #80602c; }
.monthly-overview-empty { min-height: 112rpx; display: flex; align-items: center; justify-content: center; }
.subsection { margin-top: 26rpx; padding-top: 24rpx; border-top: 1rpx solid #e5d6bd; }
.experience-project-panel > .subsection:first-child { margin-top: 0; padding-top: 0; border-top: 0; }
.subsection-title { display: block; margin-bottom: 16rpx; font-size: 27rpx; font-weight: 850; }
.summary-grid, .quota-grid { display: grid; gap: 12rpx; }
.summary-item { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; padding: 18rpx; background: #fff8ec; border: 1rpx solid #dfcfb4; border-radius: 16rpx; }
.summary-item > view { min-width: 0; }
.summary-item > view:last-child { flex: none; text-align: right; }
.summary-item text { display: block; }
.summary-item > view:first-child text:first-child { font-weight: 850; }
.summary-item > view:first-child text:last-child, .summary-item > view:last-child text:last-child { margin-top: 5rpx; color: #7c7062; font-size: 18rpx; }
.summary-item > view:last-child text:first-child { color: #74592d; font-size: 31rpx; font-weight: 900; }
.quota-card { padding: 20rpx; background: #fff8ec; border: 1rpx solid #dfcfb4; border-radius: 18rpx; }
.quota-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 12rpx; }
.quota-head text { display: block; }
.quota-head > view:first-child text:first-child { font-size: 25rpx; font-weight: 850; }
.quota-head > view:first-child text:last-child { margin-top: 4rpx; color: #7c7062; font-size: 18rpx; }
.quota-actions button { width: auto !important; min-height: 54rpx; margin: 0; padding: 0 12rpx; font-size: 17rpx; }
.quota-actions .delete-configuration { min-width: 126rpx; min-height: 62rpx; padding: 0 16rpx; font-size: 20rpx; }
.quota-balance { display: flex; align-items: baseline; gap: 12rpx; margin: 20rpx 0; color: #74592d; }
.quota-balance > text:first-child { color: #74695c; font-size: 19rpx; }
.quota-balance > text:last-child { font-size: 42rpx; font-weight: 900; }
.quota-balance .unit { margin-left: 6rpx; font-size: 18rpx; }
.quota-facts { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12rpx; }
.quota-facts view { min-width: 0; min-height: 104rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 14rpx 10rpx; background: #fffaf3; border: 1rpx solid #e5d6bd; border-radius: 12rpx; text-align: center; }
.quota-facts text { display: block; }
.quota-facts text:first-child { color: #7c7062; font-size: 19rpx; }
.quota-facts text:last-child { width: 100%; min-width: 0; margin-top: 7rpx; font-size: 24rpx; font-weight: 850; white-space: nowrap; }
.forms-grid { display: grid; gap: 18rpx; margin-top: 26rpx; }
.experience-operations-panel > .forms-grid { margin-top: 0; }
.action-form { padding: 20rpx; background: #fff8ec; border: 1rpx solid #dfcfb4; border-radius: 20rpx; }
.action-form button { margin: 0; }
.history-section { padding: 20rpx; background: #fff8ec; border: 1rpx solid #dfcfb4; border-radius: 18rpx; }
.history-heading { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.history-heading .subsection-title { margin-bottom: 0; }
.history-count { flex: none; padding: 6rpx 12rpx; color: #74592d; background: #f3e8d3; border-radius: 999rpx; font-size: 18rpx; font-weight: 800; }
.history-list { width: 100%; max-height: 680rpx; box-sizing: border-box; margin-top: 14rpx; overflow-y: auto; }
.history-row { display: flex; justify-content: space-between; gap: 18rpx; margin-top: 8rpx; padding: 16rpx; background: #fffaf3; border: 1rpx solid #e5d6bd; border-radius: 14rpx; }
.history-row:first-child { margin-top: 0; }
.history-row > view { min-width: 0; }
.history-row > view:first-child { flex: 1; }
.history-row > view:last-child { flex: none; text-align: right; }
.history-row text { min-width: 0; display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.history-row > view:first-child text:nth-child(3) { overflow: visible; overflow-wrap: anywhere; text-overflow: clip; white-space: normal; }
.history-row > view:first-child text:first-child, .history-row > view:last-child text:first-child { font-weight: 850; }
.history-row > view:first-child text:not(:first-child), .history-row > view:last-child text:not(:first-child) { margin-top: 5rpx; color: #7c7062; font-size: 17rpx; }
.form-message { margin-top: 14rpx; }
.workspace-main { padding-bottom: 40rpx; }
.pending-recharge { display: flex; flex-direction: column; gap: 12rpx; padding: 16rpx; color: #7a4d19; background: #fff3dc; border: 1rpx solid #dfc28c; border-radius: 14rpx; font-size: 21rpx; line-height: 1.5; }
.pending-recharge button { width: 100%; margin: 0; }

@media (min-width: 700px) {
  .workspace-main { max-width: 1120px; margin: 20px auto 0; }
  .teacher-detail-grid { grid-template-columns: minmax(0, 1fr); gap: 16px; align-items: start; }
  .teacher-detail-sidebar { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; align-content: start; }
  .teacher-detail-sidebar > .web-panel, .teacher-detail-grid > .experience-panel { margin-bottom: 0; }
  .experience-project-panel, .experience-operations-panel { grid-column: 1 / -1; }

  .teacher-profile-hero { min-height: 118px; gap: 14px; padding: 18px; }
  .teacher-profile-hero .profile-avatar { width: 58px; height: 58px; border-radius: 15px; font-size: 22px; }
  .teacher-profile-meta { gap: 12px; margin-top: 6px; }
  .teacher-profile-meta text { font-size: 14px; }
  .security-panel, .experience-panel { padding: 20px; border-width: 1px; border-radius: 18px; }
  .security-panel .panel-heading, .experience-panel .panel-heading { margin-bottom: 16px; }
  .security-panel .button-row { gap: 10px; }
  .security-panel .button-row button { min-height: 46px; padding: 0 10px; font-size: 14px; }
  .temporary-password-control .input { padding-right: 70px; }
  .temporary-password-toggle { width: 64px !important; min-height: 50px; padding: 0 8px; border-radius: 12px; font-size: 14px; }

  .monthly-project-head text:first-child { font-size: 16px; }
  .monthly-metric text:first-child { font-size: 13px; }
  .monthly-metric text:last-child { font-size: 16px; }
  .monthly-overview-empty { min-height: 76px; }

  .experience-project-panel { display: grid; grid-template-columns: minmax(0, 1fr); gap: 18px; align-items: start; }
  .experience-project-panel > .subsection { min-width: 0; margin-top: 0; padding-top: 0; border-top: 0; }
  .subsection-title { margin-bottom: 12px; font-size: 19px; }
  .summary-grid { grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); gap: 10px; }
  .summary-item { gap: 12px; padding: 14px; border-width: 1px; border-radius: 13px; }
  .summary-item > view:first-child text:last-child, .summary-item > view:last-child text:last-child { margin-top: 4px; font-size: 13px; }
  .summary-item > view:last-child text:first-child { font-size: 22px; }
  .quota-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
  .quota-card { padding: 14px; border-width: 1px; border-radius: 14px; }
  .quota-head { flex-wrap: wrap; }
  .quota-head > view:first-child { flex: 1 1 180px; }
  .quota-head > view:first-child text:first-child { font-size: 17px; line-height: 1.5; overflow-wrap: anywhere; }
  .quota-head > view:first-child text:last-child { margin-top: 3px; font-size: 13px; }
  .quota-actions .delete-configuration { min-width: 96px; min-height: 42px; padding: 0 12px; font-size: 14px; }
  .quota-balance { gap: 8px; margin: 12px 0; }
  .quota-balance > text:first-child { font-size: 13px; }
  .quota-balance > text:last-child { font-size: 28px; }
  .quota-balance .unit { margin-left: 4px; font-size: 13px; }
  .quota-facts { gap: 8px; }
  .quota-facts view { min-height: 72px; padding: 10px 8px; border-width: 1px; border-radius: 10px; }
  .quota-facts text:first-child { font-size: 12px; }
  .quota-facts text:last-child { margin-top: 5px; font-size: 17px; }

  .forms-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
  .action-form { padding: 16px; border-width: 1px; border-radius: 16px; }
  .action-form .textarea { min-height: 112px; }
  .history-section { margin-top: 16px; padding: 16px; border-width: 1px; border-radius: 14px; }
  .history-list { max-height: 360px; margin-top: 12px; }
  .history-row { gap: 14px; margin-top: 6px; padding: 12px 14px; border-width: 1px; border-radius: 12px; }
  .history-row > view:first-child text:not(:first-child), .history-row > view:last-child text:not(:first-child) { margin-top: 4px; font-size: 13px; }
  .history-count { padding: 4px 9px; font-size: 13px; }
}

.security-panel .button-row { margin-top: 20rpx; flex-wrap: wrap; }
.security-panel .button-row button { flex: 1 1 220rpx; }
@media (min-width: 700px) {
  .detail-topbar { width: calc(100% - 48px); max-width: 1120px; min-height: 84px; padding: 24px 0 0; }
  .detail-topbar .back-button { min-width: 0; min-height: 44px; padding: 0; font-size: 14px; }
  .security-panel .button-row { margin-top: 14px; }
  .security-panel .button-row button { flex-basis: 120px; }
}
@media (min-width: 1100px) {
  .teacher-detail-grid { grid-template-columns: minmax(280px, .7fr) minmax(0, 1.3fr); }
  .teacher-detail-sidebar { grid-template-columns: minmax(0, 1fr); }
  .experience-project-panel { grid-template-columns: minmax(0, .85fr) minmax(0, 1.15fr); }
  .quota-grid { grid-template-columns: minmax(0, 1fr); }
}

.monthly-scroll-hint { display: block; margin-bottom: 12rpx; color: #7c7062; font-size: 24rpx; }
@media (min-width: 700px) { .monthly-scroll-hint { display: none; } }

.summary-grid, .quota-grid, .forms-grid { grid-template-columns: minmax(0, 1fr); }
.summary-item, .quota-card, .action-form { min-width: 0; max-width: 100%; }
.summary-item, .quota-head, .quota-balance { flex-wrap: wrap; }
.summary-item > view:first-child, .quota-head > view:first-child { min-width: 0; flex: 1 1 200rpx; overflow-wrap: anywhere; }
.summary-item > view:last-child { min-width: 0; max-width: 100%; }
.quota-actions { flex: none; }
.history-row > view:last-child { flex: 0 1 48%; }
.history-row > view:last-child text:last-child { white-space: normal; overflow-wrap: anywhere; }
@media (min-width: 700px) {
  .summary-grid { grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); }
  .quota-grid, .forms-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .summary-item > view:first-child, .quota-head > view:first-child { flex-basis: 140px; }
}
@media (min-width: 1100px) { .quota-grid { grid-template-columns: minmax(0, 1fr); } }

.quota-card.large-counts .quota-facts { grid-template-columns: minmax(0, 1fr); }

.teacher-section-tabs, .work-mode-tabs { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10rpx; margin-bottom: 22rpx; padding: 8rpx; background: #eee2cf; border: 1rpx solid #dfcfb4; border-radius: 18rpx; }
.teacher-section-tab, .work-mode-tab { width: 100% !important; min-height: 72rpx; display: flex; align-items: center; justify-content: center; margin: 0; padding: 0 12rpx; color: #766a5b; background: transparent; border: 0; border-radius: 14rpx; font-size: 22rpx; font-weight: 800; line-height: 1.2; text-align: center; }
.teacher-section-tab::after, .work-mode-tab::after { border: 0; }
.teacher-section-tab.active, .work-mode-tab.active { color: #fff; background: #80602c; box-shadow: 0 3rpx 10rpx rgba(88, 59, 25, .14); }
.work-mode-tabs { grid-template-columns: repeat(2, minmax(0, 1fr)); }
.basic-detail-grid { align-content: start; }
.face-reenroll-panel { min-width: 0; padding: 24rpx; border-color: #e1cfaf; background: #fffaf3; }
.face-disabled-note { padding: 22rpx; color: #7c7062; background: #f4eadb; border-radius: 14rpx; line-height: 1.6; }
.face-consent { margin-top: 20rpx; }
.face-consent label { display: flex; align-items: flex-start; gap: 12rpx; color: #655c51; font-size: 20rpx; line-height: 1.6; }
.face-consent checkbox { flex: none; margin-top: 2rpx; transform: scale(.9); transform-origin: left top; }
.face-replace-button { min-height: 78rpx; display: flex; align-items: center; justify-content: center; margin: 20rpx 0 0; line-height: 1.2; text-align: center; }
.configuration-section, .work-section { display: grid; gap: 20rpx; }
.calendar-panel, .selected-day-panel { padding: 24rpx; border-color: #e1cfaf; background: #fffaf3; }
.calendar-toolbar { display: grid; grid-template-columns: 120rpx minmax(0, 1fr) 120rpx; align-items: center; gap: 12rpx; }
.calendar-toolbar button { width: 100% !important; min-height: 58rpx; display: flex; align-items: center; justify-content: center; margin: 0; padding: 0; color: #74592d; background: #fff; border: 1rpx solid #dcc8a6; border-radius: 12rpx; font-size: 19rpx; line-height: 1; text-align: center; }
.calendar-toolbar button::after { border: 0; }
.calendar-toolbar > text { text-align: center; font-size: 30rpx; font-weight: 900; }
.calendar-legend { display: flex; align-items: center; flex-wrap: wrap; gap: 16rpx 24rpx; margin: 22rpx 0 14rpx; color: #756a5e; font-size: 18rpx; }
.calendar-legend view { display: flex; align-items: center; gap: 7rpx; }
.calendar-weekdays, .calendar-grid { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); }
.calendar-weekdays text { padding: 12rpx 0; color: #7d7060; font-size: 18rpx; font-weight: 800; text-align: center; }
.calendar-grid { overflow: hidden; border-top: 1rpx solid #e4d4ba; border-left: 1rpx solid #e4d4ba; border-radius: 14rpx; }
.calendar-day { min-width: 0; min-height: 92rpx; display: flex; flex-direction: column; align-items: center; justify-content: space-between; padding: 10rpx 4rpx; background: #fff; border-right: 1rpx solid #e4d4ba; border-bottom: 1rpx solid #e4d4ba; box-sizing: border-box; }
.calendar-day.blank { background: #f5eee3; }
.calendar-day.selected { background: #f7ead3; box-shadow: inset 0 0 0 3rpx #b98a3d; }
.calendar-day.future { color: #aaa095; }
.calendar-day-number { font-size: 20rpx; font-weight: 750; }
.attendance-dots, .report-dot { min-height: 18rpx; display: flex; align-items: center; justify-content: center; gap: 8rpx; }
.status-dot { width: 13rpx; height: 13rpx; display: inline-block; border-radius: 999rpx; background: #cfc7bc; }
.status-dot.done { background: #3177c8; }
.status-dot.missing { background: #c94a42; }
.status-dot.future { background: #cfc7bc; }
.calendar-loading { min-height: 420rpx; display: flex; align-items: center; justify-content: center; color: #81776b; }
.attendance-detail-grid { display: grid; gap: 16rpx; }
.attendance-detail-card { min-width: 0; display: flex; flex-direction: column; gap: 10rpx; padding: 20rpx; color: #6c6256; background: #fff8ec; border: 1rpx solid #dfcfb4; border-radius: 16rpx; font-size: 20rpx; line-height: 1.55; overflow-wrap: anywhere; }
.attendance-detail-card .detail-kind { color: #332b23; font-size: 25rpx; font-weight: 900; }
.attendance-detail-card .detail-time { color: #74592d; font-size: 23rpx; font-weight: 850; }
.attendance-detail-card button { width: 100% !important; min-height: 64rpx; display: flex; align-items: center; justify-content: center; margin: 8rpx 0 0; line-height: 1.2; text-align: center; }
.empty-detail { min-height: 118rpx; display: flex; align-items: center; justify-content: center; color: #a49a8e; }
.report-detail-list { overflow: hidden; background: #fff; border: 1rpx solid #dfcfb4; border-radius: 16rpx; }
.report-detail-list view { display: grid; gap: 9rpx; padding: 20rpx; border-top: 1rpx solid #eadcc5; }
.report-detail-list view:first-child { border-top: 0; }
.report-detail-list text:first-child { color: #74592d; font-size: 20rpx; font-weight: 850; }
.report-detail-list text:last-child { color: #423a31; font-size: 22rpx; line-height: 1.65; white-space: pre-wrap; overflow-wrap: anywhere; }
.selected-report-empty { min-height: 180rpx; display: flex; align-items: center; justify-content: center; }
.teacher-detail-grid button, .configuration-section button, .work-section button { text-align: center; }

@media (min-width: 700px) {
  .teacher-section-tabs, .work-mode-tabs { gap: 8px; margin-bottom: 16px; padding: 6px; border-width: 1px; border-radius: 14px; }
  .teacher-section-tab, .work-mode-tab { min-height: 46px; padding: 0 10px; border-radius: 10px; font-size: 14px; }
  .face-reenroll-panel, .calendar-panel, .selected-day-panel { padding: 20px; border-width: 1px; border-radius: 18px; }
  .face-consent { margin-top: 14px; }
  .face-consent label { gap: 8px; font-size: 14px; }
  .face-replace-button { min-height: 48px; margin-top: 14px; }
  .calendar-toolbar { grid-template-columns: 84px minmax(0, 1fr) 84px; gap: 10px; }
  .calendar-toolbar button { min-height: 40px; border-width: 1px; border-radius: 9px; font-size: 13px; }
  .calendar-toolbar > text { font-size: 20px; }
  .calendar-legend { gap: 10px 18px; margin: 16px 0 10px; font-size: 13px; }
  .calendar-weekdays text { padding: 9px 0; font-size: 13px; }
  .calendar-day { min-height: 72px; padding: 8px 4px; border-width: 1px; }
  .calendar-day-number { font-size: 14px; }
  .status-dot { width: 9px; height: 9px; }
  .attendance-dots, .report-dot { min-height: 12px; gap: 6px; }
  .attendance-detail-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; }
  .attendance-detail-card { gap: 8px; padding: 16px; border-width: 1px; border-radius: 13px; font-size: 14px; }
  .attendance-detail-card .detail-kind { font-size: 18px; }
  .attendance-detail-card .detail-time { font-size: 16px; }
  .attendance-detail-card button { min-height: 42px; margin-top: 6px; }
  .report-detail-list { border-width: 1px; border-radius: 13px; }
  .report-detail-list view { grid-template-columns: 160px minmax(0, 1fr); gap: 14px; padding: 15px; border-width: 1px; }
  .report-detail-list text:first-child { font-size: 14px; }
  .report-detail-list text:last-child { font-size: 15px; }
}
