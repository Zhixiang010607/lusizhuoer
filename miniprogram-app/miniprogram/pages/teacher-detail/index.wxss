@import "../home/index.wxss";
.detail-topbar { justify-content: space-between; gap: 14rpx; }
.back-button { width: auto; min-width: 154rpx; min-height: 60rpx; margin: 0; padding: 0 14rpx; border-radius: 11rpx; font-size: 18rpx; }
.teacher-detail-grid, .teacher-detail-sidebar { min-width: 0; display: grid; grid-template-columns: minmax(0, 1fr); }
.store-status-badge.archived { color: #8f3a34; background: #fff0ee; }
.teacher-profile-hero, .security-panel, .experience-panel { border-color: #e1cfaf; background: #fffaf3; }
.teacher-profile-meta { min-width: 0; display: flex; align-items: center; gap: 18rpx; margin-top: 8rpx; color: #7c7062; }
.teacher-profile-meta text { min-width: 0; display: block; overflow: hidden; font-size: 19rpx; text-overflow: ellipsis; white-space: nowrap; }
.teacher-profile-meta text:last-child { flex: 1; }
.security-panel .button-row button { min-height: 72rpx; font-size: 21rpx; }
.security-panel .input, .experience-panel .input, .experience-panel .picker, .experience-panel .textarea { background: #fff; border-color: #dcc8a6; }
.monthly-summary-note { display: block; }
.monthly-overview-grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: 14rpx; }
.monthly-overview-card { min-width: 0; display: grid; grid-template-columns: minmax(146rpx, 1.15fr) minmax(0, 3.85fr); overflow: hidden; border: 1rpx solid #dfcfb4; border-radius: 18rpx; background: #fff8ec; }
.monthly-project-head { min-width: 0; display: flex; align-items: center; justify-content: space-between; gap: 8rpx; padding: 12rpx 14rpx; border-right: 1rpx solid #eadcc5; background: #f6ead7; }
.monthly-project-head > view { min-width: 0; }
.monthly-project-head > view text { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.monthly-project-head > view text:first-child { color: #4a3825; font-size: 20rpx; font-weight: 850; }
.monthly-project-head > view text:last-child { margin-top: 3rpx; color: #85745d; font-size: 15rpx; }
.monthly-project-head > text { display: none; }
.monthly-metrics { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1rpx; background: #eadcc5; }
.monthly-metrics > view { min-width: 0; min-height: 100rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 9rpx 3rpx; background: #fffaf3; text-align: center; }
.monthly-metrics text { width: 100%; display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.monthly-metrics text:first-child { color: #7c7062; font-size: 15rpx; }
.monthly-metrics text:last-child { margin-top: 5rpx; color: #4a3825; font-size: 20rpx; font-weight: 900; }
.monthly-metrics .monthly-available { background: #f7ead3; }
.monthly-metrics .monthly-available text:last-child { color: #80602c; }
.monthly-overview-empty { min-height: 112rpx; display: flex; align-items: center; justify-content: center; }
.subsection { margin-top: 26rpx; padding-top: 24rpx; border-top: 1rpx solid #e5d6bd; }
.experience-project-panel > .subsection:first-child { margin-top: 0; padding-top: 0; border-top: 0; }
.subsection-title { display: block; margin-bottom: 16rpx; font-size: 27rpx; font-weight: 850; }
.summary-grid, .quota-grid { display: grid; gap: 12rpx; }
.summary-item { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; padding: 18rpx; background: #fff8ec; border: 1rpx solid #dfcfb4; border-radius: 16rpx; }
.summary-item > view { min-width: 0; }
.summary-item > view:last-child { flex: none; text-align: right; }
.summary-item text { display: block; }
.summary-item > view:first-child text:first-child { font-weight: 850; }
.summary-item > view:first-child text:last-child, .summary-item > view:last-child text:last-child { margin-top: 5rpx; color: #7c7062; font-size: 18rpx; }
.summary-item > view:last-child text:first-child { color: #74592d; font-size: 31rpx; font-weight: 900; }
.quota-card { padding: 20rpx; background: #fff8ec; border: 1rpx solid #dfcfb4; border-radius: 18rpx; }
.quota-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 12rpx; }
.quota-head text { display: block; }
.quota-head > view:first-child text:first-child { font-size: 25rpx; font-weight: 850; }
.quota-head > view:first-child text:last-child { margin-top: 4rpx; color: #7c7062; font-size: 18rpx; }
.quota-actions button { width: auto; min-height: 54rpx; margin: 0; padding: 0 12rpx; font-size: 17rpx; }
.quota-actions .delete-configuration { min-width: 126rpx; min-height: 62rpx; padding: 0 16rpx; font-size: 20rpx; }
.quota-balance { display: flex; align-items: baseline; gap: 12rpx; margin: 20rpx 0; color: #74592d; }
.quota-balance > text:first-child { color: #74695c; font-size: 19rpx; }
.quota-balance > text:last-child { font-size: 42rpx; font-weight: 900; }
.quota-balance .unit { margin-left: 6rpx; font-size: 18rpx; }
.quota-facts { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12rpx; }
.quota-facts view { min-width: 0; min-height: 104rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 14rpx 10rpx; background: #fffaf3; border: 1rpx solid #e5d6bd; border-radius: 12rpx; text-align: center; }
.quota-facts text { display: block; }
.quota-facts text:first-child { color: #7c7062; font-size: 19rpx; }
.quota-facts text:last-child { width: 100%; min-width: 0; margin-top: 7rpx; font-size: 24rpx; font-weight: 850; white-space: nowrap; }
.forms-grid { display: grid; gap: 18rpx; margin-top: 26rpx; }
.experience-operations-panel > .forms-grid { margin-top: 0; }
.action-form { padding: 20rpx; background: #fff8ec; border: 1rpx solid #dfcfb4; border-radius: 20rpx; }
.action-form button { margin: 0; }
.history-section { padding: 20rpx; background: #fff8ec; border: 1rpx solid #dfcfb4; border-radius: 18rpx; }
.history-heading { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.history-heading .subsection-title { margin-bottom: 0; }
.history-count { flex: none; padding: 6rpx 12rpx; color: #74592d; background: #f3e8d3; border-radius: 999rpx; font-size: 18rpx; font-weight: 800; }
.history-list { width: 100%; max-height: 680rpx; box-sizing: border-box; margin-top: 14rpx; overflow-y: auto; }
.history-row { display: flex; justify-content: space-between; gap: 18rpx; margin-top: 8rpx; padding: 16rpx; background: #fffaf3; border: 1rpx solid #e5d6bd; border-radius: 14rpx; }
.history-row:first-child { margin-top: 0; }
.history-row > view { min-width: 0; }
.history-row > view:first-child { flex: 1; }
.history-row > view:last-child { flex: none; text-align: right; }
.history-row text { min-width: 0; display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.history-row > view:first-child text:nth-child(3) { overflow: visible; overflow-wrap: anywhere; text-overflow: clip; white-space: normal; }
.history-row > view:first-child text:first-child, .history-row > view:last-child text:first-child { font-weight: 850; }
.history-row > view:first-child text:not(:first-child), .history-row > view:last-child text:not(:first-child) { margin-top: 5rpx; color: #7c7062; font-size: 17rpx; }
.form-message { margin-top: 14rpx; }
.workspace-main { padding-bottom: 40rpx; }
.pending-recharge { display: flex; flex-direction: column; gap: 12rpx; padding: 16rpx; color: #7a4d19; background: #fff3dc; border: 1rpx solid #dfc28c; border-radius: 14rpx; font-size: 21rpx; line-height: 1.5; }
.pending-recharge button { width: 100%; margin: 0; }

@media (min-width: 700px) {
  .workspace-main { max-width: 1120px; margin: 20px auto 0; }
  .teacher-detail-grid { grid-template-columns: minmax(280px, .76fr) minmax(0, 1.24fr); gap: 16px; align-items: start; }
  .teacher-detail-sidebar { gap: 16px; align-content: start; }
  .teacher-detail-sidebar > .web-panel, .teacher-detail-grid > .experience-panel { margin-bottom: 0; }
  .experience-project-panel, .experience-operations-panel { grid-column: 1 / -1; }

  .teacher-profile-hero { min-height: 118px; gap: 14px; padding: 18px; }
  .teacher-profile-hero .profile-avatar { width: 58px; height: 58px; border-radius: 15px; font-size: 22px; }
  .teacher-profile-meta { gap: 12px; margin-top: 6px; }
  .teacher-profile-meta text { font-size: 14px; }
  .security-panel, .experience-panel { padding: 20px; border-width: 1px; border-radius: 18px; }
  .security-panel .panel-heading, .experience-panel .panel-heading { margin-bottom: 16px; }
  .security-panel .button-row { gap: 10px; }
  .security-panel .button-row button { min-height: 46px; padding: 0 10px; font-size: 14px; }

  .monthly-overview-grid { grid-template-columns: minmax(0, 1fr); gap: 8px; }
  .monthly-overview-card { display: grid; grid-template-columns: minmax(132px, 1.15fr) minmax(0, 3.85fr); border-width: 1px; border-radius: 14px; }
  .monthly-project-head { gap: 8px; padding: 9px 11px; border-right: 1px solid #eadcc5; border-bottom: 0; }
  .monthly-project-head > view text:first-child { font-size: 16px; }
  .monthly-project-head > view text:last-child { margin-top: 3px; font-size: 12px; }
  .monthly-project-head > text { display: block; padding: 4px 8px; font-size: 12px; }
  .monthly-metrics { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1px; }
  .monthly-metrics > view { min-height: 58px; padding: 7px 5px; }
  .monthly-metrics text:first-child { font-size: 11px; }
  .monthly-metrics text:last-child { margin-top: 4px; font-size: 16px; }
  .monthly-overview-empty { min-height: 76px; }

  .experience-project-panel { display: grid; grid-template-columns: minmax(0, .74fr) minmax(0, 1.26fr); gap: 18px; align-items: start; }
  .experience-project-panel > .subsection { min-width: 0; margin-top: 0; padding-top: 0; border-top: 0; }
  .subsection-title { margin-bottom: 12px; font-size: 19px; }
  .summary-grid { grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); gap: 10px; }
  .summary-item { gap: 12px; padding: 14px; border-width: 1px; border-radius: 13px; }
  .summary-item > view:first-child text:last-child, .summary-item > view:last-child text:last-child { margin-top: 4px; font-size: 13px; }
  .summary-item > view:last-child text:first-child { font-size: 22px; }
  .quota-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
  .quota-card { padding: 14px; border-width: 1px; border-radius: 14px; }
  .quota-head > view:first-child text:first-child { font-size: 17px; }
  .quota-head > view:first-child text:last-child { margin-top: 3px; font-size: 13px; }
  .quota-actions .delete-configuration { min-width: 96px; min-height: 42px; padding: 0 12px; font-size: 14px; }
  .quota-balance { gap: 8px; margin: 12px 0; }
  .quota-balance > text:first-child { font-size: 13px; }
  .quota-balance > text:last-child { font-size: 28px; }
  .quota-balance .unit { margin-left: 4px; font-size: 13px; }
  .quota-facts { gap: 8px; }
  .quota-facts view { min-height: 72px; padding: 10px 8px; border-width: 1px; border-radius: 10px; }
  .quota-facts text:first-child { font-size: 12px; }
  .quota-facts text:last-child { margin-top: 5px; font-size: 17px; }

  .forms-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
  .action-form { padding: 16px; border-width: 1px; border-radius: 16px; }
  .action-form .textarea { min-height: 112px; }
  .history-section { margin-top: 16px; padding: 16px; border-width: 1px; border-radius: 14px; }
  .history-list { max-height: 360px; margin-top: 12px; }
  .history-row { gap: 14px; margin-top: 6px; padding: 12px 14px; border-width: 1px; border-radius: 12px; }
  .history-row > view:first-child text:not(:first-child), .history-row > view:last-child text:not(:first-child) { margin-top: 4px; font-size: 13px; }
  .history-count { padding: 4px 9px; font-size: 13px; }
}
