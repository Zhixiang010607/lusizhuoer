<view class="page">
  <view class="page-heading">
    <text class="eyebrow">{{refund ? '退费申请' : '办卡充值'}}</text>
    <text class="title">{{refund ? '申请退回已购次数' : '为客户提交充值单'}}</text>
    <text class="subtitle">{{store.id ? store.name + ' · 业务将严格绑定当前账号和门店。' : '进入业务页后先选择本次业务的发生门店。'}}</text>
  </view>

  <view wx:if="{{locked}}" class="card recovery-card">
    <view class="card-title"><text>上次提交结果待确认</text><text class="badge">禁止重复</text></view>
    <text class="section-note">{{message || '正在从数据库核对上次请求。'}}</text>
    <button class="primary" bindtap="recoverPending" loading="{{recovering}}" disabled="{{recovering}}">检查上次提交结果</button>
  </view>

  <block wx:else>
    <view class="workflow-grid">
    <view class="card customer-step-card">
      <view class="card-title"><text>第一步：确认客户</text><text class="badge">必须看到照片</text></view>
      <label wx:if="{{session.role === 'teacher'}}" class="field">
        <text class="field-label">办理门店</text>
        <picker range="{{storeLabels}}" value="{{storeIndex}}" bindchange="selectStore" disabled="{{busy || loadingStores || !stores.length}}">
          <view class="picker">{{loadingStores ? '正在读取可办理门店…' : (store.id ? store.name + ' · ' + (store.code || store.id) : (stores.length ? '请选择门店' : '暂无可办理门店'))}}</view>
        </picker>
      </label>
      <button wx:if="{{session.role === 'teacher' && !loadingStores && !stores.length}}" class="secondary" bindtap="loadTeacherStores">重试门店列表</button>
      <customer-picker wx:if="{{store.id}}" store-id="{{store.id}}" bindconfirm="customerConfirmed" bindchange="customerChanged"></customer-picker>
      <text wx:else class="section-note">选择办理门店后即可确认客户</text>
    </view>

    <view class="card info-step-card {{customer ? '' : 'disabled-card'}}">
      <view class="card-title"><text>第二步：填写{{refund ? '退费' : '充值'}}信息</text><text class="badge">{{customer ? customer.customerName : '先确认客户'}}</text></view>
      <label class="field">
        <text class="field-label">项目</text>
        <picker range="{{productLabels}}" value="{{productIndex}}" bindchange="selectProduct" disabled="{{!customer || loadingOptions || !products.length}}">
          <view class="picker">{{loadingOptions ? '正在读取项目…' : (selectedProduct ? productLabels[productIndex] : (products.length ? '请选择项目' : '暂无可用项目'))}}</view>
        </picker>
      </label>
      <view wx:if="{{refund && selectedProduct}}" class="impact">已购未退 {{selectedProduct.purchasedCount}} 次，当前剩余 {{selectedProduct.remainingCount}} 次；本次最多可退 {{selectedProduct.purchasedCount}} 次。</view>
      <label class="field">
        <text class="field-label">业务老师{{session.role === 'teacher' ? '（自动绑定）' : '（可选）'}}</text>
        <picker range="{{teacherLabels}}" value="{{teacherIndex}}" bindchange="selectTeacher" disabled="{{!customer || session.role === 'teacher' || loadingOptions}}">
          <view class="picker">{{selectedTeacher ? selectedTeacher.teacherName + ' · ' + selectedTeacher.teacherCode : '不指定业务老师'}}</view>
        </picker>
      </label>
      <label class="field"><text class="field-label">{{refund ? '退费次数' : '充值次数'}}</text><input class="input" type="number" maxlength="3" value="{{unitCount}}" bindinput="inputCount" disabled="{{!customer}}" placeholder="{{customer ? '1 至 999 的整数' : '请先确认客户'}}" /></label>
      <label class="field"><text class="field-label">门店留言（可选）</text><textarea class="textarea" maxlength="500" value="{{note}}" bindinput="inputNote" disabled="{{!customer}}" placeholder="{{customer ? '审核人员可在详情中看到' : '请先确认客户'}}" /></label>
    </view>

    <view wx:if="{{!refund}}" class="card workflow-wide {{customer ? '' : 'disabled-card'}}">
      <view class="card-title"><text>第三步：填写产品赠予</text><text class="badge">可选</text></view>
      <text class="section-note">先选择当前激活产品，再填写数量，最后点“＋”加入清单。</text>
      <view class="gift-add-row">
        <picker class="gift-product-picker" range="{{giftProductLabels}}" value="{{giftProductIndex}}" bindchange="selectGiftProduct" disabled="{{!customer || loadingGiftProducts || !giftProducts.length}}">
          <view class="picker">{{loadingGiftProducts ? '正在读取激活产品…' : giftProductLabels[giftProductIndex]}}</view>
        </picker>
        <input class="input gift-quantity" type="number" maxlength="3" value="{{giftProductQuantity}}" bindinput="inputGiftQuantity" disabled="{{!customer}}" placeholder="数量" />
        <button class="gift-plus" bindtap="addProductGift" disabled="{{!customer || busy || locked}}" aria-label="加入产品赠予"><text class="gift-plus-symbol">＋</text></button>
      </view>
      <button wx:if="{{!loadingGiftProducts && !giftProducts.length}}" class="secondary gift-retry" bindtap="loadGiftProducts" disabled="{{!customer}}">重试激活产品列表</button>
      <view wx:if="{{productGifts.length}}" class="gift-list">
        <view wx:for="{{productGifts}}" wx:key="retailProductId" class="gift-row">
          <view class="gift-copy"><text>{{item.productName}}</text><text>{{item.productCode}} · {{item.unitCount}} 件</text></view>
          <button class="gift-remove" type="button" data-index="{{index}}" bindtap="removeProductGift" disabled="{{busy || locked}}">删除</button>
        </view>
      </view>
      <text wx:else class="gift-empty">暂未添加产品赠予</text>
    </view>

    <view class="card submit-card workflow-wide {{customer ? '' : 'disabled-card'}}">
      <button class="primary" bindtap="submit" loading="{{busy}}" disabled="{{busy || !ready}}">提交{{refund ? '退费' : '充值'}}申请</button>
    </view>
    </view>
  </block>
  <view wx:if="{{message && !locked}}" class="message {{error ? 'error' : 'success'}}">{{message}}</view>
  <view class="safe-bottom"></view>
</view>
