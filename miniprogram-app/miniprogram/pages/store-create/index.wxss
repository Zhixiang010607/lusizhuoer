page { min-height: 100%; color: #302a22; background: #f3ede2; }
.page { width: calc(100% - 28rpx); min-height: 100vh; margin: 0 auto; padding: 16rpx 0 40rpx; }
.page-heading { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin: 8rpx 6rpx 20rpx; }
.page-heading text:first-child { font-family: Georgia, "Times New Roman", serif; font-size: 40rpx; font-weight: 800; }
.page-heading text:last-child, .section-heading > text { padding: 6rpx 12rpx; color: #74592d; background: #f4e7d0; border-radius: 999rpx; font-size: 18rpx; font-weight: 800; }
.panel { margin-bottom: 16rpx; padding: 24rpx; background: #fffaf3; border: 1rpx solid #dfcfb4; border-radius: 24rpx; box-shadow: 0 12rpx 34rpx rgba(93,72,39,.08); }
.section-heading { display: flex; align-items: center; justify-content: space-between; gap: 14rpx; margin-bottom: 18rpx; }
.section-heading > view { min-width: 0; display: flex; flex-direction: column; gap: 5rpx; }
.section-heading > view text:first-child { font-size: 29rpx; font-weight: 850; }
.section-heading > view text:last-child { color: #7c7062; font-size: 19rpx; }
.field { display: flex; flex-direction: column; gap: 9rpx; margin-top: 17rpx; }
.field > text { color: #554a3c; font-size: 21rpx; font-weight: 800; }
.field input, .picker { width: 100%; min-height: 82rpx; display: flex; align-items: center; padding: 0 20rpx; color: #302a22; background: #fff; border: 1rpx solid #d8c5a3; border-radius: 15rpx; font-size: 22rpx; }
.actions { display: grid; grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr); gap: 12rpx; }
.actions button { min-height: 78rpx; display: flex; align-items: center; justify-content: center; margin: 0; padding: 0 16rpx; border-radius: 15rpx; font-size: 19rpx; font-weight: 800; line-height: 1; }
.primary { color: #fffdf8; background: #6f532e; }.ghost { color: #74592d; background: #fff; border: 1rpx solid #d7c39f; }
.message { margin-bottom: 16rpx; padding: 17rpx 20rpx; border-radius: 15rpx; font-size: 20rpx; line-height: 1.5; }.message.error { color: #8b3f35; background: #fff1ed; }.message.success { color: #4f664f; background: #f0f6ec; }
.safe-bottom { height: calc(24rpx + env(safe-area-inset-bottom)); }
