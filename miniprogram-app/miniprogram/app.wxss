page {
  --navy: #6f532e;
  --blue: #a98243;
  --blue-soft: #f4e7d0;
  --green: #607c6a;
  --red: #99574b;
  --ink: #302a22;
  --muted: #7c7062;
  --line: #dfcfb4;
  --surface: #fffaf3;
  --page: #f3ede2;
  --shadow: 0 12rpx 34rpx rgba(93, 72, 39, .08);
  background: var(--page);
  color: var(--ink);
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "Microsoft YaHei", "PingFang SC", sans-serif;
  font-size: 26rpx;
}

view, text, input, textarea, picker, button, image { box-sizing: border-box; }
button::after { border: 0; }
.page { min-height: 100vh; padding: 16rpx 14rpx 48rpx; }
.page-heading { margin-bottom: 14rpx; padding: 18rpx 22rpx; color: #fffdf8; background: linear-gradient(115deg, #6f532e, #a98243); border-radius: 18rpx; }
.page-heading .eyebrow, .page-heading .subtitle { display: none; }
.page-heading .title { display: block; font-size: 36rpx; font-weight: 800; line-height: 1.25; }
.card { min-width: 0; margin-bottom: 14rpx; padding: 22rpx; overflow: hidden; background: var(--surface); border: 1rpx solid var(--line); border-radius: 28rpx; box-shadow: var(--shadow); }
.card-title { display: flex; align-items: center; justify-content: space-between; gap: 14rpx; margin-bottom: 14rpx; }
.card-title text:first-child { min-width: 0; font-size: 29rpx; font-weight: 800; }
.badge { flex: none; padding: 6rpx 12rpx; color: #74592d; background: #f4e7d0; border-radius: 999rpx; font-size: 20rpx; font-weight: 700; }
.field { display: block; margin-bottom: 18rpx; }
.field-label { display: block; margin-bottom: 8rpx; color: #675b4b; font-size: 23rpx; font-weight: 700; }
.input, .picker, .textarea { width: 100%; min-height: 88rpx; padding: 0 22rpx; background: #fff; border: 1rpx solid #d8c5a3; border-radius: 14rpx; color: var(--ink); }
.picker { min-width: 0; display: flex; align-items: center; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.textarea { min-height: 150rpx; padding-top: 18rpx; line-height: 1.5; }
.primary, .secondary, .danger, .ghost { display: flex; align-items: center; justify-content: center; min-height: 88rpx; padding: 0 24rpx; border-radius: 14rpx; font-size: 26rpx; font-weight: 750; line-height: 1.2; }
.primary { color: #fff; background: var(--navy); }
.primary[disabled] { color: #9b9082; background: #e7ddce; }
.secondary { color: #74592d; background: var(--blue-soft); border: 1rpx solid #d8bc8c; }
.ghost { color: var(--ink); background: #fff; border: 1rpx solid var(--line); }
.danger { color: #9b2d28; background: #fff1ef; border: 1rpx solid #efc1bd; }
.button-row { display: flex; gap: 12rpx; }
.button-row button { flex: 1; margin: 0; }
.message { margin-top: 14rpx; padding: 16rpx 18rpx; color: #625747; background: #f5ead8; border-radius: 12rpx; line-height: 1.5; }
.message.error { color: #9a302b; background: #fff0ee; }
.message.success { color: #08725f; background: #e8f8f2; }
.empty { padding: 40rpx 20rpx; color: var(--muted); text-align: center; }
.list-item { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; padding: 18rpx 0; border-top: 1rpx solid #eadfce; }
.list-item:first-child { border-top: 0; }
.list-main { min-width: 0; flex: 1; }
.list-main .name { display: block; overflow: hidden; font-size: 29rpx; font-weight: 800; text-overflow: ellipsis; white-space: nowrap; }
.list-main .meta { display: block; margin-top: 7rpx; overflow: hidden; color: var(--muted); font-size: 23rpx; text-overflow: ellipsis; white-space: nowrap; }
.chevron { color: #9a8a73; font-size: 34rpx; }
.segmented { display: flex; gap: 8rpx; padding: 7rpx; background: #eee4d6; border-radius: 16rpx; }
.segmented button { flex: 1; min-height: 68rpx; margin: 0; color: #796d5e; background: transparent; border-radius: 12rpx; font-size: 24rpx; }
.segmented button.active { color: #74592d; background: #fff; box-shadow: 0 4rpx 12rpx rgba(93,72,39,.1); font-weight: 800; }
.photo { width: 100%; height: 440rpx; background: #eee4d6; border-radius: 20rpx; object-fit: cover; }
.photo-small { width: 118rpx; height: 142rpx; background: #eee4d6; border-radius: 16rpx; object-fit: cover; }
.facts { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10rpx; }
.fact { min-width: 0; padding: 16rpx; background: #fff7eb; border: 1rpx solid #eadcc6; border-radius: 14rpx; }
.fact .label { display: block; color: var(--muted); font-size: 22rpx; }
.fact .value { display: block; margin-top: 8rpx; overflow-wrap: anywhere; font-weight: 800; }
.action-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10rpx; }
.action { min-height: 96rpx; display: flex; align-items: center; padding: 18rpx; background: #fff; border: 1rpx solid var(--line); border-top: 6rpx solid var(--blue); border-radius: 16rpx; }
.action:nth-child(2) { border-top-color: var(--green); }
.action:nth-child(3) { border-top-color: #92778a; }
.action:nth-child(4) { border-top-color: #b97958; }
.action .action-title { display: block; font-size: 27rpx; font-weight: 800; }
.action .action-note { display: none; }
.section-note { margin: -6rpx 0 18rpx; color: var(--muted); font-size: 23rpx; line-height: 1.5; }
.safe-bottom { height: env(safe-area-inset-bottom); }

/*
 * Tablets need a real layout breakpoint.  rpx intentionally follows the
 * viewport width, which is useful on phones but makes controls and type grow
 * to desktop-like sizes on an iPad.  Keep the phone rules above intact and
 * cap the shared component geometry in physical pixels on wider screens.
 */
@media (min-width: 700px) {
  page { --shadow: 0 8px 24px rgba(93, 72, 39, .08); font-size: 16px; }
  page .page { width: calc(100% - 48px); max-width: 1120px; margin: 0 auto; padding: 20px 0 36px; }
  page .page-heading { margin-bottom: 16px; padding: 16px 20px; border-radius: 16px; }
  page .page-heading .title { font-size: 26px; }
  page .card { margin-bottom: 16px; padding: 20px; border-width: 1px; border-radius: 20px; box-shadow: var(--shadow); }
  page .card-title { gap: 12px; margin-bottom: 14px; }
  page .card-title text:first-child { font-size: 22px; }
  page .badge { padding: 5px 10px; font-size: 13px; }
  page .field { margin-bottom: 16px; }
  page .field-label { margin-bottom: 7px; font-size: 15px; }
  page .input, page .picker, page .textarea { min-height: 48px; padding-right: 16px; padding-left: 16px; border-width: 1px; border-radius: 12px; font-size: 16px; }
  page .textarea { min-height: 120px; padding-top: 14px; }
  page .primary, page .secondary, page .danger, page .ghost { min-height: 48px; padding: 0 18px; border-width: 1px; border-radius: 12px; font-size: 16px; }
  page .button-row { gap: 12px; }
  page .button-row button { min-width: 0; }
  page .message { margin-top: 12px; padding: 12px 14px; border-radius: 10px; font-size: 14px; }
  page .empty { padding: 28px 16px; }
  page .list-item { gap: 14px; padding: 14px 0; border-width: 1px; }
  page .list-main .name { font-size: 18px; }
  page .list-main .meta { margin-top: 5px; font-size: 14px; }
  page .chevron { font-size: 24px; }
  page .segmented { gap: 6px; padding: 6px; border-radius: 14px; }
  page .segmented button { min-height: 44px; border-radius: 10px; font-size: 15px; }
  page .photo { height: 360px; border-radius: 16px; }
  page .photo-small { width: 88px; height: 106px; border-radius: 12px; }
  page .facts { gap: 10px; }
  page .fact { padding: 14px; border-width: 1px; border-radius: 12px; }
  page .fact .label { font-size: 14px; }
  page .fact .value { margin-top: 6px; font-size: 16px; }
  page .action-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; }
  page .action { min-height: 78px; padding: 14px; border-width: 1px; border-top-width: 4px; border-radius: 14px; }
  page .action .action-title { font-size: 17px; }
  page .section-note { margin: -4px 0 14px; font-size: 14px; }
}
